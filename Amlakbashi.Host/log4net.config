<log4net>
  <appender name="LogAppender" type="Amlakbashi.Host.Appenders.LogAppender, Amlakbashi.Host">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%m" />
    </layout>
  </appender>

  <appender name="HangfireAppender" type="Amlakbashi.Host.Appenders.HangfireAppender, Amlakbashi.Host">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%m" />
    </layout>
  </appender>

  <appender name="ImpersonationAppender" type="Amlakbashi.Host.Appenders.ImpersonationAppender, Amlakbashi.Host">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%m" />
    </layout>
  </appender>
  
  <root>
    <appender-ref ref="LogAppender" />
    <appender-ref ref="HangfireAppender" />
    <appender-ref ref="ImpersonationAppender" />
  </root>
</log4net>