@section ScriptLink {
    <environment include="Development">
        <script src="/resource/scripts/general/jalali-date-converter.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/jalali-date-handler.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/jalali-date-picker.js" asp-append-version="true"></script>
        <script src="/resource/scripts/page/home-page.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/home-page-search.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/search-by-region.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/increase-decrease-button.js" asp-append-version="true"></script>
        <script src="/resource/scripts/general/slider-scroll.js" asp-append-version="true"></script>
        <script src="/resource/scripts/home-page-banner.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="/js/home-page.min.js" asp-append-version="true"></script>
    </environment>
}

@section ScriptBlock
{
    <script type="text/javascript">
        var isPortalHomePage = true;
    </script>
    <script type="application/ld+on">
        {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "url": "https://www.amlakbashi.com",
        "logo": "https://www.amlakbashi.com/file/resourceimagegif?file_name=amlakbashi-logo-1200w",
        "contactPoint": [{
        "@@type": "ContactPoint",
        "telephone": "+98-26-32565296",
        "contactType": "customer service"
        }],
        "sameAs": [
        "https://telegram.me/amlakbashi",
        "https://www.facebook.com/%D8%A7%D9%85%D9%84%D8%A7%DA%A9-%D8%A8%D8%A7%D8%B4%DB%8C-483230121839503/",
        "https://twitter.com/amlakbashi",
        "http://instagram.com/amlakbashi_com",
        "https://www.aparat.com/amlakbashi"
        ]
        }
    </script>
    <script type="text/javascript">
        var messageShowOnReady = '@ViewBag.MessageShowOnReady';
    </script>
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [{
        "@@type": "ListItem",
        "position": 1,
        "name": "املاک باشی",
        "item": "https://www.amlakbashi.com/"
        }]
        }
    </script>
    @{ var item = homePageCategories.First(x => x.CategoryID == 55957);
        var itemCount = item.Advertises.Count;

        <script type="application/ld+json">
            {
            "@@context": "https://schema.org",
            "@@type": "ItemList",
            "itemListElement": [
            @for (int i = 0; i < itemCount; i++)
            {
                var advertise = item.Advertises[i];
                var position = i + 1;
                var img_src = advertise.ImageSource;
                var title = advertise.Title;
                var description = advertise.Description;

                @:{
                @:"@@type": "ListItem",
                @:"position": "@(position)",
                @:"item": {
                @:"@@type": "Hotel",
                @:"url": "@( "https://www.amlakbashi.com/#advertise_" + advertise.Id)",
                @:"name": "@(title)",
                @:"image": [
                @:"https://www.amlakbashi.com@(img_src)"
                @:],
                @:"description": "@(description)"
                if (advertise.ReviewCount > 0)
                {
                    @:,
                    @:"aggregateRating": {
                    @:"@@type": "AggregateRating",
                    @:"ratingValue": "@(advertise.Rate)",
                    @:"ratingCount": "@(advertise.ReviewCount)"
                    @:}
                }
                @:}
                @:} @(i < itemCount - 1 ? "," : "")
            }
            ]
            }
        </script>
    }
}
