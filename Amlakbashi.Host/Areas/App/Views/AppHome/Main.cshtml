    ViewBag.Description = "اجاره ویلا، اجاره سوئیت، اجاره روزانه خانه، اجاره آپارتمان مبله، اجاره منزل مبله در تهران، شمال، رامسر، ماسال، کرج، کردان، اصفهان، شیراز، یزد، مشهد و سایر شهر های توریسی ایران";
    ViewBag.HomePage = true;
    //Layout = "~/Areas/App/Views/Shared/_AppLayout.cshtml";
