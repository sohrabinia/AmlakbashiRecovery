            <div class="home-page__banner-container home-page__banner-norouz">
                @{var counter = 0;}
                @foreach (var item in norouzAdvertises)
                {
                    counter++;
                    var img_src = item.PhotoID > 0 ? string.Format("/file/accthumbxlarge?accid={0}&fileid={1}", item.AdvertiseID, item.PhotoID) : string.Format("/عکس-یافت-نشد-{0}-{1}", 240, 144);
