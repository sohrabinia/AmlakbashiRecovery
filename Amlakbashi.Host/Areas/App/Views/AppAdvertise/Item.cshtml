@section ScriptBlock
{
    @{
        var rnd = new Random();
        var OldRange = (1 - 0);
        var NewRange = (Model.Address.Latitude + 0.0017 - Model.Address.Latitude - 0.0017);
        var NewValue = (((rnd.NextDouble() - 0) * NewRange) / OldRange) + Model.Address.Latitude - 0.0017;
        var lat = NewValue;
        NewRange = (Model.Address.Longitude + 0.0017 - Model.Address.Longitude - 0.0017);
        NewValue = (((rnd.NextDouble() - 0) * NewRange) / OldRange) + Model.Address.Longitude - 0.0017;
        var lng = NewValue;
    }
    <script defer="defer" type="text/javascript">
            @if (Model.Address.Latitude != 0 && Model.Address.Longitude != 0)
            {
                @:$(document).ready(function(){
                    @:var lat = @lat;
                    @:var lng = @lng;
                    @:mymap = L.map('mapid').setView([@(Model.IsPreview ? Model.Address.Latitude.ToString() : "lat"), @(Model.IsPreview ? Model.Address.Longitude.ToString() : "lng")], @(Model.IsPreview ? 18 : 14));
                    @:L.tileLayer('https://api.mapbox.com/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token={accessToken}', {
                    @:attribution: '',
                    @:maxZoom: 18,
                    @:id: 'mapbox/streets-v11',
                    @:tileSize: 512,
                    @:zoomOffset: -1,
                    @:accessToken: 'REMOVED_MAPBOX_TOKEN'
                    @:}).addTo(mymap);
                    if (Model.IsPreview)
                    {
                        @:var circle = L.circle([@Model.Address.Latitude, @Model.Address.Longitude], {
                            @:color: '#fdd835',
                            @:fillColor: '#fff4d3',
                            @:fillOpacity: 0.5,
                            @:radius: 20
                        @:}).addTo(mymap);
                    }
                    else {
                        @:var circle = L.circle([lat, lng], {
                            @:color: '#fdd835',
                            @:fillColor: '#fff4d3',
                            @:fillOpacity: 0.5,
                            @:radius: @(Model.AdvertiseType.TypeID == Advertise.AdvertiseType.Villa ? 1000 : 700)
                        @:}).addTo(mymap);
                    }
                    //mymap.on('click', onMapClick);
            @:});
    }

