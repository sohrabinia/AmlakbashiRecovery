            "streetAddress" : "@Model.FilteredAddress",
            "postalCode" : "14717"
            }
            ,
            "telephone" : "026-32565304"

            }
            }
            }
        </script>
        if (Model.ReportItems.CountReport > 0)
        {
            <script type="application/ld+json">
                {
                "@@context": "https://schema.org",
                "@@type": "Hotel",
                "aggregateRating": {
                "@@type": "AggregateRating",
                "ratingValue": "@(Model.ReportItems.Rating)",
                "reviewCount": "@(Model.ReportItems.CountReport)",
                "bestRating": "5",
                "worstRating": "0"
                },
                "name": "@(Model.TitleDesc.Title)",
                "description": "@(Model.TitleDesc.Description)",
                "image": "https://www.amlakbashi.com@(string.Format("/عکس-آگهی-بزرگ/{0}", Model.Slug))",
                "review": [
                @for (int i = 0; i < Model.ReportItems.CountReport; i++)
                {
                    var report = Model.ReportItems.ReportList.ElementAt(i);
                    var author_user = report.User;
                    var author_name = author_user.FullName;
                    author_name = !string.IsNullOrEmpty(author_name) ? author_name : author_user.Id.ToString();
                    var comment = Model.Comments.Where(w => w.Comment.SenderUserID == report.User.Id).FirstOrDefault().Comment;
                    var comment_str = comment != null ? comment.Text : "";
                    var sum_scr = (float)report.ReportItems.Sum(x => x.Score);
                    var count_scr = (float)report.ReportItems.Count();
                    var average_score = sum_scr / count_scr;
                    var date_published = report.ReportItems.Max(x => x.LastModifyDate);
                    @:{
                    @:"@@type": "Review",
                    @:"author": "@(author_name)",
                    @:"datePublished": "@(date_published.ToString("yyyy-MM-dd"))",
                    @:"description": "@(comment_str)",
                    @:"reviewRating": {
                    @:"@@type": "Rating",
                    @:"bestRating": "5",
                    @:"ratingValue": "@(average_score.ToString("F2"))",
                    @:"worstRating": "1"
                    @:}
                    @:}
                    if (i < Model.ReportItems.ReportList.Count - 1)
                    {
                        @:,
                    }
                }
                ]

                ,
                "priceRange" : "از شبی @(Model.Price.DailyPrice) تومان"
                ,
                "address" : {
                "addressLocality" : "@(Model.Address.AreaId > 0 ? Model.AccCategory.CityName : Model.AccCategory.ProvinceName)",
                "addressRegion" : "@(Model.Address.AreaId > 0 ? Model.AccCategory.AreaName : Model.AccCategory.CityName)",
                "addressCountry" : "Iran",
                "@@type" : "PostalAddress",
                "streetAddress" : "@Model.FilteredAddress",
                "postalCode" : "14717"
                }
                ,
                "telephone" : "026-32565304"

                }
            </script>
        }
        var url_splitted = ((string)Model.RawUrl).Substring(1).Split('/');
        var pos = 3;
        <script defer="defer" type="application/ld+json">
            {
            "@@context": "https://schema.org",
            "@@type": "BreadcrumbList",
            "itemListElement": [{
            "@@type": "ListItem",
            "position": 1,
            "name": "املاک باشی",
            "item": "https://www.amlakbashi.com"
            }
            ,
            {
            "@@type": "ListItem",
            "position": 2,
            "name": "اجاره روزانه",
            "item": "https://www.amlakbashi.com/ایران"
            }
            @(pos > 1 ? "," : "" )
            {
            "@@type": "ListItem",
            "position": @pos,
            "name": "@Model.CityString",
            "item": "https://www.amlakbashi.com/s/@(Model.Address.CityId)/@(Model.AccCategory.CityName)"
            }
            @{
                pos++;
            }
            @{
                var typeUrlString = Model.TypeUrlString;
            }
            ,
            {
            "@@type": "ListItem",
            "position": @pos,
            "name": "@typeUrlString",
            "item": "@("https://www.amlakbashi.com/s/" +
                    (
                    (Model.Address.CityId + "/" + Model.AccCategory.CityName + "/" + typeUrlString)
                    ))"
            }
            @{
                pos++;
            }
            @for (int i = url_splitted.Length - 1; i < url_splitted.Length; i++)
            {
                var url = "https://www.amlakbashi.com/";
                for (int j = 0; j < i; j++)
                {
                    url += (url_splitted[j] + "/");
                }
                url += url_splitted[i];
                @:,{
                @:"@@type": "ListItem",
                @:"position": @(pos),
                @:"name": "@(url_splitted[i].Replace("-", " "))",
                @:"item": "@(url)"}
                pos++;
            }
            ]
            }
        </script>
    }

