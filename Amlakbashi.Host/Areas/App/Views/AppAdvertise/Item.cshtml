@using Amlakbashi.Core.Entities;
@using Entities = Amlakbashi.Core.Entities;
@using Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs;
@using Amlakbashi.Core.Common.Utilities;

@model AccommodationItemDTO

@{
    //Layout = "~/Areas/App/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = Model.MetaTitleDesc.MetaTitle;
    ViewBag.isAccPage = true;
    ViewBag.CurrentPage = "AdvertiseItem";

    if (!string.IsNullOrEmpty(Model.MetaTitleDesc.MetaDescription))
    {
        ViewBag.Description = Model.MetaTitleDesc.MetaDescription;
    }

    var owner = Model.AccUser;
    var full_name = owner.FullName;

    var haveBasicInfo = Model.Capacity.Capacity > 0 || Model.Room.RoomCount > 0 || Model.BuildingSize.BuildingArea > 0 ||
        Model.LandArea.LandArea > 0 || Model.Floor.Floor != Advertise.FloorItems.Unset || (Model.Parking.Parking != Advertise.ParkingItems.Unset &&
        Model.Parking.Parking != Advertise.ParkingItems.Unset) || Model.Bed.SingleBedCount > 0 || Model.Bed.DoubleBedCount > 0 || Model.Amenities.Pool == true ? true : false;

    var haveMainAmenities = Model.Amenities.HeatingSystem != Advertise.HeatingSystemItems.Unset ||
        Model.Amenities.CoolingSystem != Advertise.CoolingSystemItems.Unset || Model.Amenities.WC != Advertise.WCItems.Unset
        || Model.Bed.ExtraBlanketCount != Advertise.ExtraBlanketCountItems.Unset || Model.Bed.BlanketAndMattressCount != 0
        ? true : false;

    var haveDetailedAmenities = Model.Elevator.Elevator || Model.Amenities.Bathroom || Model.Amenities.Pool || Model.Amenities.Balcony ||
        Model.Amenities.Sauna || Model.Amenities.Jacuzzi || Model.Amenities.TV || Model.Amenities.Wifi || Model.Amenities.Filming ||
        Model.Amenities.WashingMachine || Model.Amenities.Refrigerator || Model.Amenities.Oven || Model.Amenities.MicrowaveOven ||
        Model.Amenities.KitchenHood || Model.Amenities.KitchenUtensils || Model.Amenities.Hairdryer || Model.Amenities.SoundSystem ||
        Model.Amenities.TeaMaker || Model.Amenities.Foosball || Model.Amenities.Golf || Model.Amenities.PoolTable ? true : false;

    List<long> album_photos;
    if (string.IsNullOrEmpty(Model.Photo.AlbumPhoto) || Model.Photo.AlbumPhoto == ",")
    {
        album_photos = new List<long>();
    }
    else
    {
        album_photos = Array.ConvertAll(Model.Photo.AlbumPhoto.Trim(',').Split(','), x => long.Parse(x)).ToList();
        if (Model.Photo.MainPhotoId != null)
        {
            album_photos.Remove((long)Model.Photo.MainPhotoId);
        }
    }
    if (Model.Photo.MainPhotoId != null)
    {
        album_photos.Insert(0, (long)Model.Photo.MainPhotoId);
    }

    var u_ = "https://www.amlakbashi.com" + Model.RawUrl;
    var t_ = ViewBag.Title;
    var img_ = "https://www.amlakbashi.com" + (Model.Photo.MainPhotoId != null ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", Model.Photo.MainPhotoId, 700, 394) : string.Format("/عکس-یافت-نشد-{0}-{1}", 700, 394));
}

@section HeaderAddition
{
    @if (!Model.IsPreview)
    {
        <link rel="canonical" href="https://www.amlakbashi.com@(Model.RawUrl)" />
        <meta property="og:url" content="https://www.amlakbashi.com@(Model.RawUrl)" />
        <meta property="og:image" content='@("https://www.amlakbashi.com" + (Model.Photo.MainPhotoId != null ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", Model.Photo.MainPhotoId, 700, 394) : string.Format("/عکس-یافت-نشد-{0}-{1}", 700, 394)))' />
    }
    else
    {
        <meta name="robots" content="noindex, nofollow">
    }
}

@section StyleLink {
    <environment include="Development">
        <link rel="stylesheet" href="/resource/css/general/jalali-date-picker.css" />
        <link rel="stylesheet" href="/resource/lightbox/lightbox.css" />
        <link rel="stylesheet" href="/resource/slick/slick.css" />
        <link rel="stylesheet" href="/resource/slick/slick-theme.css" />
        <link rel="stylesheet" href="/resource/css/portal/advertise-item.css" asp-append-version="true" />
        <link rel="stylesheet" href="/resource/css/portal/reserve-dialog.css" />
        <link rel="stylesheet" href="/resource/css/portal/acc-blog-news.css" />
        <link rel="stylesheet" href="/resource/css/general/master-search.css" />
        <link rel="stylesheet" href="/resource/css/general/search-by-region.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="/css/acc-item.min.css" asp-append-version="true" />
    </environment>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.6.0/dist/leaflet.css"
          integrity="sha512-xwE/Az9zrjBIphAcBb3F6JVqxf46+CDLwfLMHloNu6KEQCAWi6HcDUbeOfBIptF7tcCzusKFjFw2yuvEpDL9wQ=="
          crossorigin="" />
}

