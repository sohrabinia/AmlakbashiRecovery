<div class="advertise-page__bottom-pin" style="@(Model.AdvertiseMode == Advertise.AdvertiseMode.Parent || !Model.CanPublish ? "background-color:transparent;border:none;" : "")">
    @if (Model.AdvertiseMode != Advertise.AdvertiseMode.Parent && Model.CanPublish)
    {
        <div onclick="showReserveContainer()" class="advertise-page__bottom-pin-button">
            <p class="js-reserve-req-title">رزرو<i class="js-reserve-req-icon fa fa-calendar-check"></i></p>
        </div>
        <p class="advertise-page__reserve-free-ribbon">رایگان</p>
    }
</div>

<div class="advertise-page__content-root" id="js-parent-of-content">
    <div class="advertise-page__content-container">
        <input type="hidden" id="Id" value="@Model.Id" />
        @if (album_photos.Any())
        {
            <div class="advertise-page__slider-container-parent">
                <div class="advertise-image-library advertise-page__slider-container">
                    @{
                        for (int i = 0; i < album_photos.Count; i++)
                        {
                            var photo_id = album_photos[i];
                            string img_small, img_medium, img_large, img_xlarge, img_xxlarge, img_xxxlarge;
                            img_small = photo_id > 0 ? string.Format("/file/accthumbsmall?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 213, 120);
                            img_medium = photo_id > 0 ? string.Format("/file/accthumbmedium?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 249, 140);
                            img_large = photo_id > 0 ? string.Format("/file/accthumblarge?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 331, 186);
                            img_xlarge = photo_id > 0 ? string.Format("/file/accthumbxlarge?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 450, 253);
                            img_xxlarge = photo_id > 0 ? string.Format("/file/accthumbxxlarge?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 600, 338);
                            img_xxxlarge = photo_id > 0 ? string.Format("/file/accthumbxxxlarge?accid={0}&fileid={1}", Model.Id, photo_id) : string.Format("/عکس-یافت-نشد-{0}-{1}", 700, 394);

                            <a href="@string.Format("/file/getimage?fileid={0}", photo_id)" data-lightbox="advertise-gallery-set" class="advertise-page__slider-image-container" data-alt="@(Model.TitleDesc.Title)-@(i+1)" data-title="@(Model.TitleDesc.Title)-@(i+1)">
                                @*<img data-srcset="@img_small 213w,
                                    @img_medium 249w,
                                    @img_large 331w,
                                    @img_xlarge 450w,
                                    @img_xxlarge 600w,
                                    @img_xxxlarge 700w"

                                     srcset='@(i == 0 ? img_small + " 213w," +
                                        img_medium + " 249w," +
                                        img_large + " 331w," +
                                        img_xlarge + " 450w," +
                                        img_xxlarge + " 600w," +
                                        img_xxxlarge + " 700w" : "")'

                                     sizes="(max-width: 312px) 213px,
                                     (max-width: 320px) 249px,
                                     (max-width: 400px) 249px,
                                     (max-width: 550px) 331px,
                                     (max-width: 680px) 450px,
                                     (max-width: 780px) 600px,
                                     (max-width: 900px) 450px,
                                     (max-width: 1100px) 450px,
                                     (max-width: 1200px) 700px,
                                     700px"
                                     @(i == 0 ? "" : "data-lazy=/file/resourceimagepng?file_name=lazy-16_9")
                                     data-src="@img_small" @(i > 0 ? "data-" : "") alt="@(Model.TitleDesc.Title)-@(i+1)" @(i > 0 ? "data-" : "") title="@(Model.TitleDesc.Title)-@(i+1)"
                                     class="advertise-page__slider-image lazy" style="@(i > 0 ? "display:none;" : "")">*@

                                <img width="213" height="120" src="@img_small"
                                     srcset='@(img_small + " 213w," +
                                        img_medium + " 249w," +
                                        img_large + " 331w," +
                                        img_xlarge + " 450w," +
                                        img_xxlarge + " 600w," +
                                        img_xxxlarge + " 700w")'
                                     @(i == 0 ? "" : "data-lazy=/file/resourceimagepng?file_name=lazy-16_9")
                                     data-src="@img_small" @(i > 0 ? "data-" : "") alt="@(Model.TitleDesc.Title)-@(i+1)" @(i > 0 ? "data-" : "") title="@(Model.TitleDesc.Title)-@(i+1)"
                                     class="advertise-page__slider-image lazy" style="@(i > 0 ? "display:none; " : "")width: 90%; height:auto;">
                            </a>
                        }
                    }
                </div>
            </div>
        }

        <div class="advertise-page__main-elements-parent">
            <div class="advertise-page__property-box advertise-page__info-box">

                @* Title and Acc Code *@
                <div class="advertise-page_title_item">
                    <h1>@Model.TitleDesc.Title</h1>
                    <div style="display: flex; justify-content: space-between;">
                        <p>کد اقامتگاه: @Model.Id</p>
                        @if (Model.HasVideo)
                        {
                            <div class="" style="height: 37px; width: 100px; font: 14px Miransans; border: 1px solid lightgray; padding: 3px 5px; border-radius: 5px; cursor: pointer; background-color: #fdd835; margin-right: 20px; text-align:center;" onclick="showVideo(@Model.Id)">
                                <span style="">ویدیو</span>
                                <i class="fas fa-video" style=""></i>
                            </div>
                        }
                    </div>
                </div>

                @* Acc Owner and Socials & Favorite *@
                <div class="advertise-page__title-container">
                    <div class="advertise-page__profile-container">
                        @if (owner != null && owner.PhotoID > 0 && owner.PhotoStatus == (int)Entities.User.UserPhotoState.publish)
                        {
                            <img src='@(string.Format("/عکس-پروفایل_کوچک-{0}", owner.PhotoID))' alt='@(string.Format("عکس پروفایل {0}", owner.FullName))' width="40" height="40" style="object-fit: cover;border-radius: 45px;margin: auto;" />
                        }
                        else
                        {
                            <i class="fa fa-user-circle"></i>
                        }
                        @if (owner != null && !string.IsNullOrEmpty(full_name))
                        {
                            <p title="@full_name">@full_name</p>
                        }
                        else
                        {
                            <p>مالک اقامتگاه</p>
                        }
                    </div>
                    <div class="master__favourite-button" onclick="onClickFavouriteBtn(this)" advertise_id="@Model.Id">
                        <p>علاقه مندی</p>
                        <i class="fa fa-heart" style="opacity: 0;font-size:15px;"></i>
                    </div>
                    <div class="share-post__button master__share-button">
                        <p>اشتراک گذاری</p>
                        <i class="fa fa-share-alt"></i>
                        <div class="share-popup" id="share_popup">
                            <a class="share-post__item" href="https://t.me/share/url?url=@(u_)&text=@(t_)" rel="noreferrer" title="اشتراک گذاری در تلگرام" style="background-color: #259DCF;">
                                <i class="fab fa-telegram-plane"></i>
                            </a>
                            <a class="share-post__item" href="whatsapp://send?text=@(t_) @(u_)" data-action="share/whatsapp/share" onclick="shareOnWathsapp('@(t_) @(u_)')" title="اشتراک گذاری در واتس اپ" style="background-color: #1BD741;">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <a class="share-post__item" href="http://twitter.com/share?text=@(t_);url=@(u_)" rel="noreferrer" title="توئیت کردن اقامتگاه" style="background-color: #55ACEE;">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a class="share-post__item" href="http://www.facebook.com/sharer.php?u=@(u_);t=@(t_)" rel="noreferrer" title="اشتراک گذاری در فیسبوک" style="background-color: #3b5998;">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a class="share-post__item" href="http://pinterest.com/pin/create/button/?url=@(u_)&media=@(img_)&description=@(t_)" rel="noreferrer" title="پین کردن در پینترست" style="background-color: #BD081C;">
                                <i class="fab fa-pinterest-p"></i>
                            </a>
                            <a class="share-post__item" href="mailto:?subject=@(t_);BODY=@("این اقامتگاه را در سایت املاک باشی مشاهده کنید:"): @(u_)" rel="noreferrer" title="اشتراک گذاری با ایمیل" style="background-color: #ddd;">
                                <i class="fa fa-envelope"></i>
                            </a>
                        </div>
                    </div>
                </div>

                @* Address *@
                <div class="advertise-page__main-properties-container">
                    @*@await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageAddress.cshtml", Model)*@
                    <h2 class="advertise-page__main-property-item">
                        <i class="fa fa-map-marker-alt" style=""></i>
                        @if (Model.AccCategory.CountryDirection)
                        {
                            <span>@(Model.AccCategory.CountryDirectionName)،</span>
                        }
                        <span>استان @Model.AccCategory.ProvinceName</span>، <span id="city-title">@Model.AccCategory.CityName</span>
                        @if (Model.AccCategory.Area)
                        {
                            <span>، @Model.AccCategory.AreaName</span>
                        }
                    </h2>

                    @if (Model.Address != null && !string.IsNullOrEmpty(Model.Address.Address))
                    {
                        <h3 class="advertise-page__main-property-item" data-max-height="25">
                            <i class="fa fa-address-card"></i> @Model.Address.Address
                        </h3>
                    }
                </div>

                @* Basic Info *@
                @if (haveBasicInfo)
                {
                    <div class="advertise-page__basic-properties-container">
                        @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageBasicInfo.cshtml", Model)
                    </div>
                }

                @* Price *@
                @if (Model.AdvertiseMode != Advertise.AdvertiseMode.Parent)
                {
                    <div class="advertise-page__price-container">
                        @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPagePrice.cshtml", Model.Price)

                        @*@if (Model.Price.NorouzOverCapacityPrice > 0)
                            {
                                <div class="advertie-page__price-item js-NorouzOverCapacityPrice">
                                    <span class="advertise-page__price-title">
                                        قیمت هر مهمان اضافه نوروز <img width="16" height="16" rel="ویژه نوروز" alt="ویژه نوروز" title="ویژه نوروز" src="/file/resourceimagepng?file_name=norouz_icon_16x16" />
                                    </span>
                                    <span class="advertise-page__price-content">
                                        @string.Format("{0:n0}", Model.Price.NorouzOverCapacityPrice) تومان
                                    </span>
                                </div>
                            }*@
                    </div>
                }


                @* Rules *@
                @if (Model.CanPublish)
                {
                    <div class="advertise-page__rules-container">
                        @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageRules.cshtml", Model.Rules)
                    </div>
                }
            </div>

            @await Html.PartialAsync("_ItemReserveContainer", Model, new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) { { "root_id", "reserve-mobile-container" } })
        </div>

        @if (Model.CanPublish)
        {
            @* Amenities *@
            if (haveMainAmenities || haveDetailedAmenities)
            {
                <div class="advertise-page__property-box advertise-page__amenities-box">
                    @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageAmenities.cshtml", Model)
                </div>
            }

            @* About Acc *@
            <div class="advertise-page__property-box advertise-page__description-box">
                <P class="advertise-page__description-header">
                    <i class="fa fa-info-circle"></i> درباره اقامتگاه
                </P>
                <p class="advertise-page__description" data-max-height="200">
                    @Model.TitleDesc.Description
                    <br /><br />
                    @if (Model.License.License)
                    {
                        <span class="fa fa-certificate"></span>
                        @:دارای مجوز از سازمان گردشگری با شماره ثبت @Model.License.LicenseNumber
                        <br /><br />
                    }
                    <span class="fa fa-calendar-check"></span>
                    تاریخ آخرین ویرایش آگهی: @StringUtility.EnglishNumberToPersian(Model.LastModifyDate)
                </p>
            </div>

            @* statistics *@
            @if (Model.Statistics != null && Model.Statistics.SuccessfullReserveCount > 0)
            {
                <div class="advertise-page__property-box advertise-page__overall-rating-box">
                    @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageStatistics.cshtml", Model)
                </div>
            }

            @* Map *@
            if (Model.Address.Latitude != 0 && Model.Address.Longitude != 0)
            {
                <div class="advertise-page__amenities-container advertise-page_map-box">
                    <p class="advertise-page__amenities-header"><i class="fa fa-map-marker-alt"></i> موقعیت در نقشه</p>
                    <div id="mapid" style="height:300px;z-index: 0"></div>
                </div>
            }

            @* Comments *@
            @if (Model.Comments != null && Model.Comments.Count > 0)
            {
                <div class="advertise-page__property-box advertise-page__comment-box">
                    @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageComments.cshtml", Model)
                </div>
            }
        }

        @* Related Links *@
        @*<div class="advertise-page__property-box advertise-page__comment-box">
                @await Html.PartialAsync("/Views/Accomodation/AccPagePartials/_AccPageRelatedLinks.cshtml", Model)
            </div>*@

        <div class="advertise-page__stick-reserve">
        </div>
    </div>

    @await Html.PartialAsync("_ItemReserveContainer", Model, new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) { { "root_id", "reserve-desktop-container" } })
</div>

