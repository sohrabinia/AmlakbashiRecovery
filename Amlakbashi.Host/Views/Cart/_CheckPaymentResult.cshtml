@model Amlakbashi.Core.DTOs.PaymentDTOs.CheckPaymentDTO

@if (Model == null && ViewBag.hasError)
{
    <p style="text-align: center;">عملیات با خطا مواجه شد</p>
}
else
{
    <div>
        <span>نتیجه:</span>
        @if (Model.Result)
        {
            <span style="color: limegreen;">موفق</span>
        }
        else
        {
            <span style="color: red;">ناموفق</span>
        }
    </div>
    <div>
        <span>شناسه پرداخت:</span>
        <span>@Model.PaymentId</span>
    </div>
    <div>
        <span>شماره تراکنش:</span>
        <span>@Model.TransactionReferenceId</span>
    </div>
    <div>
        <span>شماره ارجاع:</span>
        <span>@Model.ReferenceNumber</span>
    </div>
    <div>
        <span>شماره پیگیری:</span>
        <span>@Model.TraceNumber</span>
    </div>
    <div>
        <span>تاریخ ایجاد پرداخت:</span>
        <span>@Model.CreatePaymentDate</span>
    </div>
    <div>
        <span>تاریخ تکمیل فرآیند پرداخت:</span>
        <span>@Model.TransactionDate</span>
    </div>
    <div>
        <span>مبلغ پرداخت:</span>
        <span>@Model.Price</span>
    </div>
    if (Model.ReserveId > 0)
    {
        <div>
            <span>کد رزرو:</span>
            <a href="/reserve/index?reserve_id=@Model.ReserveId&mainFilter=1" target="_blank">@Model.ReserveId</a>
            @if (Model.Result)
            {
                <span> | </span>
                <button class="message-popup__message-button" type="button" onclick="doReserveByPaymentReinquiry(@Model.ReserveId, @Model.PaymentId)">تکمیل رزرو</button>
            }
        </div>
    }
}

<script type="text/javascript">
    function doReserveByPaymentReinquiry(reserveId, paymentId) {
        showNoYesMessage('تکمیل رزرو', 'وضعیت رزرو با کد ' + reserveId + ' به حالت «رزرو شده» تغییر می یابد. آیا از این مورد مطمئنید؟', function () {
            myajax("reserve/ReserveByPaymentReinquiry", "reserveId=" + reserveId + "&paymentId=" + paymentId, function (ret) {
                if (ret.status == 1) {
                    alertify.success(ret.msg);
                }
                else {
                    alertify.error(ret.msg);
                }
            });
        });
    }
</script>