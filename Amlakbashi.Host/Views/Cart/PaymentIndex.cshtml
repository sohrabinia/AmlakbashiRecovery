@using Amlakbashi.Core.DTOs.PaymentDTOs
@{
    ViewBag.Title = "مدیریت تراکنش ها";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}

@model IEnumerable<Payment>

@{
    var data = ViewBag.dto as IEnumerable<PaymentIndexDTO>;
}

@using (Html.BeginForm("PaymentIndex", "Cart", FormMethod.Post))
{
<div>
    <table>
        <tr>
            <td class="label">وضعیت پرداخت</td>
            <td class="minw">
                <select name="status" style="width:120px;">
                    <option value="-1">همه</option>
                    <option is-selected="@(1 == (int)ViewBag.status)" value="1">پرداخت شده</option>
                    <option is-selected="@(0 == (int)ViewBag.status)" value="0">پرداخت نشده</option>
                </select>
            </td>
            <td class="label">کاربر</td>
            <td class="minw">
                <input name="uid" type="text" value="@ViewBag.uid" style="width:150px;" />
            </td>
            <td class="label">از تاریخ</td>
            <td class="minw">
                <input name="from_str" type="text" value="@ViewBag.from_str" style="width:150px;" />
            </td>
            <td class="label">تا تاریخ</td>
            <td class="minw">
                <input name="to_str" type="text" value="@ViewBag.to_str" style="width:150px;" />
            </td>
            <td><input type="submit" class="filter" value="فیلتر" /></td>
            <td style="width:100%;"></td>
        </tr>
    </table>
</div>

<div style="font:16px Miransans; color:#555;display:flex;padding:10px;">
    <span>جمع مبلغ در تاریخ :</span>
    <span>@((long)ViewBag.sum)</span>
</div>

<table>
    <tr>
        <th class="minw">
            ردیف
        </th>
        <th>
            شماره تراکنش
        </th>
        <th>
            شماره ارجاع
        </th>
        <th>
            کاربر
        </th>
        <th>
            وضعیت
        </th>
        <th>
            تاریخ ثبت
        </th>
        <th>
            قیمت پرداختی
        </th>
        <th>
            عملیات
        </th>
    </tr>
    @{
        int Idx = (int)ViewBag.RowIndexStart;
    }

    
    @foreach (var item in data)
    {
        Idx++;
        <tr>
            <td>
                @Idx
            </td>
            <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <span style="overflow-y: hidden;">@item.Payment.Authority</span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Payment.RefID)
            </td>
            <td>
                <a style="text-decoration:none;display:block" target="_blank" href="@string.Format("/user/index?code={0}" , item.Payment.UserID)">@item.UserPhoneNumber</a>
            </td>
            <td>
                <span class="imgstatus @(item.Payment.Status==1 ? "enable" : "disable")"></span>
            </td>
            <td>
                @Amlakbashi.Core.Common.Utilities.DateTimeUtility.ConvertDate(item.Payment.Date, false, true)
            </td>
            <td>
                @item.Payment.TotalPrice
            </td>            
            <td>
                @*<a href="@string.Format("/cart/index?refid={0}", item.Payment.RefID)"><i class="fa fa-cart-plus"></i></a>*@
                <button type="button" onclick="checkPayment(@item.Payment.Id)" style="border: 0; background-color: white; cursor: pointer;"><i class="fas fa-sync" style="font-size: 16px; color: blue; margin-right: 5px;"></i></button>
            </td>
        </tr>
    }

</table>
}
<div class="mypagelist">
    @Html.PagedListPager((IPagedList)Model, page => Url.Action("PaymentIndex", "Cart", new { page, status = (int)ViewBag.status, uid = (int)ViewBag.uid, from_str = (string)ViewBag.from_str, to_str = (string)ViewBag.to_str }), new PagedListRenderOptions { LinkToFirstPageFormat = "ابتدا", LinkToPreviousPageFormat = "قبلی", LinkToNextPageFormat = "بعدی", LinkToLastPageFormat = "انتها", MaximumPageNumbersToDisplay = 5, DelimiterBetweenPageNumbers = "|" })
</div>


@section ScriptBlock
{
    <script type="text/javascript">

        function deleteItem($id, obj) {
            if (confirm("آیا از حذف این آیتم اطمینان دارید ؟"))
            {
                myajax("Cart/Delete", "id=" + $id , function (ret) {
                    if (ret.status==1) {
                        $(obj).parent().parent().remove() ;
                    }
                });
            }
        }

        function checkPayment(id) {
            showInfoMessage('اطلاعات تراکنش', '', { contentUrl: '/Cart/CheckPasargadPaymentResult?paymentId=' + id, fullScreen: screen.width < 781 });
        }

    </script>
}