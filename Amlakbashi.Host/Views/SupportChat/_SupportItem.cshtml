@using Amlakbashi.Core.DTOs.SupportChatDTOs; 
@model SupportChatDTO

<div id="js-support-item-@Model.id" class="support-chat-index__support-item" onclick="selectSupportItem(@Model.id, this)">
    <div class="support-chat-index__profile">
        <span>@Model.userTitle</span>
    @if (Model.userPhotoId < 1)
    {
        <i class="fa fa-user-circle"></i>
    }
    else
    {
        <img width="40" height="40" style="border-radius:60px" src="/عکس-پروفایل_کوچک-@(Model.userPhotoId)" />
    }
    @if (Model.userId > 0)
    {
        <a target="_blank" href="@("/user/index?code=" + Model.userId)">
            <span>@Model.userName</span>
        </a>
    }
    else
    {
        <div>
            <span>ناشناس</span>
        </div>
    }
</div>
<div class="support-chat-index__profile">
    <span>پاسخگو</span>
    @if (Model.supporterId == 0)
    {
        <span style="color:#EA4335">بدون پاسخ</span>
    }
    else
    {
        if (Model.supporterPhotoId < 1)
        {
            <i class="fa fa-user-circle"></i>
        }
        else
        {
            <img width="40" height="40" style="border-radius:60px" src="/عکس-پروفایل_کوچک-@(Model.supporterPhotoId)" />
        }
        <div>
            <span>@Model.supporterName</span>
        </div>
    }
</div>
<div class="support-chat-index__reserve">
    @if (Model.reserveId > 0)
    {
        <a target="_blank" href="/reserve/newindex?reserveid=@(Model.reserveId)">کد رزرو: @Model.reserveId</a>
        <a target="_blank" href="/advertise/index?id=@(Model.advertiseId)">کد آگهی: @Model.advertiseId</a>
        if (Model.reserveSupporterId > 0)
        {
            <div style="display:flex;flex-flow:row; justify-content: center; align-items:center;">
                <img style="border-radius: 90px" width="20" height="20" src="/file/imgThumb?FileID=@(Model.reserveSupporterPhotoId)&w=20&h=20">
                <div style="margin: 0 5px;color:#242424;">@Model.reserveSupporterName</div>
            </div>
        }
        else
        {
            <span>بدون پشتیبان</span>
        }
    }
</div>
<div class="support-chat-index__new-count">
    @if (Model.newMessageCount > 0)
    {
        <div class="support-chat-index__new-count-label">
            <span>@Model.newMessageCount</span>
        </div>
    }
</div>
</div>