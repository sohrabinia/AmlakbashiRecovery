        function addContactLink() {
            sendChatText('https://www.amlakbashi.com/contact');
        }

        function selectSupportItem(id, elem) {
            if (elem == undefined) {
                elem = $('#js-support-item-' + id);
            }
            $('.support-chat-index__chat-container').css('display', 'flex');
            $('.support-chat-index__input-helper').css('display', 'flex');
            changeChat(id);
            if (selectedSupportElem != null){
                $(selectedSupportElem).removeClass('selected');
            }
            selectedSupportElem = elem;
            $(elem).addClass('selected');
        }

        var isChangingChat = false;

        function changeChat(id) {
            isChangingChat = true;
            $('.support-chat-index__chat-box').empty();
            $('#loading-indicator').show();
            $('.support-chat-index__chat-box').load('/supportchat/getchatitemlist?id=' + id,
                function () {
                    $('.support-chat-index__chat-box').attr({
                        data_id: id
                    });
                    $('#loading-indicator').hide();
                    isChangingChat = false;
                });
        }

        var isLoadingSupportItems = false;

        function showMoreSupportItems() {
            if (isLoadingSupportItems)
                return;
            isLoadingSupportItems = true;
            $('#temp-holder').load('/supportchat/getsupportitemlist?currentItemCount=' + currentItemCount, function () {
                $('#temp-holder').children().each(function () {
                    currentItemCount++;
                    $('.support-chat-index__support').append($(this));
                });
                isLoadingSupportItems = false;
                $('#temp-holder').empty();
            });
        }

        function placeTempChat(chatBoxElem, id, text, onLoad) {
            $('#temp-holder').load('/supportchat/generateunsentchatitem?supportchatid=' + id + '&text=' + text, function () {
                $('#temp-holder').children().each(function () {
                    $('.support-chat-index__chat-box').prepend($(this));
                    var scrollBottom = $(chatBoxElem).scrollTop() + $(chatBoxElem).height();
                    $(chatBoxElem).scrollTop(scrollBottom);
                });
                $('#temp-holder').empty();
                if (onLoad != undefined) {
                    onLoad();
                }
            });
        }

        function removeTempChat() {
            $('#js-chat-item-0').remove();
        }

        function sendChatText(customText) {
            var text;
            if (typeof customText != 'undefined' && customText != null && customText != '') {
                text = customText;
            }
            else {
                text = $('#js-text-input').val();
                if (text == null || text == '' || typeof text == 'undefined') {
                    return;
                }
                $('#js-text-input').val('');
            }

            var $chatBoxElem = $('.support-chat-index__chat-box');
            var id = parseInt($chatBoxElem.attr('data_id'));
            //placeTempChat($chatBoxElem[0], id, text, function () {
                $.ajax({
                    type: "POST",
                    url: "/supportchat/sendtextsupporter",
                    //data: "{id:" + id + ",text:'" + text + "'}",
                    data: {
                        id: id,
                        text: text
                    },
                    //contentType: "application/json",
                    //dataType: "json",
                    success: function (ret) {
                        if (ret.status == 1) {
                            $('#js-text-input').focus();
                        }
                        else {
                            showErrorMessage('خطا', ret.msg);
                        }
                    }
                });
            //});
        }

        function accomodationIdKeyUp() {
            if (event.keyCode === 13) {
                addAccomodationUrl();
            }
        }

        function chatInputKeyUp() {
            if (event.keyCode === 13) {
                sendChatText();
            }
        }

        function scrollTopSupport() {
            $('#js-new-message-btn').hide(500);
            $('.support-chat-index__support').animate({
                scrollTop: 0
            }, 500);
        }

        function showNewMessageButton() {
            if ($('.support-chat-index__support').scrollTop() > 50) {
                $('#js-new-message-btn').show(500);
            }
        }

        $(document).ready(function () {
            $('.support-chat-index__support').on('scroll', function () {
                if ($(this).scrollTop() + $(this).innerHeight() >= $(this)[0].scrollHeight) {
                    showMoreSupportItems();
                }
                if ($(this).scrollTop() <= 0) {
                    $('#js-new-message-btn').hide(500);
                }
            })

            $('.support-chat-index__chat-box').on('scroll', function () {
                if ($(this).scrollTop()  <= 0) {
                }
            })

            @if (ViewBag.id > 0)
            {
                @:selectSupportItem(@ViewBag.id);
            }
        });

        // Declare a proxy to reference the hub.
        const supportChatAdminHubConnection = new signalR.HubConnectionBuilder()
            .withUrl("/supportchatadminhub")
            .build();

        // Create a function that the hub can call to broadcast messages.
        supportChatAdminHubConnection.on('addChatMessage', (supportChatId, messageId) => {
            debugger;
            if (isChangingChat) {
                return;
            }
            var $chatBoxElem = $('.support-chat-index__chat-box');
            if ($chatBoxElem.attr('data_id').toString() == supportChatId.toString()) {
                debugger;
                $('#temp-holder').load('/supportchat/getchatitem?id=' + messageId + '&supportChatId=' + supportChatId, function () {
                    //removeTempChat();
                    $('#temp-holder').children().each(function () {
                        $('.support-chat-index__chat-box').prepend($(this));
                        var scrollBottom = $chatBoxElem.scrollTop() + $chatBoxElem.height();
                        $chatBoxElem.scrollTop(scrollBottom);
                    });
                    $('#temp-holder').empty();
                });
            }
            var $supportItemElem = $('#js-support-item-' + supportChatId);
            if ($supportItemElem.length == 0) { //new
                $('#temp-holder').load('/supportchat/getsupportitem?id=' + supportChatId, function () {
                    $('#temp-holder').children().each(function () {
                        $('.support-chat-index__support').prepend($(this));
                    });
                    $('#temp-holder').empty();
                });
                showNewMessageButton();
            }
            else { //exists
                var isSelected = $supportItemElem.hasClass('selected');
                $('#temp-holder').load('/supportchat/getsupportitem?id=' + supportChatId, function () {
                    $('#temp-holder').children().each(function () {
                        if (isSelected) {
                            $(this).addClass('selected');
                            selectedSupportElem = this;
                            $(this).insertAfter($supportItemElem);
                            $supportItemElem.remove();
                        }
                        else {
                            $('.support-chat-index__support').prepend($(this));
                            $supportItemElem.remove();
                            showNewMessageButton();
                        }
                    });
                    $('#temp-holder').empty();
                });
            }
        });

        supportChatAdminHubConnection.on('updateChatMessage', (supportChatId, messageId) => {
            debugger;
            if (isChangingChat) {
                return;
            }
            var $chatBoxElem = $('.support-chat-index__chat-box');
            if ($chatBoxElem.attr('data_id').toString() == supportChatId.toString()) {
                setTimeout(function () {
                    var $elem = $('#js-chat-item-' + messageId);
                    debugger;
                    $('#temp-holder').load('/supportchat/getchatitem?id=' + messageId + '&supportChatId=' + supportChatId, function () {
                        $('#temp-holder').children().each(function () {
                            $(this).insertAfter($elem);
                            $elem.remove();
                        });
                        $('#temp-holder').empty();
                    });
                }, 500);
            }
            setTimeout(function () {
                var $supportItemElem = $('#js-support-item-' + supportChatId);
                var isSelected = $supportItemElem.hasClass('selected');
                $('#temp-holder').load('/supportchat/getsupportitem?id=' + supportChatId, function () {
                    $('#temp-holder').children().each(function () {
                        if (isSelected) {
                            $(this).addClass('selected');
                            selectedSupportElem = this;
                        }
                        $(this).insertAfter($supportItemElem);
                        $supportItemElem.remove();
                    });
                    $('#temp-holder').empty();
                });
            }, 1000);
        });

        supportChatAdminHubConnection.start()
            .then(() => console.log('support chat admin hub connected!'))
            .catch(console.error);

        function onChatBoxPaste(elem) {
            debugger;
            setTimeout(function () {
                debugger;
                splitted = $(elem).val().split(' ');
                for (var i = 0; i < splitted.length; i++) {
                    if (splitted[i].includes('.com/')) {
                        splitted[i] = decodeURI(splitted[i]);
                        splitted[i] = splitted[i] + " | کلیک کنید⬅️";
                    }
                }
                var newText = splitted.join(' ');
                $(elem).val(newText);
            }, 50);
        }
    </script>
}