@using Amlakbashi.Core.DTOs.SupportChatDTOs;
@model IEnumerable<SupportChatDTO>

@{
    ViewBag.Title = "چت پشتیبانی";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}

<div id="js-new-message-btn" onclick="scrollTopSupport()" style="position:relative; display:none; width:100px; border-radius:60px; cursor:pointer; text-align:center; border:1px solid #242424; top: 30px;right:13%;background-color:white;color:#242424;">
    🡹 پیام جدید
</div>
<div class="support-chat-index__root">
    <div class="support-chat-index__support">
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_SupportItem", item)
        }
    </div>
    <div style="display:none" class="support-chat-index__chat-container">
        <div id="loading-indicator" style="display:none;position:relative;top:40%;text-align:center;">
            <img width="40" height="40" src="~/Resource/img/loading-image.gif" />
        </div>
        <div class="support-chat-index__chat-box" data_id="0">
        </div>
        <div class="support-chat-index__chat-input">
            <i class="fa fa-play" onclick="sendChatText()"></i>
            <textarea onpaste="onChatBoxPaste(this)" onkeyup="chatInputKeyUp()" id="js-text-input" type="text" placeholder="متن خود را اینجا بنویسید"></textarea>
        </div>
    </div>
</div>
<div style="display:none;flex-wrap:wrap;justify-content:flex-end;" class="support-chat-index__input-helper">
    <div class="support-chat-index__acc-id-helper">
        <input placeholder="کد آگهی => لینک" id="js-accomodation-id-input" onkeyup="accomodationIdKeyUp()" type="text" />
        <div class="support-chat-index__acc-id-button" onclick="addAccomodationUrl()">+</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addReserveProcess()">مراحل رزرو</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addContactLink()">تماس با ما</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addCancelRules()">شرایط کنسلی</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addHostContactMsg()">تماس با میزبان</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addCheckinCheckoutMessage()">تحویل/تخلیه</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addEvidenceMsg()">مدارک</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addGuestPaymentMsg()">پرداخت مهمان</div>
    </div>
    <div class="support-chat-index__acc-id-helper">
        <div class="support-chat-index__acc-id-button" style="font-size:18px;width:100px;cursor:pointer;" onclick="addHostPaymentMsg()">تسویه میزبان</div>
    </div>
</div>
<div id="temp-holder" style="display:none"></div>

@section ScriptLink
{
    <script src="/js/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
}

@section ScriptBlock
{
    <script type="text/javascript">

        var selectedSupportElem;
        var currentItemCount = 10;

        function addAccomodationUrl() {
            var id = $('#js-accomodation-id-input').val();
            if (id == '' || isNaN(id)) {
                showErrorMessage('خطا', 'لطفا کد آگهی را وارد کنید');
                $('#js-accomodation-id-input').focus();
                return;
            }
            myajax('accomodation/getaccomodationurl', 'id=' + id, function (ret) {
                if (ret.status == 1) {
                    var text = $('#js-text-input').val();
                    text += (" " + ret.url + " ");
                    $('#js-accomodation-id-input').val('');
                    $('#js-text-input').val(text);
                    $('#js-text-input').focus();
                }
                else if (ret.status == -1) {
                    showErrorMessage('خطا', 'کد آگهی یافت نشد. لطفا دوباره بررسی کنید');
                    $('#js-accomodation-id-input').focus();
                }
                else {
                    showErrorMessage('خطا', 'متاسفانه عملیات با خطای فنی مواجه شد');
                    $('#js-accomodation-id-input').focus();
                }
            });
        }

        function addReserveProcess() {
            var text = 'مراحل رزرو از سایت املاک باشی' + '\n\n' +
            '1- از طریق کادر جستجو مقصد سفر خود را سرچ کنید' + '\n\n' +
            '2- از فیلتر بالای سایت میتوانید تعداد نفرات و تاریخ سفر را فیلتر کنید و از بخش فیلترهای بیشتر ، محدوده قیمت ، استخر ، تعداد اتاق خواب و سایر موارد مد نظر را انتخاب کنید سپس بر روی دکمه اعمال فیلتر کلیک نمایید تا اقامتگاه های مناسب شما نمایش داده شود' + '\n\n' +
            '3- موارد یافت شده را چک کنید و اقامتگاه مورد پسندتان را با کلیک بر روی آگهی باز کنید' + '\n\n' +
            '4- اطلاعات اقامتگاه را مطالعه کنید و در صورت تمایل درخواست رزرو را ثبت کنید و منتظر پیامک یا تماس از طریق سایت باشید' + '\n\n' +
            '.' + '\n\n' +
            '.' + '\n\n' +
            'دانلود اپلیکیشن املاک باشی' + '\n\n' +
            '👇' + '\n\n' +
            'https://www.amlakbashi.com/post/downloadapp';
            sendChatText(text);
        }

        function addCancelRules() {
