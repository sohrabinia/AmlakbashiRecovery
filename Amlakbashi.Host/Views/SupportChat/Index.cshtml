        function addCheckinCheckoutMessage() {
            var text = 'تحویل و تخلیه چه ساعتی میباشد؟' + '\n' +
             'قانونا تحویل ساعت 2 ظهر و تخلیه 12 ظهر میباشد' + '\n\n' +
