             'درخواست رزرو را برای واحدی که مورد پسند شماست ثبت کنید (ثبت درخواست رزرو رایگان میباشد ) سپس میتوانید از طریق چت با میزبان با ایشان در این باره گفتگو کنید . پشتیبانها نیز درخواستها و سوالات شما را پیگیری خواهند کرد .' + '\n\n' +
             'آیا میتوانم واحد را صبح تحویل بگیرم؟' + '\n' +
             'معمولا به این دلیل که مهمان قبلی شما تا ساعت قانونی یعنی 12 ظهر داخل واحد میباشد و میزبان ساعتی را برای نظافت واحد در نظر میگیرد این امکان وجود ندارد مگر اینکه مهمان قبلی شما زودتر واحد را تخلیه کند یا اینکه شب قبل واحد خالی بماند . با این حال میتوانید درخواست رزرو را برای واحدی که مورد پسند شماست ثبت کنید (ثبت درخواست رزرو رایگان میباشد ) سپس میتوانید از طریق چت با میزبان با ایشان در این باره گفتگو کنید . پشتیبانها نیز درخواستها و سوالات شما را پیگیری خواهند کرد .' + '\n\n' +
             'آیا میتوانم واحد را دیرتر تخلیه کنم؟' + '\n' +
             'معمولا به این دلیل که مهمان بعدی شما ، ساعت قانونی یعنی 2 ظهر واحد را تحویل میگیرد و میزبان ساعتی را برای نظافت واحد در نظر میگیرد این امکان وجود ندارد مگر اینکه مهمان بعدی شما دیرتر واحد را تحویل بگیرد یا اینکه روز بعد واحد خالی باشد . با این حال میتوانید درخواست رزرو را برای واحدی که مورد پسند شماست ثبت کنید (ثبت درخواست رزرو رایگان میباشد ) سپس میتوانید از طریق چت با میزبان با ایشان در این باره گفتگو کنید . پشتیبانها نیز درخواستها و سوالات شما را پیگیری خواهند کرد .';
            sendChatText(text);
        }

        function addEvidenceMsg() {
            var text = 'مدارک مورد نیاز برای رزرو اقامتگاه چیست؟' + '\n' +
             'مدارک دریافتی مورد نیاز هر میزبان در قسمت قوانین و مقررات هر آگهی ذکر شده است .' + '\n\n' +
             'آیا ارائه مدارک محرمیت الزامیست؟' + '\n' +
             'طبق قوانین سایت ارائه مدرک محرمیت الزامی است و اجرای این قانون وظیفه میزبان میباشد .';
            sendChatText(text);
        }

        function addGuestPaymentMsg() {
            var text = 'نحوه پرداخت مهمان' + '\n' +
             'بعد از قبول درخواست رزرو توسط میزبان از راه های زیر می توانید پرداخت را انجام دهید' + '\n' +
             '1- لینک پرداخت برای شما پیامک میشود با کلیک روی لینک به درگاه بانک متصل میشود' + '\n' +
             '2- با ورود به حساب کابری ( حساب من) > رزرو های من > رزرو های در انتظار پرداخت > روی گزینه پرداخت کلیک کنید' + '\n' +
             '3- درصورتیکه رمز دوم ندارید در ساعات کاری ( 9 صبح تا 11/30 شب ) مبلغ را به شماره کارت 5022291011509526 بانک پاسارگاد بنام محمدعلی سهرابی نیا واریز نمائید و فیش واریزی را به شماره 09360263804 واتساپ کنید';
            sendChatText(text);
        }

        function addHostPaymentMsg() {
            var text = 'نحوه تسویه با میزبان میزبان' + '\n' +
             'رزرو های یک روزه پس از 24 ساعت از شروع سفر و رزرو های بیشتر از 2 روز پس از 48 ساعت تسویه حساب میشود' + '\n' +
             'ساعت تسویه با میزبان از ساعت 12 تا 14 میباشد';
            sendChatText(text);
        }

        //function addTextTemplate() {
        //    var text = '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
        //     '' + '\n' +
