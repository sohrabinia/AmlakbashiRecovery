
@{
    ViewBag.Title = "تغییر رمز عبور";
    ViewBag.profile = true;
    Layout = "~/Views/Shared/_Dashboard.cshtml";
    var errors = ViewBag.errors as List<string>;
}

<div class="profile">
    @if (errors != null && errors.Count > 0)
    {
    <div class="profile__msg">@errors.FirstOrDefault()</div>
    }

    @if (ViewBag.suc != null)
    {
        <div class="profile__suc">@ViewBag.suc</div>
    }
    <form asp-controller="user" asp-action="changepassword" method="post">
        <div class="profile__title">تعیین رمز عبور جدید</div>
        @if (ViewBag.hasPass == true)
        {
            <div class="profile__item ">
                <span class="profile__label">رمز عبور فعلی :</span>
                <span class="profile__text">
                    <input type="password" id="profile_currentpass" placeholder="رمز عبور فعلی" name="currentPassword" title="رمز عبور فعلی" class="mandatory" />
                </span>
            </div>
        }
        <div class="profile__item ">
            <span class="profile__label">رمز عبور جدید :</span>
            <span class="profile__text">
                <input type="password" id="profile_newpass" placeholder="رمز عبور جدید" name="newPassword" title="رمز عبور جدید" class="mandatory" />
            </span>
        </div>
        <div class="profile__item ">
            <span class="profile__label">تکرار رمز عبور جدید :</span>
            <span class="profile__text">
                <input type="password" id="profile_confpass" placeholder="تکرار رمز عبور جدید" name="confirmPassword" title="تکرار رمز عبور جدید" class="mandatory" />
            </span>
        </div>
        <input type="submit" value="ذخیره" class="profile__submit" />
    </form>
</div>