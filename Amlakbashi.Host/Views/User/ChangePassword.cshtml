
@{
    ViewBag.Title = "تغییر رمز عبور";
    ViewBag.profile = true;
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="profile">
    @if (ViewBag.msg != null)
    {
        <div class="profile__msg">@ViewBag.msg</div>
    }

    @if (ViewBag.suc != null)
    {
        <div class="profile__suc">@ViewBag.suc</div>
    }
    <form asp-controller="user" asp-action="changepassword" method="post">
        <div class="profile__item ">
            <span class="profile__label">رمز عبور فعلی :</span>
            <span class="profile__text">
                <input type="text" id="profile_fname" placeholder="رمز عبور فعلی" name="currentPassword" title="رمز عبور فعلی" class="mandatory" />
            </span>
        </div>
        <div class="profile__item ">
            <span class="profile__label">رمز عبور جدید :</span>
            <span class="profile__text">
                <input type="text" id="profile_fname" placeholder="رمز عبور جدید" name="newPassword" title="رمز عبور جدید" class="mandatory" />
            </span>
        </div>
        <div class="profile__item ">
            <span class="profile__label">تکرار رمز عبور جدید :</span>
            <span class="profile__text">
                <input type="text" id="profile_lname" placeholder="تکرار رمز عبور جدید" name="confirmPassword" title="تکرار رمز عبور جدید" class="mandatory" />
            </span>
        </div>
    </form>
</div>