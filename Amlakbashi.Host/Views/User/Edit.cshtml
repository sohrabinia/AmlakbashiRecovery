@using Entities = Amlakbashi.Core.Entities;

@model Amlakbashi.Core.DTOs.UserDTOs.UserEditDTO

@{
    ViewBag.Title = "حساب کاربری";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}

<div class="title">ثبت و ویرایش حساب کاربری</div>

@using (Html.BeginForm("Edit", "User", new { id = Model.Id }, FormMethod.Post, true, new { id = "userManageForm" }))
{
    <input type="hidden" name="MainMobile" value="@Model.MainMobile" />
    <input type="hidden" name="PhotoID" value="@Model.PhotoID" />
    <input type="hidden" name="EmailAddress" value="@Model.EmailAddress" />
    <input type="hidden" name="LastSendedEmailCode" value="@Model.LastSendedEmailCode" />
    <input type="hidden" name="LastSendedSmsCode" value="@Model.LastSendedSmsCode" />
    <input type="hidden" name="InstantReserveCancelCount" value="@Model.InstantReserveCancelCount" />
    <input type="hidden" name="Credit" value="@Model.Credit" />
    <input type="hidden" name="UserScore" value="@Model.UserScore" />
    <table>
        <tr>
            <td class="label">
                شماره موبایل اصلی:
            </td>
            <td style="direction:ltr">
                @Model.MainMobile
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                نام:
            </td>
            <td style="width:300px;">
                @Html.EditorFor(model => model.FName)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                نام خانوادگی:
            </td>
            <td>
                @Html.EditorFor(model => model.LName)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                شماره موبایل 2:
            </td>
            <td style="direction:ltr">
                @Html.EditorFor(model => model.Mobile)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                شماره موبایل 3:
            </td>
            <td style="direction:ltr">
                @Html.EditorFor(model => model.Mobile2)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                تلفن ثابت :
            </td>
            <td style="direction:ltr">
                @Html.EditorFor(model => model.Tell)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                تلفن شخص ثالث :
            </td>
            <td style="direction:ltr">
                @Html.EditorFor(model => model.ThirdPersonTell)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                وضعیت کاربر :
            </td>
            <td style="width:300px;">
                @{
                    var states = Entities.User.GetAdminStateEnum();
                }
                @if (Model.UserState == Entities.User.UserState.InActived)
                {
                    <input type="hidden" name="userState" value="2" />
                    <span>غیرفعال</span>
                }
                else
                {
                    <select name="UserState">
                        @foreach (var item in states)
                        {
                            <option is-selected="@(item == Model.UserState)" value="@((int)item)">@(Entities.User.GetStateTitle((int)item))</option>
                        }
                    </select>
                }
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                توضیحات :
            </td>
            <td>
                @Html.TextAreaFor(model => model.Address)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">عکس پروفایل:</td>
            <td class="value">
                @if (Model.PhotoID > 0)
                {
                    <img height="200" src='@string.Format("/file/imgThumbOld?FileID={0}&h=500", Model.PhotoID)' />
                }
                else
                {
                    <span>ندارد</span>
                }
            </td>
            <td>
                @if (Model.PhotoID > 0)
                {
                    <a target="_blank" class="dz-edit" href="@string.Format("/file/photocropper?id={0}", Model.PhotoID)">ویرایش</a>
                }
            </td>
        </tr>
        <tr>
            <td class="label">
                امتیاز اصلی کاربر:
            </td>
            <td style="width:300px;">
                @Model.UserScore
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                امتیاز املاک باشی :
            </td>
            <td>
                @Html.EditorFor(model => model.AmlakbashiScore)
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                وضعیت مالکیت :
            </td>
            <td style="width:300px;">
                <select name="OwnerShip">
                    <option is-selected="@((int)Entities.User.OwnerType.real_reservation == Model.OwnerShip)" value="0">واسطه‌ی حتمی</option>
                    <option is-selected="@((int)Entities.User.OwnerType.reservation == Model.OwnerShip)" value="1">واسطه‌ی احتمالی</option>
                    <option is-selected="@((int)Entities.User.OwnerType.owner == Model.OwnerShip)" value="3">مالک احتمالی</option>
                    <option is-selected="@((int)Entities.User.OwnerType.owner == Model.OwnerShip)" value="10">مالک حتمی</option>
                </select>
            </td>
            <td></td>
        </tr>

        <tr>
            <td class="label">
                محدودیت کنسلی رزرو آنی (میزبان) :
            </td>
            <td style="direction:ltr">
                @Html.EditorFor(model => model.CancelInstantReserveLimit)
            </td>
            <td>تعداد کنسلی ها: @Model.InstantReserveCancelCount</td>
        </tr>
        <tr>
            <td>آدرس ایمیل کاربر: @Model.EmailAddress</td>
            <td>آخرین کد ارسال شده پیامک: @Model.LastSendedSmsCode</td>
            <td>آخرین کد ارسال شده به ایمیل: @Model.LastSendedEmailCode</td>
        </tr>
        <tr><td colspan="3" class="tablesplit"></td></tr>
        <tr>
            <td>
                <div style="text-align:right">
                    <span>تماس با کاربر:</span>
                    <input id="complete_profile_contact_checkbox" name="ContactPhone" type="checkbox" value="true" is-checked="@Model.ContactPhone" />
                </div>
            </td>
            <td>
                <div style="text-align:right">
                    <span>امکان دسترسی به مناطق ممنوعه:</span>
                    <input name="ForbiddenRegionsAccess" type="checkbox" value="true" is-checked="@Model.ForbiddenRegionsAccess" />
                </div>
            </td>
        </tr>
    </table>

    <div style="margin-top:20px;">
        <input class="apply" type="submit" value="ثبت" />
        <a class="cancel" href='@Url.Action("Index")'>انصراف</a>
    </div>
}

@section ScriptBlock
{
    <script type="text/javascript">
        @if (Model.HasError)
        {
            foreach (var item in Model.ErrorMessages)
            {
                @: alertify.error("@item");
            }
        }
    </script>
}