@using Entities = Amlakbashi.Core.Entities;
@using Amlakbashi.Core.DTOs.UserDTOs;

@model IEnumerable<User>

@{
    ViewBag.Title = "مدیریت کاربران";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
    var data = ViewBag.dto as UserIndexDTO;
}

<style>
    .table-content-row:nth-child(2n+1) {
        background-color: #eee;
    }

    .dynamic-filter_box-items {
        display: flex;
        flex-flow: row wrap;
        justify-content: space-between;
    }

    .operation-icons a, .operation-icons i {
        color: black;
        text-decoration: none;
        cursor: pointer;
        font-size: 20px;
        margin: 0 1px;
    }
</style>

