    <div style="display:flex;max-width:800px;flex-flow:row;margin:10px;justify-content:space-between;border:1px solid #ccc;padding: 10px;">
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.All))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.All ? "#fdd835" : "#ffffff")">همه</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.ActiveHost))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.ActiveHost ? "#fdd835" : "#ffffff")">میزبان فعال</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.Host))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.Host ? "#fdd835" : "#ffffff")">میزبان</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.Guest))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.Guest ? "#fdd835" : "#ffffff")">مهمان</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.Staff))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.Staff ? "#fdd835" : "#ffffff")">کارمندان</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.InstantReserveRequest))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.InstantReserveRequest ? "#fdd835" : "#ffffff")">درخواست رزرو آنی</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.InstantReserveAllow))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.InstantReserveAllow ? "#fdd835" : "#ffffff")">رزرو آنی</div>
        <div onclick="toggleUserFilter(@((int)Entities.User.UserFilterType.PhotoChangeRequest))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(data.UserFilterType == Entities.User.UserFilterType.PhotoChangeRequest ? "#fdd835" : "#ffffff")">در انتظار تایید عکس</div>
    </div>
    <div style="overflow: auto;">
        <table>
            <tr>
                <th class="minw">
                    ردیف
                </th>
                <th>
                    شناسه
                </th>
                <th>
                    نام کاربری
                </th>
                <th>
                    موبایل
                </th>
                <th>
                    نام و نام خانوادگی
                </th>
                @if (data.UserFilterType != Entities.User.UserFilterType.Staff)
                {
                    <th>
                        وضعیت
                    </th>
                    <th>
                        تماس با کاربر
                    </th>
                    if (data.UserFilterType != Entities.User.UserFilterType.Guest)
                    {
                        <th>
                            امتیاز
                        </th>
                    }
                    <th>
                        اعتبار کیف پول
                    </th>
                    <th>
                        نوع کاربر
                    </th>
                }
                @if (data.UserFilterType == Entities.User.UserFilterType.Staff)
                {
                    <th>شماره کارت</th>
                    <th>شماره شبا</th>
                }
                @if (data.UserFilterType == Entities.User.UserFilterType.InstantReserveRequest ||
                   data.UserFilterType == Entities.User.UserFilterType.InstantReserveAllow)
                {
                    <th>
                        رزرو آنی
                    </th>
                }
                <th>
                    عملیات
                </th>
            </tr>
            @{
                int Idx = (int)data.RowIndexStart;
            }
            @foreach (var item in data.UserItems)
            {
                Idx++;

                <tr id="js-row-@item.User.Id" class="table-content-row">
                    <td>
                        @Idx
                    </td>
                    <td>@item.User.Id</td>
                    <td style="direction:ltr">
                        @Html.DisplayFor(modelItem => item.User.MainMobile)
                    </td>
                    <td style="direction:ltr">
                        @Html.DisplayFor(modelItem => item.User.Mobile)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.User.FullName)
                    </td>
                    @if (data.UserFilterType != Entities.User.UserFilterType.Staff)
                    {
                        <td>
                            <span onclick="changeUserStatus(@item.User.Id, this)" class="@(item.State == Entities.User.UserState.Acticved ? "fa fa-check-circle" : "fa fa-times-circle")" style="color: @(item.State == Entities.User.UserState.Acticved ? "limegreen" : "red"); font-size: 20px; cursor: pointer;"></span>
                        </td>
                        <td>
                            <span onclick="changeCompleteProfileContact(@item.User.Id,this)" class="@(string.IsNullOrEmpty(item.User.ContactPhone) == false && item.User.ContactPhone == "1" ? "fa fa-check-circle" : "fa fa-times-circle")" style="color: @(string.IsNullOrEmpty(item.User.ContactPhone) == false && item.User.ContactPhone == "1" ? "limegreen" : "red"); font-size: 20px; cursor: pointer;"></span>
                        </td>
                        if (data.UserFilterType != Entities.User.UserFilterType.Guest)
                        {
                            <td>
                                @item.User.UserScore
                            </td>
                        }
                        <td class="credit_label">
                            @(string.Format("{0:n0}", item.User.Credit)) تومان
                        </td>
                        <td>
                            <span class="general_type_label" style="color:@(Entities.User.GetUserGeneralTypeColor(item.User.UserGeneralType))">@(Entities.User.GetUserGeneralTypeString(item.User.UserGeneralType))</span>
                        </td>
                    }
                    @if (data.UserFilterType == Entities.User.UserFilterType.Staff)
                    {
                        var bankCard = item.BankCard;
                        <td>
                            @(bankCard != null && !string.IsNullOrEmpty(bankCard.BankCardNumber) ? bankCard.BankCardNumber : "-")
                        </td>
                        <td>
                            @(bankCard != null && !string.IsNullOrEmpty(bankCard.ShabaNumber) ? bankCard.ShabaNumber : "-")
                        </td>
                    }
                    @if (data.UserFilterType == Entities.User.UserFilterType.InstantReserveRequest)
                    {
                        <td>
                            <div onclick="showInstantReserveMsg(@item.User.Id)" style="cursor:pointer;border-radius:5px;background-color:#fdd835;padding:5px;">تایید درخواست</div>
                        </td>
                    }
                    @if (data.UserFilterType == Entities.User.UserFilterType.InstantReserveAllow)
                    {
                        <td>
                            <div style="display:flex;flex-flow:row;">
                                <div style="margin:0 10px;color:@(item.User.InstantReserveAccess == Entities.User.InstantReserveAccessEnum.Banned ? "red" : "#34A853")">@(item.User.InstantReserveAccess == Entities.User.InstantReserveAccessEnum.Banned ? "ممنوع" : "فعال")</div>
                                <div>تعداد لغو:‌ @item.InstantReserveCancel</div>
                            </div>
                        </td>
                    }
                    @if (item.State == Entities.User.UserState.Acticved || item.State == Entities.User.UserState.ReserveBanned)
                    {
                        <td class="operation-icons">
                            <a href="@Url.Action("Edit",new {id= item.User.Id})" class="fas fa-edit" title="ویرایش"></a>
                            <a title="آگهی های کاربر" class="fa fa-home" href='/user/impersonate?userId=@(item.User.Id)&url=/post/accomodationmanager' target="_blank"></a>
                            <a class="fa fa-book" title="رزرو های این @(item.User.UserGeneralType == 0 ? "مهمان" : "میزبان")" target="_blank" href="/reserve/newindex?@(item.User.UserGeneralType == 0 ? "Guest" : "Host")UserId=@item.User.Id"></a>
                            <i onclick="UserWalletInfo(@item.User.Id)" class="fa fa-credit-card" style="cursor:pointer" title="کیف پول"></i>
                            <a asp-controller="wallet" asp-action="index" asp-route-userId="@item.User.Id" title="تراکنش های کیف پول" class="fa fa-money-bill-alt" target="_blank"></a>
                            <a class="fa fa-user" href="/user/impersonate?userId=@(item.User.Id)&url=/user/profilemanager" target="_blank" title="پروفایل کاربر"></a>
                            <a href="/user/impersonate?userId=@item.User.Id" class="fa fa-sign-in-alt" title="ورود به عنوان کاربر" target="_blank"></a>
                            <i class="fa fa-check-circle" onclick="publish_photo(@item.User.Id,this)" title="انتشار عکس"></i>
                            <i class="fa fa-times-circle" onclick="disapprove_photo(@item.User.Id,this)" title="عدم تایید عکس"></i>
                            <i onclick="getUserDesc(@item.User.Id)" class="fa fa-question-circle" title="توضیحات"></i>
                            <a asp-controller="role" asp-action="edituserrole" asp-route-userId="@item.User.Id" class="fa fa-id-card" title="مدیریت رول ها"></a>
                        </td>
                    }
                    else
                    {
                        <td class="operation-icons">
                            <a href="@Url.Action("Edit",new {id= item.User.Id})" class="fas fa-edit" title="ویرایش"></a>
                            <a title="آگهی های کاربر" class="fa fa-home" asp-controller="advertise" asp-action="index" asp-route-userId="@item.User.Id" target="_blank"></a>
                            <a class="fa fa-book" title="رزرو های این @(item.User.UserGeneralType == 0 ? "مهمان" : "میزبان")" target="_blank" href="/reserve/newindex?@(item.User.UserGeneralType == 0 ? "guest" : "host")_user_id=@item.User.Id"></a>
                            <i onclick="UserWalletInfo(@item.User.Id)" class="fa fa-credit-card" title="کیف پول"></i>
                            <a asp-controller="wallet" asp-action="index" asp-route-userId="@item.User.Id" title="تراکنش های کیف پول" class="fa fa-money-bill-alt" target="_blank"></a>
                            <i class="fa fa-check-circle" onclick="publish_photo(@item.User.Id,this)" title="انتشار عکس"></i>
                            <i class="fa fa-times-circle" onclick="disapprove_photo(@item.User.Id,this)" title="عدم تایید عکس"></i>
                            <i onclick="getUserDesc(@item.User.Id)" class="fa fa-question-circle" title="توضیحات"></i>
                            <a asp-controller="role" asp-action="edituserrole" asp-route-userId="@item.User.Id" class="fa fa-id-card" title="مدیریت رول ها"></a>
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
}
<div class="mypagelist">
    @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", "User", new
    {
        page,
        uname = data.Uname,
        photo = data.Photo,
        sort_order = data.SortOrder,
        ownership = data.Ownership,
        mobile_status = data.MobileStatus,
        status = data.Status,
        advertise_count = data.AdvertiseCount,
        complete_profile_status = data.CompleteProfileStatus,
        complete_profile_contact_status = data.CompleteProfileContactStatus,
        user_general_type = data.UserGeneralType,
        Province = data.Province,
        City = data.City,
        Area = data.Area,
        advertiseId = data.AdvertiseId,
        userFilterType = (int)data.UserFilterType,
        card_status = data.CardStatus,
        minReserveNorouzFromDate = data.MinReserveNorouzFromDate
    }),
    new PagedListRenderOptions { LinkToFirstPageFormat = "ابتدا", LinkToPreviousPageFormat = "قبلی", LinkToNextPageFormat = "بعدی", LinkToLastPageFormat = "انتها", MaximumPageNumbersToDisplay = 5, DelimiterBetweenPageNumbers = "|" })
</div>


@section ScriptBlock
{
    <script type="text/javascript">
        function loginUserDirectly(id) {
            myajax('user/loginuserdirectly', 'id=' + id, function (ret) {
                if (ret.status == 0) {
                    showErrorMessage('خطا', ret.msg);
                    return;
                }
                var url = '/admin/loginuserdirectly?token=' + ret.token;
                copyStringToClipboard('https://www.amlakbashi.com' + url, 'لینک ورود');
            });
        }

        $('.impersonateDenied').on('click', function () {
            showErrorMessage("", "وضعیت دسترسی کاربر در حالت «عدم دسترسی به وب سایت» قرار دارد");
        });

        function copyStringToClipboard (str, name) {
            // Create new element
            var el = document.createElement('textarea');
            // Set value (string to be copied)
            el.value = str;
            // Set non-editable to avoid focus and move outside of view
            el.setAttribute('readonly', '');
            el.style = {position: 'absolute', left: '-9999px'};
            document.body.appendChild(el);
            // Select text inside element
            el.select();
            // Copy text to clipboard
            document.execCommand('copy');
            // Remove temporary element
            document.body.removeChild(el);
            alertify.success(name + " کپی شد");
        }

        function changeUserStatus($uid, obj) {
            if ($(obj).hasClass("fa-check-circle"))
            {
                myajax("User/changeUserStatus", "uid=" + $uid + "&status=false", function (ret) {
                    if (ret.status == 1) {
                        $(obj).removeClass("fa-check-circle").addClass("fa-times-circle");
                        $(obj).css("color", "red");
                    }
                });
            }
            else
            {
                myajax("User/changeUserStatus", "uid=" + $uid + "&status=true", function (ret) {
                    if (ret.status == 1) {
                        $(obj).removeClass("fa-times-circle").addClass("fa-check-circle");
                        $(obj).css("color", "limegreen");
                    }
                });
            }
        }

