                myajax("User/changeCompleteProfileContactStatus", "uid=" + $uid + "&status=true", function (ret) {
                    if (ret.status == 1) {
                        $(obj).removeClass("fa-times-circle").addClass("fa-check-circle");
                        $(obj).css("color", "limegreen");
                    }
                });
            }
        }

