        function getUserDesc(id) {
            myajax("user/changedesc", "userId=" + id, function (ret) {
                if (ret.status == 1) {
                    showInfoMessage(
                        'توضیحات کاربر', '<input type="hidden" id="userIdInput" value="' + id + '" />' +
                        '<textarea id="userDescInput">' + ret.desc + '</textarea>', {
                        buttons: [{
                            title: 'بستن',
                            color: 'white',
                            bgColor: '#EA4335'
                        },
                        {
                            title: 'ثبت تغییرات',
                            color: 'white',
                            bgColor: '#34A853',
                            onclick: submitUserDesc
                        }], autoClose: false
                    });
                }
                else if (ret.status == 0) {
                    alertify.error(ret.msg);
                }
            });
        }

        function submitUserDesc() {
            var userId = $("#userIdInput").val();
            var desc = $("#userDescInput").val();
            $.ajax({
                url: "/user/changedesc",
                type: "post",
                data: {
                    userId: userId,
                    desc: desc
                },
                success: function (ret) {
                    if (ret.status == 1) {
                        alertify.success(ret.msg);
                    }
                    else {
                        alertify.error(ret.msg);
                    }
                },
                error: function (ret) {
                    alertify.error(ret.msg);
                }
            });
        }

        function increaseCredit($id) {
            if (typeof incDecMsg != 'undefined') {
                incDecMsg.close();
            }
            var content_addition = '<span>مبلغ: </span><input type="number" id="increase_credit_input"/>' + '<br />' +
                '<span>شماره تراکنش: </span><input type="number" id="increase_credit_transaction_id"/>' + '<br />' +
                '<span>دلیل افزودن مبلغ: </span><input type="text" id="increase_credit_transaction_cause"/>' + '<br />' +
                '<input type="checkbox" id="increase_credit_send_sms" /> ارسال اس ام اس';
            $.confirm({
                title: 'واریز به کیف پول',
                content: 'لطفا مبلغ را وارد کنید' + '<br />' + content_addition,
                type: 'blue',
                rtl: true,
                typeAnimated: true,
                buttons: {
