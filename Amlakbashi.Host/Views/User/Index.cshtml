                            <option value="@((int)Entities.User.UserState.InActived)" is-selected="@((int)data.Status == (int)Entities.User.UserState.InActived)">@Entities.User.GetStateTitle((int)Entities.User.UserState.InActived)</option>
                            <option value="@((int)Entities.User.UserState.Suspend)" is-selected="@((int)data.Status == (int)Entities.User.UserState.Suspend)">@Entities.User.GetStateTitle((int)Entities.User.UserState.Suspend)</option>
                            <option value="@((int)Entities.User.UserState.ReserveBanned)" is-selected="@((int)data.Status == (int)Entities.User.UserState.ReserveBanned)">@Entities.User.GetStateTitle((int)Entities.User.UserState.ReserveBanned)</option>
