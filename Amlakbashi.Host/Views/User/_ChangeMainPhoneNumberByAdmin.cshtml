@model int

<style>
    .new-main-mobile-btn {
        cursor: pointer;
        padding: 10px;
        border-radius: 5px;
        font: 1em miransans;
    }
</style>

<div style="text-align: center;">
    <form id="enter-phone-number-form">
        <small><b style="color: red;">توجه:</b> امکان ثبت شماره هایی که توسط آن ها حساب کاربری ایجاد شده باشد، وجود ندارد.</small>
        <br />
        <br />
        <p>لطفا شماره موبایل جدید کاربر را وارد کنید:</p>
        <input type="text" placeholder="شماره موبایل ..." id="newPhoneNumberTxt" />
        <br />
        <br />
        <button class="new-main-mobile-btn" type="button" onclick="popupMsgList[0].btnClick(0, true)">انصراف</button>
        <button class="new-main-mobile-btn" style="background-color: #fDc831;" type="submit">ثبت</button>
    </form>
    <form id="enter-verify-code-form" style="display: none;">
        <p>لطفا کد ارسال شده به شماره موبایل جدید کاربر را وارد کنید:</p>
        <input type="text" placeholder="کد تایید ..." id="verifyCodeTxt" />
        <br />
        <br />
        <button class="new-main-mobile-btn" type="button" onclick="popupMsgList[0].btnClick(0, true)">انصراف</button>
        <button class="new-main-mobile-btn" style="background-color: #fDc831;" type="submit">تایید</button>
    </form>
    <br />
</div>

<script>
    var userId = @Model;

    $("#enter-phone-number-form").submit(function (e) {
        e.preventDefault();
        var phoneNumber = $('#newPhoneNumberTxt').val();
        $.ajax({
            url: "/user/ChangeMainPhoneNumberbyadmin",
            type: "post",
            data: {
                userId: userId,
                newMainPhoneNumber: phoneNumber
            },
            success: function (response) {
                if (response.status === 1) {
                    $('#enter-phone-number-form').hide();
                    $('#enter-verify-code-form').show();
                }
                else if (response.status === 2) {
                    alertify.success('شماره اصلی کاربر با موفقیت تغییر یافت');
                    popupMsgList[0].btnClick(0, true);
                }
                else {
                    alertify.error(response.msg);
                }
            },
            error: function (ret) {
                alertify.error("عملیات با خطا مواجه شد");
            }
        });
    });

    $("#enter-verify-code-form").submit(function (e) {
        e.preventDefault();
        var verifyCode = $('#verifyCodeTxt').val();
        $.ajax({
            url: "/user/VerifyChangeMainPhoneNumberbyadmin",
            type: "post",
            data: {
                userId: userId,
                verifyCode: verifyCode
            },
            success: function (response) {
                if (response.status === 1) {
                    alertify.success('شماره اصلی کاربر با موفقیت تغییر یافت');
                    popupMsgList[0].btnClick(0, true);
                }
                else {
                    alertify.error(response.msg);
                }
            },
            error: function (ret) {
                alertify.error("عملیات با خطا مواجه شد");
            }
        });
    });
</script>