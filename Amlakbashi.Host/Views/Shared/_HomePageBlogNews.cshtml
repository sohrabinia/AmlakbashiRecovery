@model IEnumerable<BlogPost>
@{
}
@if (Model != null && Model.Any())
{
<div class="home-page__category-label-container">
    <p class="home-page-title-blog">جدیدترین مطالب وبلاگ</p>
    <a target="_blank" href="https://blog.amlakbashi.com" class="home-page__category-link home-page__link">نمایش همه <i class="fa fa-chevron-left"></i></a>
</div>
    <div class="home-page__blog-news-container">
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_BlogNewsItem", new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) {
                {"title", item.Title },
                {"href", item.BlogLink },
                {"photoId", item.PhotoID }
            })
        }
    </div>
}