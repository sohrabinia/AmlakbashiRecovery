@inject IUserAccessor userAccessor;
@{  
    var user = userAccessor.CurrentUser;
    var displayNone = ViewBag.hidden ? "display:none;" : "";
}
<div id="js-impersonate-banner" style="position:relative;@(displayNone)top:0;height:48px;left:0;right:0;z-index:9999;width:100%;padding:8px;background: #c2332d;">
    <p id="js-impersonate-fullname" style="font:15px Miransans;margin:0;color:#f7f7f7;text-align:center;">ورود به عنوان @(user.Id > 0 ? user.FullName : "")</p>
    <a href="/user/impersonatelogout" style=" font: 13px Miransans;color:#f7f7f7;position:absolute;top:12px;right:28px;"><i style="font-size: 12px; color: white; vertical-align: sub; margin-left: 7px;" class="fas fa-arrow-right"></i>بازگشت به مدیریت کاربران</a>
</div>

