@model Reserve
@{
    var informations = Model.GetCancelDiscussionList().Reverse();
 }
<div style="display:flex;flex-flow:column;">
    @if (Model == null || informations == null || informations.Count() == 0)
    {
        <p>موردی برای نمایش وجود ندارد</p>
    }
    else
    {
        foreach (var item in informations)
        {
            <div style="direction:rtl; text-align: right;">@item</div>
        }
    }
</div>

