@{
    var selectEnabled = ViewBag.selectEnabled != null ? (bool)ViewBag.selectEnabled : false;
    var filterItemClass = "dynamic-filter__item";
    //var filterPropertyClass = "dynamic-filter__property";
    var filterLabelClass = "static-advertise__label";
}

<div class="dynamic-filter_box-items form-step">
    <div class="@filterItemClass">
        <p class="@filterLabelClass">استان </p>
        <select is-disabled="@(!selectEnabled)" class="js-province-select js-disable-error changed-input-target @(ViewBag.mandatory ? "js-mandatory" : "") @(ViewBag.provinceError == null || ViewBag.provinceError ? "" : "input-validation-error")" name="@ViewBag.provinceName"
                onchange='callRegionFillChild("@(ViewBag.guid)", this, @((int)Region.AdvertiseRegion.City), @((int)ViewBag.region_filter_status))'
                pid="@(ViewBag.guid + "-" + (int)Region.AdvertiseRegion.Province)">
            <option value="-1">استان را انتخاب کنید </option>
            @foreach (var item in ViewBag.provinces)
            {
                <option is-disabled="@(item.Id == ViewBag.province)" value="@item.Id">@item.PersianName</option>
            }
        </select>
    </div>

    <div class="@filterItemClass">
        <p class="@filterLabelClass">شهر </p>
        <select is-disabled="@(!selectEnabled)" class="js-city-select js-disable-error changed-input-target js-region-select-input @(ViewBag.mandatory ? "js-mandatory" : "") @(ViewBag.cityError == null || ViewBag.cityError ? "" : "input-validation-error")" name="@ViewBag.cityName" pid="@(ViewBag.guid + "-" + (int)Region.AdvertiseRegion.City)" onchange='callRegionFillChild("@(ViewBag.guid)", this, @((int)Region.AdvertiseRegion.Area), @((int)ViewBag.region_filter_status))'>
            @if (ViewBag.province > 0)
            {
                <option value="-1">شهر را انتخاب کنید </option>
                foreach (var item in ViewBag.cities)
                {
                    <option is-disabled="@(item.Id == ViewBag.city)" value="@item.Id">@item.PersianName</option>
                }
            }
            else
            {
                <option value="-1">ابتدا استان را انتخاب کنید</option>
            }
        </select>
    </div>

    <div class="@filterItemClass">
        <p class="@filterLabelClass">منطقه </p>
        <select is-disabled="@(!selectEnabled)" class="js-area-select changed-input-target js-region-select-input" name="@ViewBag.areaName" pid="@(ViewBag.guid + "-" + (int)Region.AdvertiseRegion.Area)" onchange="if (typeof onChangeRegion !== undefined) { onChangeRegion(); }">
            @if (ViewBag.city > 0)
            {
                if (ViewBag.areas.Count > 0)
                {
                    <option value="-1">منطقه را انتخاب کنید </option>
                    foreach (var item in ViewBag.areas)
                    {
                        <option is-disabled="@(item.Id == ViewBag.area)" value="@item.Id">@item.PersianName</option>
                    }
                }
                else
                {
                    <option value="-1">این شهر منطقه ندارد.</option>
                }
            }
            else
            {
                <option value="-1">ابتدا شهر را انتخاب کنید</option>
            }
        </select>
    </div>
</div>

<script type="text/javascript">
    if (typeof regionFillChildList == 'undefined') {
        regionFillChildList = {};
    }

    function callRegionFillChild(guid, elem, cid, status) {
        regionFillChildList[guid](elem, cid, status)
    }

    regionFillChildList['@(ViewBag.guid)'] = function ($this, $childID, $status) {
        myajax("accomodation/getregionchildrenitems", "region_type=" + $childID + "&parent_id=" + $($this).val() + "&status=" + $status, function (ret) {
            if (ret.status == 1) {
                $("select[pid='" + "@(ViewBag.guid + "-")" + $childID + "']").html(ret.val);
                var city_region_type = 1;
                var area_region_type = 2;
                if ($childID == city_region_type) {
                    $("select[pid='" + "@(ViewBag.guid + "-")" + area_region_type + "']").html("<option value='-1'>ابتدا شهر را انتخاب کنید</option>");
                }
            }
        }, false);
        if (typeof onChangeRegion !== 'undefined') {
            onChangeRegion();
        }
    };
</script>