    @if (Session["impersonateAdmin"] != null)
    {
        @Html.Partial("_ImpersonateContainer", new ViewDataDictionary { {"hidden", false } })
    }
    <div id="loading-icon" class="loading-contianer" style="z-index:2147483647">
        <div class="ui active large loader loading-icon"></div>
    </div>
    <div class="page">
        <div class="header_container">
            <div class="header__container">
                <div class="hamberger" onclick="open_menu()">
                    <i class="open-menu-dashboard fa fa-bars"></i>
                    <span>حساب من</span>
                </div>

                <a href="/" class="header__logo"></a>
                <div class="header__extra">
                    @*<a href="@string.Format("/Ticket/Inbox?user_id={0}", User.GetUser().Id)" class="header__messages-button">
                            <i class="fa fa-envelope"></i>
                            <span>@(ViewBag.MessageCount == 0 ? "پیام ها" : ViewBag.MessageCount + " پیام جدید")</span>
                        </a>*@
                    <a href="/accomodation/accbasicform" class="header__add">
                        <i class="fa fa-plus"></i>
                        <span>افزودن آگهی</span>
                    </a>
                    <span class="header__user">
                        <i class="fa fa-user"></i>
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (string.IsNullOrEmpty(User.GetUser().FullName))
                            {
                                <span> کاربر @User.GetUser().Id</span>
                            }
                            else
                            {
                                <span> @User.GetUser().FullName </span>
                            }
                        }
                        else
                        {
                            <span> حساب کاربری </span>
                        }
                    </span>
                </div>
            </div>
        </div>
        <div class="body">
            <div class="menu menu--close">
                <div class="menu__top bg-yellow">
                    <i class="close-menu-dashboard fa fa-times-circle" onclick="close_menu()"></i>
                    <span class="menu__user">
                        @if (User.Identity.IsAuthenticated &&
                            User.GetUser().PhotoID > 0)
                        {
                            <img style="width: 66px;height: 66px;border-radius: 50px;margin-left: 5px;" src='@string.Format("/file/imgThumbOld?FileID={0}&w=200&h=200", User.GetUser().PhotoID)' />
                        }
                        else
                        {
                            <i class="fa fa-user-circle">
                            </i>
                        }

                        <span>
                            @if (User.Identity.IsAuthenticated)
                            {
                                if (string.IsNullOrEmpty(User.GetUser().FullName))
                                {
                                    @: کاربر @User.GetUser().Id
                                }
                                else
                                {
                                    @User.GetUser().FullName
                                }
                            }
                            else
                            {
                                @:حساب کاربری
                            }
                        </span>
                    </span>
                </div>
                <div class="menu__container">
                    <a href="/" class="menu__item">
                        <i class="fa fa-home"></i>
                        <span>صفحه اصلی سایت</span>
                    </a>

                    <a href="/dashboard" class="menu__item @(ViewBag.dashboard != null ? "menu__item--active" : "") ">
                        <i class="fa fa-tachometer-alt"></i>
                        <span>حساب کاربری</span>
                    </a>

                    @*<a href="@string.Format("/Ticket/Inbox?user_id={0}", User.GetUser().Id)" class="menu__item @(ViewBag.inbox != null ? "menu__item--active" : "") ">
                            <i class="fa fa-envelope"></i>
                            <span style="width:35%">پیام ها</span>
                            <span id="message-counter-label" style="@(ViewBag.MessageCount > 0 ? "" : "display: none")">@(ViewBag.MessageCount == 0 ? "" : ViewBag.MessageCount + " پیام جدید")</span>
                        </a>*@

                    <a href="/accomodation/accbasicform" class="menu__item @(ViewBag.advertise!=null ? "menu__item--active" : "") ">
                        <i class="fa fa-plus"></i>
                        <span>افزودن آگهی</span>
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@string.Format("/post/personal?userid={0}", User.GetUser().Id)" class="menu__item @(ViewBag.personal != null ? "menu__item--active" : "") ">
                            <i class="fa fa-th-list"></i>
                            <span>آگهی های من</span>
                        </a>
                        if (User.GetUser().UserGeneralType !=
                            (int)Amlakbashi.Core.Entities.User.UserGeneralTypeEnum.Guest)
                        {
                            <a href="/comment/advertisecommentmanager" class="menu__item @(ViewBag.advertise_comment != null ? "menu__item--active" : "") ">
                                <i class="fa fa-comments"></i>
                                <span>نظرات آگهی ها</span>
                                @*<span style="background-color:#4485F2;border-radius:10px;font:12px Liransans;margin-right:3px;padding:3px;text-align:center;color:white">جدید</span>*@
                                @Html.Action("GetNotSeenCommentCount","Comment")
                            </a>
                        }
                        if (User.GetUser().UserGeneralType == (int)Entities.User.UserGeneralTypeEnum.Guest)
                        {
                            <a href="@string.Format("/reserve/reserveitemmanager?user_id={0}&category=1&selectType=1", User.GetUser().Id)" class="menu__item @(ViewBag.reserveGuest != null ? "menu__item--active" : "") ">
                                <i class="fa fa-book"></i>
                                <span>رزرو ها</span>
                            </a>
                        }
                        else
                        {
                            <a href="@string.Format("/reserve/reserveitemmanager?user_id={0}&category=0&selectType=2", User.GetUser().Id)" class="menu__item @(ViewBag.reserveHost != null ? "menu__item--active" : "") ">
                                <i class="fa fa-book"></i>
                                <span> رزرو بعنوان میزبان  </span>
                            </a>
                            <a href="@string.Format("/reserve/reserveitemmanager?user_id={0}&category=1&selectType=1", User.GetUser().Id)" class="menu__item @(ViewBag.reserveGuest != null ? "menu__item--active" : "") ">
                                <i class="fa fa-book"></i>
                                <span> رزرو بعنوان مهمان</span>
                            </a>
                        }
                        if (User.GetUser().UserGeneralType > 0)
                        {
                            <a href="/reserve/invoice" class="menu__item @(ViewBag.Invoice != null ? "menu__item--active" : "") ">
                                <i class="fa fa-list"></i>
                                <span>صورت حساب رزرو ها</span>
                            </a>
                        }
                        <a href='@string.Format("/post/presentandprize?userid={0}", User.GetUser().Id)' class="menu__item @(ViewBag.presentandprize != null ? "menu__item--active " : "") ">
                            <i class="fa fa-gift"></i>
                            <span> هدیه سفر </span>
                        </a>
                        <a href='@string.Format("/post/profilemanager")' class='menu__item @(ViewBag.profile != null ? "menu__item--active " : "")'>
                            <i class="fa fa-user"></i>
                            <span> پروفایل من </span>
                        </a>

                        <a href="/user/usercreditmanager" class='menu__item @(ViewBag.UserCredit != null ? "menu__item--active " : "")'>
                            <i class="fa fa-money-bill-alt"></i>
                            <span> کیف پول </span>
                        </a>

                        @*<a href="/cart/cart" class="menu__item @(ViewBag.cart != null ? "menu__item--active" : "") ">
                            <i class="fa fa-shopping-cart"></i>
                            <span>سبد خرید</span>
                            </a>*@

                        <a href="@string.Format("/post/favoritemanager")" class="menu__item @(ViewBag.favorite != null ? "menu__item--active" : "") ">
                            <i class="fa fa-heart"></i>
                            <span>علاقه مندی های من</span>
                        </a>

                        <a href="/user/signout" class="menu__item">
                            <i class="fa fa-sign-out-alt"></i>
                            <span>خروج از حساب کاربری</span>
                        </a>
                    }
                    else
                    {
                        <a href="/user/Mobilelogin" class="menu__item">
                            <i class="fa fa-sign-in-alt"></i>
                            <span>ورود به حساب کاربری</span>
                        </a>
                    }
                </div>
            </div>
            <div class="main">
                <div class="main-top-space" style="height:10px; width:100% ;">
                    @*<a href="@string.Format("/Ticket/Inbox?user_id={0}", User.GetUser().Id)" class="main__messages-button">
                            <i class="fa fa-envelope"></i>
                            <span>@(ViewBag.MessageCount == 0 ? "پیام ها" : ViewBag.MessageCount + " پیام جدید")</span>
                        </a>*@
                </div>
                @RenderBody()
            </div>
        </div>
        <div class="footer">
        </div>
    </div>

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_msg))
    {
        <div class="alert-msg">
            <div class="alert__text black">
                @ViewBag.alert_msg
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_success))
    {
        <div class="alert-msg">
            <div class="alert__text" style="color:green;">
                @ViewBag.alert_success
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_error))
    {
        <div class="alert-msg">
            <div class="alert__text" style="color:red;">
                @ViewBag.alert_error
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }


