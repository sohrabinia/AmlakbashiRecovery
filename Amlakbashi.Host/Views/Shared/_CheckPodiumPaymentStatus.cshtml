@model Amlakbashi.Core.DTOs.PaymentDTOs.BankingDTOs.CheckShebaPaymentResultDTO

<style>
    .pay-btn {
        cursor: pointer;
        padding: 10px;
        border-radius: 5px;
        font: 1em miransans;
    }
</style>

@if (Model == null)
{
    <div>
        <span>عملیات با خطا مواجه شد (خطای داخلی)</span>
    </div>
}
else if (Model.HasError)
{
    <div>
        @if (Model.ErrorCode > 0)
        {
            <p>کد خطا: @Model.ErrorCode</p>
        }
        <p>@Model.ErrorMessage</p>
    </div>
}
else
{
    <div>
        <span>شماره پیگیری:</span>
        <span>@Model.RefrenceNumber</span>
    </div>
    <div>
        <span>وضعیت:</span>
        <span>@Model.Status</span>
    </div>
    <div>
        <span>تاریخ:</span>
        <span>@Model.TransactionDate</span>
    </div>
    <div>
        <span>زمان:</span>
        <span>@Model.TransactionTime</span>
    </div>
    <div>
        <span>مبلغ:</span>
        <span>@Model.Amount</span>
    </div>
    <br />
    @if (Model.PaymentStatus == Payment.PaymentStatus.NotPaid)
    {
        <div style="text-align: center;">
            <p style="color: red;">پرداخت مورد نظر توسط بانک تایید شده، اما در املاک باشی ثبت نشده است!</p>
            <button class="pay-btn" onclick="RegisterNotPaidPayment()" type="button">ثبت پرداخت</button>
        </div>
    }
}

<script>
    function RegisterNotPaidPayment() {
        $.ajax({
            type: "POST",
            url: "/payment/RegisterNotPaidPayment",
            data: {
                paymentId: @Model.PaymentId
            },
            success: function (response) {
                if (response.status == 0) {
                    alertify.error("پرداخت ثبت نشد");
                }
                else {
                    alertify.success("پرداخت با موفقیت ثبت شد");
                    popupMsgList[0].btnClick(0, true);
                }
            }
        });
    }
</script>