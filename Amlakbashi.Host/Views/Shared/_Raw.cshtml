<!DOCTYPE html>
<html class="theme3">
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <link rel="icon" type="image/png" href="https://www.amlakbashi.com/favicon.png" />
    <link rel='index' title='@System.Configuration.ConfigurationManager.AppSettings["sitetitle"]' href='@string.Format("http://{0}", Request.Url.Authority)' />
    <meta name="viewport" content="width=device-width, minimum-scale=0.25, maximum-scale=1.0, initial-scale=1.0" />
    <meta name="coverage" content="Worldwide" />
    <meta name="robots" content="index,follow,all" />
    <meta name="googlebot" content="index,follow" />
    <meta name="revisit-after" content="1 days" />
    <meta name="alexaVerifyID" content="jz4RhWgXn7cMuI-LPQu9Xi3BmX4" />
    <meta name="msvalidate.01" content="0035A31DCA7DA125B1F904CB5DE15660" />
    @if (ViewBag.keywords != null)
    {
        <meta name="keywords" content="@ViewBag.keywords" />
    }
    else
    {
        <meta name="keywords" content="املاک باشی - سایت اجاره ویلا و اجاره روزانه سوئیت و آپارتمان مبله" />
    }
    @if (ViewBag.Description != null)
    {
        <meta name="description" content="@ViewBag.Description" />
    }
    else
    {
        <meta name="description" content="املاک باشی - سایت اجاره ویلا و اجاره روزانه سوئیت و آپارتمان مبله" />
    }
    <meta name="enamad" content="344312021" />
    @*****   style   ****@    
    <link rel="stylesheet" type="text/css" href="/resource/alertify.js-0.3.11/themes/alertify.default.css" />
    <link rel="stylesheet" type="text/css" href="/resource/alertify.js-0.3.11/themes/alertify.core.css" />
    <link rel="stylesheet" type="text/css" href="/resource/dashboard.css?v=3.9" />
    

    @RenderSection("StyleLink", required: false)
    @RenderSection("StyleBlock", required: false)
    @*****   end style   ****@


</head>
<body>
    <div class="page">
        <div class="header">
            <div class="header__container">
                <div class="hamberger" onclick="open_menu()">
                    <i class="open-menu-dashboard fa fa-bars"></i>
                    <span>منو</span>
                </div>
                
                <div class="header__logo"></div>
                <div class="header__extra">
                    <a href="/accomodation/addoreditaccomodation" class="header__add">
                        <i class="fa fa-plus"></i>
                        <span>افزودن آگهی</span>
                    </a>
                    <span class="header__user">
                        <i class="fa fa-user"></i>
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (string.IsNullOrEmpty(User.GetUser().FullName))
                            {
                                <span> کاربر @User.GetUser().Id</span>        
                            }
                            else
                            {
                                <span> @User.GetUser().FullName </span>
                            }
                        }
                        else
                        {
                            <span> حساب کاربری </span>
                        }
                    </span>
                </div>
            </div>
        </div>
        <div class="body">
                @RenderBody()
        </div>
    </div>

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_msg))
    {
        <div class="alert-msg">
            <div class="alert__text black">
                @ViewBag.alert_msg
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_success))
    {
        <div class="alert-msg">
            <div class="alert__text" style="color:green;">
                @ViewBag.alert_success
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }

    @if (!string.IsNullOrEmpty((string)ViewBag.alert_error))
    {
        <div class="alert-msg">
            <div class="alert__text" style="color:red;">
                @ViewBag.alert_error
            </div>
            <button onclick="close_alert()" class="alert__btn">بستن</button>
        </div>
    }

    <div class="bg-loader load-hide">
        <img src="~/Resource/img/new-loader.gif" />
    </div>

    @*****   script   ****@
    <script src="/resource/scripts/jquery-2.1.1.min.js"></script>
    <script src="/resource/alertify.js-0.3.11/src/alertify.js"></script>   

    @RenderSection("ScriptLink", required: false)
    <script type="text/javascript">

        function open_menu() {
            $(".menu").removeClass("menu--close");
            $(".open-menu-dashboard").hide();
            $(".close-menu-dashboard").show();
        }

        function close_menu() {
            $(".menu").addClass("menu--close");
            $(".open-menu-dashboard").show();
            $(".close-menu-dashboard").hide();
        }

        function AdvanceSearch() {
            $("#AdvanceSearchForm").submit();
        }

        function AdvanceSearchMobile($this) {
            if ($($this).val() == "amlak") {
                window.location.href = "/املاک/مستقلات";
            } else if ($($this).val() == "daily") {
                window.location.href = "/اجاره-روزانه/اجاره-ویلا-سوئیت-آپارتمان";
            }
        }

        
    </script>

    <script type="text/javascript">
        $('body').prepend('<a href="#" class="back-to-top"></a>');
        var amountScrolled = 300;

        $(window).scroll(function () {
            if ($(window).scrollTop() > amountScrolled) {
                $('a.back-to-top').fadeIn('slow');
            } else {
                $('a.back-to-top').fadeOut('slow');
            }
        });
        $('a.back-to-top').click(function () {
            $('html, body').animate({
                scrollTop: 0
            }, 700);
            return false;
        });

        function close_alert() {
            $(".alert-msg").hide();
        }

    </script>

    @RenderSection("ScriptBlock", required: false)
    @*****   end script   ****@
    
</body>
</html>
