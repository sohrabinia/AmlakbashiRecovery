@{
    var photo_id = long.Parse(ViewData["photoId"].ToString());
    var img_small = photo_id > 0 ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", photo_id, 213, 120) : string.Format("/عکس-یافت-نشد-{0}-{1}", 213, 120);
    var img_medium = photo_id > 0 ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", photo_id, 249, 140) : string.Format("/عکس-یافت-نشد-{0}-{1}", 249, 140);
    var img_large = photo_id > 0 ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", photo_id, 331, 186) : string.Format("/عکس-یافت-نشد-{0}-{1}", 331, 186);

    var lazy = "/file/resourceimagepng?file_name=lazy/lazy-16_9_700w";
    var lazy_small = "/file/resourceimagepng?file_name=lazy/lazy-16_9_213w";
    var lazy_medium = "/file/resourceimagepng?file_name=lazy/lazy-16_9_249w";
    var lazy_large = "/file/resourceimagepng?file_name=lazy/lazy-16_9_331w";
}
<a class="home-page_box-blog" target="_blank" href="@ViewData["href"]">
    @*<div class="blog-news__item">*@
        <img class="lazy"
             srcset="@lazy_small 285w,
                @lazy_medium 300w,
                @lazy_large 331w"
             data-srcset="@img_small 285w,
                @img_medium 300w,
                @img_large 331w"
             sizes="(max-width: 1100px) 285px,
                331px"
             src="@lazy"
             data-src="@img_small" alt="@ViewData["title"]" title="@ViewData["title"]">
            <p class="blog-news__item-content">@ViewData["title"]</p>
    @*</div>*@
</a>
