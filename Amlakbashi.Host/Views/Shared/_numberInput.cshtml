<div class="set_off-button div-unset style-min-max-input">
    <label> @ViewData["Name"] :</label>
    <button type="button" class="add"><i class="fa fa-plus"></i></button>
    <input type="text" placeholder="@ViewData["placeholder"]" class="@ViewData["class"]" id="@ViewData["id"]" value="@ViewData["inputValue"]" onclick="@ViewData["onclick"]" />
    <span class="label-text-style">@ViewData["text"]</span>
    <button type="button" class="sub"><i class="fa fa-minus"></i></button>
</div>
