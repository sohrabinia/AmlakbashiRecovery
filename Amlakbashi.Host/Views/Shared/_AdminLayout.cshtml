        <a href="/" title="صفحه اصلی">
            <img class="header-logo-style" src="/image/logo/amlakbashi-logo-900w.png" alt="logo">
        </a>
        <div class="profile-style hide-mobile-profile">
            @if (userAccessor.CurrentUser.PhotoID > 0)
            {
                <img class="avatar" src="@($"/file/imgThumbOld?FileID={userAccessor.CurrentUser.PhotoID}&w=200&h=200")">
            }
            else
            {
