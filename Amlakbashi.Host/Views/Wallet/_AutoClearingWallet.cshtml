
@if (ViewBag.error != null && ViewBag.error == true)
{
    <div>
        <span>@ViewBag.errorMsg</span>
    </div>
}
else
{
    <div>
        <span>نام صاحب حساب:</span>
        <span>@ViewBag.bankCardName</span>
    </div>
    <div>
        <span>شماره شبای مقصد:</span>
        <span>IR@(ViewBag.shebaNumber)</span>
    </div>
    <div>
        <span>مبلغ پرداخت:</span>
        <span>@ViewBag.price ریال</span>
    </div>
    <div>
        <label>ارسال پیامک به کاربر</label>
        <input type="checkbox" id="SendSmsCheckbox" name="sendSms" value="true" checked="checked" />
    </div>
    <div style="text-align: center;">
        <button id="auto_payment_btn" type="button" style="cursor: pointer; padding: 10px; border-radius: 5px; font: 1em miransans;" onclick="DoAutoClearingWalletPayment()">پرداخت</button>
    </div>
    <div style="text-align: center;">
        <span id="PaymentResultWaitingSpan" style="visibility:hidden; color: darkorange;">لطفا منتظر بمانید ...</span>
    </div>
}

<script>
    function DoAutoClearingWalletPayment() {
        var sendSms = $("#SendSmsCheckbox").prop('checked');
        $.ajax({
            url: "/wallet/AutoClearingWallet",
            type: "post",
            data: {
                userId: '@ViewBag.userId',
                sendSms: sendSms
            },
            beforeSend: function () {
                $('#PaymentResultWaitingSpan').css("visibility", "visible");
                $('#auto_payment_btn').prop('disabled', true);
            },
            success: function (response) {
                $('#PaymentResultWaitingSpan').css("visibility", "hidden");
                $('#auto_payment_btn').prop('disabled', true);
                if (response.status == 0) {
                    showInfoMessage('پرداخت ناموفق', '<p style="color: red;">' + response.msg + '</p>');
                }
                else {
                    showInfoMessage('پرداخت موفق', '<p style="color: blue;">' + response.msg + '</p>');
                    popupMsgList[1].btnClick(0, true);
                    popupMsgList[0].btnClick(0, true);
                }
            },
            error: function (ret) {
                $('#PaymentResultWaitingSpan').css("visibility", "hidden");
                alertify.error("عملیات با خطا مواجه شد");
            }
        });
    }
</script>