@{
    ViewBag.Title = "مدیریت فایل ها";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}
@model IEnumerable<Amlakbashi.Core.Entities.File>
@*<a href="/File/Edit" class="add">افزودن فایل</a>*@
<table>
    <tr>
        <th class="minw">
            ردیف
        </th>
        <th>
            شناسه
        </th>
        <th>
            عکس
        </th>
        <th>
            آدرس
        </th>
        <th>
            عملیات
        </th>
    </tr>
    @{
        int Idx = (int)ViewBag.RowIndexStart;
    }
    @foreach (var item in Model)
    {
        Idx++;

        <tr>
            <td>
                @Idx
            </td>
            <td>
                @item.Id
            </td>
            <td>
                <img src='@string.Format("/file/imgThumbOld?FileID={0}&w=100&h=40",item.Id)' />
            </td>
            <td>
                <span>
                    @(item.CorrectedFilePath)
                </span>
            </td>
            <td>
                <a href="@Url.Action("Edit", new { fileId = item.Id })" target="_blank"><span class="editicon" title="ویرایش"></span></a>
                <span class="deleteicon" onclick="deleteItem(@item.Id,this)" title="حذف"></span>
            </td>
        </tr>
    }

</table>

<div class="mypagelist">
    @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", "File", new { page }), new PagedListRenderOptions { LinkToFirstPageFormat = "ابتدا", LinkToPreviousPageFormat = "قبلی", LinkToNextPageFormat = "بعدی", LinkToLastPageFormat = "انتها", MaximumPageNumbersToDisplay = 5, DelimiterBetweenPageNumbers = "|" })
</div>

@section ScriptBlock
{
    <script type="text/javascript">
        function deleteItem($id, obj) {
            if (confirm("آیا از حذف این آیتم اطمینان دارید ؟")) {
                myajax("File/Delete", "id=" + $id, function (ret) {
                    if (ret.status == 1) {
                        $(obj).parent().parent().remove();
                    }
                });
            }
        }
    </script>
}