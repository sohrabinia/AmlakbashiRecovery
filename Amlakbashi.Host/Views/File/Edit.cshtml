@model int

@{
    ViewBag.Title = "مدیریت فایل";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}

<div class="title">ویرایش  فایل</div>

@using (Html.BeginForm("Edit", "File", FormMethod.Post, new { enctype = "multipart/form-data", id = "ManageForm" }))
{
    <input type="hidden" name="fileId" value="@Model" />
    <table>
        <tr>
            <td class="label">شناسه فایل:</td>
            <td>@Model</td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                فایل قدیم :
            </td>
            <td style="width:300px;">
                <img src='@string.Format("/file/imgThumbOld?FileID={0}&w=200&h=150", Model)' />
            </td>
            <td></td>
        </tr>
        <tr>
            <td class="label">
                فایل جدید :
            </td>
            <td style="width:300px;">
                <input type="file" name="image" />
            </td>
            <td></td>
        </tr>
    </table>

    <div style="margin-top:20px;">
        <input class="apply" type="submit" value="ثبت" />
        <a class="cancel" href='@Url.Action("Index")'>انصراف</a>
    </div>
}

<div class="adminmsg">@ViewBag.msg</div>