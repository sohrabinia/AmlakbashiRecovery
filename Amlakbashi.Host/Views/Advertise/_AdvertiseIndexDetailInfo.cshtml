@model Amlakbashi.Core.DTOs.AdvertiseDTOs.AdvertiseIndexDetailDTO

@if (Model == null)
{
    <p>داده ای پیدا نشد</p>
}
else
{
    <div class="box-more-options js-more-option">
        <div class="more-option-row">
            <span><b>تاریخ ثبت:</b> @Model.CreateDate |</span>
            <span><b>قیمت:</b> @Model.DailyPrice |</span>
            <span><b>امتیاز اقامتگاه:</b> @Model.AdvertiseScore |</span>
            <span><b>بازدید:</b> @Model.WebVisit |</span>
            <span><b>شروع رزرو نوروزی:</b> @Model.NorouzMinReserveDate</span>
        </div>

        <div class="more-option-row mobile">
            <span><b>اطلاعات کاربر:</b></span>
            @if (Model.UserId > 0)
            {
                <a href='/user/index?code=@Model.UserId'>@Model.UserFullName |</a>
                <span>کد کاربر: @Model.UserId</span>
            }
            else
            {
                @: بدون کاربر
            }
        </div>

        <div class="more-option-row tablet">
            <span><b>توضیحات:</b></span>
            <i onclick="showAddInfoDialog(@Model.Id)" class="fa fa-plus" style="color:#242424;cursor:pointer;" title="افزودن توضیحات"></i>
            <i onclick="showInfo(@Model.Id)" class="fa fa-eye" style="color:#242424;cursor:pointer;" title="نمایش توضیحات"></i>
            <span class="js-info-count">(@Model.SupportInfoCount توضیح)</span>
        </div>

        <!-- دکمه های عملیاتی -->
        <div class="more-option-row function-buttons">
            @if (Model.Mode == Advertise.AdvertiseMode.Single)
            {
                <a href="/accomodation/adminbasicform?id=@Model.Id" class="fa fa-user-plus" title="کارشناسی آگهی" target="_blank"></a>
                <a href="/advertise/edit?id=@Model.Id" class="fa fa-edit" target="_blank" title="ویرایش"></a>
                @if (Model.Status == Advertise.AdvertiseStatus.FirstReady ||
                    Model.Status == Advertise.AdvertiseStatus.ReadyToPublish ||
                    Model.Status == Advertise.AdvertiseStatus.NotVerified ||
                    Model.Status == Advertise.AdvertiseStatus.Deleted)
                {
                    <i class="fa fa-check-circle" onclick="PublishAdvertise(@Model.Id,this)" title="انتشار"></i>
                }
                @if (Model.Status == Advertise.AdvertiseStatus.Published ||
                    Model.Status == Advertise.AdvertiseStatus.Archived)
                {
                    <i class="fas fa-calendar-alt" onclick="showOccupiedCalendarPopup(@Model.Id)" title="تقویم"></i>
                    <i class="fa fa-bolt" onclick="showInstantReservePopup(@Model.Id)" title="رزرو آنی"></i>
                    <i class="fas fa-dollar-sign" onclick="showPricePopup(@Model.Id)" title="قیمت"></i>
                    <i class="fas fa-percent" onclick="showDiscountPopup(@Model.Id)" title="تخفیف"></i>
                    @if (Model.VideoStatus != Advertise.VideoStatusEnum.Unset)
                    {
                        <i class="fas fa-video" onclick="showVideoPopup(@Model.Id)" title="ویدیو" style="color: @(Model.VideoStatus == Advertise.VideoStatusEnum.NotConfirmed ? "red" : (Model.VideoStatus == Advertise.VideoStatusEnum.Confirmed ? "limegreen" : "#fdd835"));"></i>
                    }
                    <i class="fa fa-power-off" onclick="ToggleActivity(@Model.Id,this)" data-value="@(Model.Status == Advertise.AdvertiseStatus.Archived ? "false" : "true")" title="فعال/غیرفعال" style="color: @(Model.Status == Advertise.AdvertiseStatus.Archived ? "red" : "limegreen");"></i>
                }
                @if (Model.Status != Advertise.AdvertiseStatus.NotVerified
                    && Model.Status != Advertise.AdvertiseStatus.NotCompleted)
                {
                    <i class="fa fa-times" onclick="NotVerifyAdvertise(@Model.Id,this)" title="عدم تایید"></i>
                }
                <i class="fa fa-trash" onclick="deleteAdvertise(@Model.Id)" title="حذف آگهی"></i>
            }
            else if (Model.Mode == Advertise.AdvertiseMode.Parent)
            {
                <a href="/accomodation/adminbasicform?id=@Model.Id" class="fa fa-user-plus" title="کارشناسی آگهی" target="_blank"></a>
                <a href="/advertise/edit?id=@Model.Id" class="fa fa-edit" target="_blank" title="ویرایش"></a>
                @if (Model.MainType == Advertise.MainTypeEnum.Hotel && Model.VideoStatus != Advertise.VideoStatusEnum.Unset)
                {
                    <i class="fas fa-video" onclick="showVideoPopup(@Model.Id)" title="ویدیو"  style="color: @(Model.VideoStatus == Advertise.VideoStatusEnum.NotConfirmed ? "red" : (Model.VideoStatus == Advertise.VideoStatusEnum.Confirmed ? "limegreen" : "#fdd835"));"></i>
                }
                @if (Model.Status == Advertise.AdvertiseStatus.FirstReady ||
                    Model.Status == Advertise.AdvertiseStatus.ReadyToPublish ||
                    Model.Status == Advertise.AdvertiseStatus.NotVerified ||
                    Model.Status == Advertise.AdvertiseStatus.Deleted)
                {
                    <i class="fa fa-check-circle" onclick="PublishAdvertise(@Model.Id,this)" title="انتشار"></i>
                }
                @if (Model.Status == Advertise.AdvertiseStatus.Published ||
                   Model.Status == Advertise.AdvertiseStatus.Archived)
                {
                    <i class="fa fa-power-off" onclick="ToggleActivity(@Model.Id,this)" data-value="@(Model.Status == Advertise.AdvertiseStatus.Archived ? "0" : "1")" title="فعال/غیرفعال" style="color: @(Model.Status == Advertise.AdvertiseStatus.Archived ? "red" : "limegreen");"></i>
                }
                @if (Model.Status != Advertise.AdvertiseStatus.NotVerified
                   && Model.Status != Advertise.AdvertiseStatus.NotCompleted)
                {
                    <i class="fa fa-times" onclick="NotVerifyAdvertise(@Model.Id,this)" title="عدم تایید"></i>
                }
                <i class="fa fa-trash" onclick="deleteAdvertise(@Model.Id)" title="حذف آگهی"></i>
            }
            else
            {
                @if (Model.Status == Advertise.AdvertiseStatus.Published ||
                    Model.Status == Advertise.AdvertiseStatus.Archived)
                {
                    <i class="fas fa-calendar-alt" onclick="showOccupiedCalendarPopup(@Model.Id)" title="تقویم"></i>
                    <i class="fa fa-bolt" onclick="showInstantReservePopup(@Model.Id)" title="رزرو آنی"></i>
                    <i class="fas fa-dollar-sign" onclick="showPricePopup(@Model.Id)" title="قیمت"></i>
                    <i class="fas fa-percent" onclick="showDiscountPopup(@Model.Id)" title="تخفیف"></i>
                    @if (Model.MainType == Advertise.MainTypeEnum.Complex && Model.VideoStatus != Advertise.VideoStatusEnum.Unset)
                    {
                        <i class="fas fa-video" onclick="showVideoPopup(@Model.Id)" title="ویدیو" style="color: @(Model.VideoStatus == Advertise.VideoStatusEnum.NotConfirmed ? "red" : (Model.VideoStatus == Advertise.VideoStatusEnum.Confirmed ? "limegreen" : "#fdd835"));"></i>
                    }
                    <i class="fa fa-power-off" onclick="ToggleAvailable(@Model.Id,this)" data-value="@(Model.Available ? "true" : "false")" title="فعال/غیرفعال" style="color: @(Model.Available ? "limegreen" : "red");"></i>
                }
            }
        </div>
    </div>
}