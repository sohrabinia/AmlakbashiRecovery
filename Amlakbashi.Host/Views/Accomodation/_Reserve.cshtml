@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.ReservePopupDTO

<div class="advertise-page__reserve-container">
	<div class="advertise-page__reserve-header" style="@(ViewBag.forceHeaderShown != null && ViewBag.forceHeaderShown ? "display:flex" : "")">
        <div class="advertise-page__reserve-header-text">ارتباط مستقیم با میزبان</div>
        <div onclick="hideReserveContainer()" class="advertise-page__reserve-close-btn">
            <i class="fa fa-times"></i>
        </div>
    </div>
    <p class="advertise-page__tip-parent" style="border:none;font: 13px Miransans;color:#15803d;font-weight:bold;text-align:center;padding:10px 0;">
        <i class="fa fa-phone-alt" style="margin-left:5px;"></i>زنگ بزن و بگو شماره رو از املاک باشی برداشتم!
    </p>

    <div class="item-content__reserve-bottom" style="margin-top:10px;">
        <div class="item-content__reserve-btn" id="contact-button" onclick="show_contact(this, advertise_id)">
            <p id="contact-btn-text" style="margin: 0;"><i class="fa fa-phone" style="margin-left:8px;"></i>نمایش شماره تماس میزبان</p>
        </div>
    </div>
</div>
