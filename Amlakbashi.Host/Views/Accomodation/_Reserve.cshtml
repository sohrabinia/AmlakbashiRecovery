@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.ReservePopupDTO

<div class="advertise-page__reserve-container">
	<div class="advertise-page__reserve-header" style="@(ViewBag.forceHeaderShown != null && ViewBag.forceHeaderShown ? "display:flex" : "")">
        <div class="advertise-page__reserve-header-text">ارتباط با میزبان</div>
        <div onclick="hideReserveContainer()" class="advertise-page__reserve-close-btn">
            <i class="fa fa-times"></i>
        </div>
    </div>
    <div class="advertise-page__contact-direct-box" style="padding: 20px 16px; text-align: center;">
        <div class="advertise-page__contact-cta-button" onclick="show_contact(this, @Model.AdvertiseId)" style="background-color: #0F5132; color: white; padding: 14px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 16px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
            <i class="fa fa-phone"></i>
            <span>نمایش شماره تماس میزبان</span>
        </div>
        <p style="margin-top: 12px; font-size: 13px; color: #4b5563; line-height: 1.6;">زنگ بزن و بگو شماره رو از املاک باشی برداشتم!</p>
    </div>
    @{
        int discount = Model.DiscountData.Percent;
        string date_string = Model.DiscountData.DateString;
        if (discount > 0)
        {
            <div class="advertise-page__tip-parent" style="margin-top: 0;">
                <div class="advertise-page__discount-label advertise-page__reserve-tip">
                    <p><i class="fa fa-percent" style="font-size:12px;margin-left: 8px;color:#ea4335"></i>@(discount) درصد تخفیف از @date_string</p>
                </div>
            </div>
        }
    }
</div>
