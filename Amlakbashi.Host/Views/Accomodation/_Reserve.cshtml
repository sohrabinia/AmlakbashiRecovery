@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.ReservePopupDTO

<div class="advertise-page__reserve-container">
	<div class="advertise-page__reserve-header" style="@(ViewBag.forceHeaderShown != null && ViewBag.forceHeaderShown ? "display:flex" : "")">
        <div class="advertise-page__reserve-header-text">رزرو</div>
        <div onclick="hideReserveContainer()" class="advertise-page__reserve-close-btn">
            <i class="fa fa-times"></i>
        </div>
    </div>
    <div class="advertise-page__contact-direct-box" style="padding: 16px; text-align: center;">
        <div class="advertise-page__contact-cta-button" onclick="show_contact(this, @Model.AdvertiseId)" style="background-color: #0F5132; color: white; padding: 14px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 16px;">
            <i class="fa fa-phone"></i>
            <span>نمایش شماره تماس میزبان</span>
        </div>
        <p style="margin-top: 10px; font-size: 13px; color: #6b7280;">زنگ بزن و بگو شماره رو از املاک باشی برداشتم!</p>
    </div>
    <div class="advertise-page__tip-parent">
        <div id="js-instant-reserve-info" style="display:none" @*style="display:none;width:80%;margin:0 auto;margin-bottom:10px;border-radius:5px;border: 1px solid #242424; padding:5px;flex-flow:row;align-items:center;justify-content:space-around"*@>
            <div class="advertise-page__reserve-tip" style="display:flex;align-items:center;">
                <i style="color:#DF7549" class="fas fa-bolt"></i>
                <div style="display:flex;flex-flow:column;width:100%;">
                    <span @*style="color:#34A853;"*@>رزرو آنی (بدون نیاز به تایید میزبان)</span>
                    @*<span style="padding-top:2px;">حداکثر شروع سفر: <span id="js-mxrsrvstart-label"></span></span>*@
                </div>
            </div>
        </div>
        <div class="advertise-page__reserve-tip" style="display:none;" id="js-normal-reserve-info">
            @*<div class="advertise-page__reserve-tip-label">نمایش شماره تماس میزبان رایگان میباشد</div>*@
                <p><i class="fa fa-info-circle" style="color:#242424;"></i>امکان بازدید برای اقامت های طولانی مدت</p>
        </div>
        @{
            int discount = Model.DiscountData.Percent;
            string date_string = Model.DiscountData.DateString;
            if (discount > 0)
            {
                <div class="advertise-page__discount-label advertise-page__reserve-tip">
                    <p><i class="fa fa-percent" style="font-size:12px;margin-left: 8px;color:#ea4335"></i>@(discount) درصد تخفیف از @date_string</p>
                </div>
            }
        }
    </div>
    @await Html.PartialAsync("_DatePicker", null, new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) { { "id", "main-date-picker" }, { "class", "main-date-picker" } })
    <div class="item-content__reserve-bottom">
        <div class="item-content__reserve-btn" id="reserve-request-button" onclick="show_contact(this, @Model.AdvertiseId)">

            <p class="js-reserve-req-title"><i class="js-reserve-req-icon fa fa-calendar-check"></i>نمایش شماره تماس میزبان</p>
        </div>
        @if (ViewBag.forceHeaderShown == null || !ViewBag.forceHeaderShown)
        {
            <div class="advertise-page__reserve-free-ribbon advertise-page__reserve-free-ribon-desktop">رایگان</div>
        }
    </div>
</div>