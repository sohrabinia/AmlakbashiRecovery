@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.ReservePopupDTO

<div class="advertise-page__reserve-container" style="padding: 15px; background: #ffffff; border-radius: 8px; border: 1px solid #10b981; text-align: center;">
    <div class="advertise-page__reserve-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
        <div class="advertise-page__reserve-header-text" style="font-size: 16px; font-weight: bold; color: #0F5132;">تماس با میزبان</div>
        <div onclick="hideReserveContainer()" class="advertise-page__reserve-close-btn" style="cursor: pointer;">
            <i class="fa fa-times"></i>
        </div>
    </div>

    <div class="item-content__contact-box" style="margin-bottom: 15px;">
        <div id="host-phone-number-container" style="display: none; background: #eef9f1; padding: 12px; border-radius: 6px; border: 1px dashed #10b981; margin-bottom: 12px;">
            <p style="font-size: 13px; color: #047857; margin-bottom: 6px; font-weight: bold;">زنگ بزن و بگو شماره رو از املاک باشی برداشتم!</p>
            <span id="host-phone-text" style="font-size: 20px; font-weight: bold; color: #065f46; letter-spacing: 1px;">09123******</span>
        </div>
    </div>

    <div class="item-content__reserve-bottom">
        <div class="item-content__reserve-btn" id="contact-host-button" onclick="show_contact(this)" style="background: #10b981; color: white; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-size: 16px; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px;">
            <i class="fa fa-phone-alt"></i>
            <p id="contact-btn-text" style="margin: 0;">نمایش شماره تماس میزبان</p>
        </div>
    </div>
</div>
