
@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.AmenitiesDTO

@if (Model.Bathroom)
{
    <div class="advertise-page__amenities-detail-item">
        <div style="display: flex; flex-flow: column-reverse; align-items: center">
            <div>
                <span>حمام</span>
                <i class="fa fa-check" style="color: #34A853;font-size:18px;"></i>
            </div>
            <i class="fa fa-bath"></i>
        </div>
    </div>
}
