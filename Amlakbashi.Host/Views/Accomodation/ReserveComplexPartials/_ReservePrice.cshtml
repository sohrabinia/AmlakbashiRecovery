
@model Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs.PriceDTO

@if (ViewBag.DailyPrice != 0)
{
    <div class="advertie-page__price-item">
        <span class="advertise-page__price-title">
            قیمت روزهای عادی:
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.DailyPrice) تومان
        </span>
    </div>
}
@if (Model.HolidayPrice != 0)
{
    <div class="advertie-page__price-item">
        <span class="advertise-page__price-title">
            قیمت روزهای تعطیل:
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.HolidayPrice) تومان
        </span>
    </div>
}
@if (Model.HolidayPikePrice != 0)
{
    <div class="advertie-page__price-item">
        <span class="advertise-page__price-title">
            قیمت پیک تعطیلات
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.HolidayPikePrice) تومان
        </span>
    </div>
}
@if (Model.RentPrice != 0)
{
    <div class="advertie-page__price-item">
        <span class="advertise-page__price-title">
            اجاره ماهیانه:
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.RentPrice) تومان
        </span>
    </div>
}
@if (Model.MoreThanCapacityPrice != 0)
{
    <div class="advertie-page__price-item">
        <span class="advertise-page__price-title">
            هزینه هر مهمان بیشتر:
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.MoreThanCapacityPrice) تومان
        </span>
    </div>
}
@if (Model.NorouzPrice > 0)
{
    <div class="advertie-page__price-item js-NorouzPrice">
        <p class="advertise-page__price-title">
            <img width="16" height="16" rel="ویژه نوروز" alt="ویژه نوروز" title="ویژه نوروز" src="/file/resourceimagepng?file_name=norouz_icon_16x16" /> قیمت روزهای نوروز:
        </p>
        <p class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.NorouzPrice) تومان
        </p>
    </div>
}
@if (Model.NorouzOverCapacityPrice > 0)
{
    <div class="advertie-page__price-item js-NorouzOverCapacityPrice">
        <span class="advertise-page__price-title">
            <img width="16" height="16" rel="ویژه نوروز" alt="ویژه نوروز" title="ویژه نوروز" src="/file/resourceimagepng?file_name=norouz_icon_16x16" /> قیمت هر مهمان اضافه نوروز:
        </span>
        <span class="advertise-page__price-content">
            @string.Format("{0:n0}", Model.NorouzOverCapacityPrice) تومان
        </span>
    </div>
}