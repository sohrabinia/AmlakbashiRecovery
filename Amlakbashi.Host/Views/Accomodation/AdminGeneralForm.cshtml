@model Amlakbashi.Core.DTOs.AccommodationDTOs.GeneralFormDTO

@{
    ViewBag.AddEditAccPage = true;
    ViewBag.Title = "کارشناسی اقامتگاه";
    ViewBag.keywords = "ثبت رزرو, ثبت رایگاه آگهی, ثبت آپارتمان مبله, ثبت سوئیت, ثبت ویلا اجاره ای, ثبت آگهی رزرو";
    ViewBag.Description = "ثبت رایگان اقامتگاه برای اجاره روزانه و هفتگی - ثبت آگهی آپارتمان و سوئیت مبله - ثبت اجاره ویلا - ثبت آگهی هتل و مسافرخانه";
    Layout = "~/Views/Shared/_masterAdmin.cshtml";
}

@section StyleLink {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.6.0/dist/leaflet.css"
          integrity="sha512-xwE/Az9zrjBIphAcBb3F6JVqxf46+CDLwfLMHloNu6KEQCAWi6HcDUbeOfBIptF7tcCzusKFjFw2yuvEpDL9wQ=="
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.6.0/dist/leaflet.js"
            integrity="sha512-gZwIG9x3wUXg2hdXF6+rVkLF/0Vi9U8D2Ntg4Ga5I5BZpVkVxlJWbSQtXPSiUTtC0TjtGOmxa1AJPuV0CPthew=="
            crossorigin=""></script>
    <link rel="stylesheet" href="~/Resource/css/dashboard/acc-public-style-form.css" />
    <link rel="stylesheet" href="~/Resource/css/dashboard/acc-general-form.css" />
    <link rel="stylesheet" href="~/Resource/css/dashboard/admin-public-style.css" />
    <link rel="stylesheet" href="~/Resource/css/dashboard/admin-general-form.css" />
}

<div class="add-advertise-static-container">
    <div class="add-static-title">
        کارشناسی اقامتگاه
    </div>
    <div class="box-step-by-step">
        <div id="form-step-button-container" class="form-step-button-container">
            <div onclick="checkHaveChangeAdmin(1, @Model.Id)" class="form-step-button">اطلاعات اولیه</div>
            <div class="form-step-button form-step-button-selected">مشخصات کلی</div>
            <div onclick="checkHaveChangeAdmin(3, @Model.Id)" class="form-step-button">مشخصات تکمیلی</div>
            @if (Model.advertiseMode == Advertise.AdvertiseMode.Parent)
            {
                if (ViewBag.type == Advertise.AdvertiseType.Complex ||
                    ViewBag.type == Advertise.AdvertiseType.HotelApartment)
                {
                    <div onclick="checkHaveChangeAdmin(4, @Model.Id, 0)" class="form-step-button">مدیریت واحد ها</div>
                }
                else
                {
                    <div onclick="checkHaveChangeAdmin(4, @Model.Id, 1)" class="form-step-button">مدیریت اتاق ها</div>
                }
            }
            <div onclick="checkHaveChangeAdmin(5, @Model.Id)" class="form-step-button">وضعیت کارشناسی</div>
        </div>
    </div>
    @using (Html.BeginForm("admingeneralform", "accomodation", new { Id = Model.Id }, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "AccForm" }))
    {
        <input type="hidden" value="false" name="forceSave" id="forceSaveInput">
        <input type="hidden" value="@(ViewBag.tab == null ? 0 : ViewBag.tab)" name="tab" id="tabInput" />
        <div class="form-step" id="_AccFormGeneralElements" data-title="مشخصات کلی" style="display: block;">
            @if (Model.address != null)
            {
                <div class="static-advertise advetise-form__part">
                    <p class="static-advertise__title"><i class="fa fa-map-marker"></i>اطلاعات آدرس اقامتگاه را وارد کنید </p>
                    @await Html.PartialAsync("~/Views/Accomodation/AddEditFormInputs/_AccAddressInput.cshtml", Model.address)
                </div>
            }
            @if (Model.floor != null)
            {
                <div class="static-advertise__item-floor">
                    @await Html.PartialAsync("~/Views/Accomodation/AddEditFormInputs/_AccFloorInput.cshtml", Model.floor)
                </div>
            }
            @if (Model.photo != null)
            {
                <div class="static-advertise__item-gallery">
                    @await Html.PartialAsync("~/Views/Accomodation/AddEditFormInputs/_AdminPhotoInput.cshtml", Model.photo)
                </div>
            }
            @if (Model.titleAndDesc != null)
            {
                <div class="static-advertise advetise-form__part">
                    <p class="static-advertise__title"> <i class="fa fa-file-alt"></i>معرفی اقامتگاه به مهمان ها </p>
                    @await Html.PartialAsync("~/Views/Accomodation/AddEditFormInputs/_AccTitleDescInput.cshtml", Model.titleAndDesc)
                </div>
            }
            @if (Model.metaTitleAndDesc != null)
            {
                <div class="static-advertise advetise-form__part">
                    <p class="static-advertise__title"> <i class="fa fa-file-alt"></i>معرفی اقامتگاه به موتورهای جستجو </p>
                    @await Html.PartialAsync("~/Views/Accomodation/AddEditFormInputs/_AccMetaTitleDescInput.cshtml", Model.metaTitleAndDesc)
                </div>
            }
        </div>
        <div class="static-advertise__btns-box">
            <p class="static-advertise__btn-item" id="prev_step_button" onclick="checkHaveChangeAdmin(1, @Model.Id)"><i class="fa fa-chevron-right"></i> مرحله قبل</p>
            <p class="static-advertise__btn-item form-submit_button" id="next_step_button" style="width: 100px; background-color: #73C362;">تایید <i class="fa fa-chevron-left"></i></p>
        </div>
    }
</div>
@section ScriptLink{
    <script src="~/Resource/Scripts/dashboard/acc-public-form.js"></script>
}
@section ScriptBlock
{
    <script type="text/javascript">
        @if (ViewBag.errors != null)
        {
            @:var errorText = "بعضی از اطلاعات وارد شده نادرست است.";
            if (ViewBag.hasImportantError != null && ViewBag.hasImportantError)
            {
                @:errorText = errorText + " استان و شهر باید انتخاب شده باشند."
            }
            @:showNoYesMessage("", errorText, undefined, forceSaveFormSubmit, { noText: 'ذخیره تغییرات', yesText: 'اصلاح' });
            foreach(var error in ViewBag.errors)
            {
                @:alertify.error('@error');
            }
        }
    </script>
}
