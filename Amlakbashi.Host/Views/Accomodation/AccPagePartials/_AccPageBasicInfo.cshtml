@using Amlakbashi.Core.DTOs.AccommodationDTOs.AccPagesDTOs;

@model AccommodationItemDTO

@{
    var capacityString = string.Empty;
    if (Model.AdvertiseMode != Advertise.AdvertiseMode.Parent)
    {
        capacityString = Model.Capacity.ExtraCapacity > 0 ?
            Model.Capacity.Capacity + " نفر مجاز + " + Model.Capacity.ExtraCapacity + " نفر اضافه" :
            Model.Capacity.Capacity + " مهمان";
    }
}

<div class="advertise-page__basic-properties-container">
    @if (!string.IsNullOrEmpty(capacityString))
    {
        <p class="advertise-page__basic-property-item"><i class="fa fa-users"></i>@capacityString</p>
    }
    @if (Model.Room.RoomCount != 0)
    {
        <p class="advertise-page__basic-property-item"><i class="fa fa-columns"></i>@Model.Room.RoomCount اتاق</p>
    }
    @if (Model.BuildingSize.BuildingArea != 0)
    {
        <p class="advertise-page__basic-property-item"><i class="fa fa-building"></i>بنا : @Model.BuildingSize.BuildingArea متر</p>
    }
    @if (Model.LandArea.LandArea != 0)
    {
        <p class="advertise-page__basic-property-item">
            <i class="fa fa-chart-area"></i>زمین: @Model.LandArea.LandArea متر
        </p>
    }
    @if (Model.Parking.Parking != Advertise.ParkingItems.Unset)
    {
        <p class="advertise-page__basic-property-item">
            @switch ((Advertise.ParkingItems)Model.Parking.Parking)
            {
                case Advertise.ParkingItems.One:
                    <i class="fas fa-parking"></i>@("1 پارکینگ")
                    break;
                case Advertise.ParkingItems.Two:
                    <i class="fas fa-parking"></i>@("2 پارکینگ")
                    break;
                case Advertise.ParkingItems.Three:
                    <i class="fas fa-parking"></i>@("3 پارکینگ")
                    break;
                case Advertise.ParkingItems.MoreThanThree:
                    <i class="fas fa-parking"></i>@("بیشتر از 3 پارکینگ")
                    break;
                @*case Advertise.ParkingItems.Jointly:
                    <i class="fa fa-warehouse"></i>@("پارکینگ مشاع")
                    break;*@
                case Advertise.ParkingItems.NoParking:
                    <i class="fas fa-parking"></i>@("بدون پارکینگ")
                    break;
                default:
                    break;
            }
        </p>
    }
    @if (Model.Bed.SingleBedCount != 0)
    {
        <p class="advertise-page__basic-property-item"><i class="fa fa-bed"></i>@Model.Bed.SingleBedCount تخت یک نفره</p>
    }
    @if (Model.Bed.DoubleBedCount != 0)
    {
        <div class="advertise-page__basic-property-item">
            <img width="24" height="24" src="/file/resourceimagepng?file_name=icons/double-bed" alt="تخت دونفره" />@Model.Bed.DoubleBedCount تخت دو نفره
        </div>
    }
    @if (Model.Floor.Floor != Advertise.FloorItems.Unset)
    {
        <p class="advertise-page__basic-property-item">
            @switch (Model.Floor.Floor)
            {
                case Advertise.FloorItems.Underground:
                    <i class="fa fa-building"></i>@("طبقه: زیرزمین")
                    break;
                case Advertise.FloorItems.Ground:
                    <i class="fa fa-building"></i>@("طبقه: همکف")
                    break;
                case Advertise.FloorItems.MoreThan10th:
                    <i class="fa fa-building"></i>@("طبقه: بالاتر از 10")
                    break;
                default:
                    <i class="fa fa-building"></i>@("طبقه:") @((int)Model.Floor.Floor)
                    break;
            }
        </p>
    }
    @if ((Model.AdvertiseType.TypeID == Advertise.AdvertiseType.Villa ||
      Model.AdvertiseType.TypeID == Advertise.AdvertiseType.House)
      && Model.AdvertiseType.VillaType != Advertise.VillaTypeEnum.Unset)
    {
        var villaTypeStr = Model.AdvertiseType.VillaType == Advertise.VillaTypeEnum.Exclusive ? "ویلا دربست" : "ویلا مشترک";
        <p class="advertise-page__basic-property-item"><i class="fas fa-warehouse"></i>@villaTypeStr</p>
    }
</div>