        function addInfo(reserve_id, text, notShowMessage) {
            if (notShowMessage === true) {
                executeAddInfo(reserve_id, text, true);
            }
            else {
                showNoYesMessage('افزودن توضیحات',
                'متن توضیحات: "' + text + '" اضافه شود؟',
