@using PagedList;
@using PagedList.Mvc;
@{
    ViewBag.Title = "مدیریت رزرو ها";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}
@model IEnumerable<Reserve>

@helper IsSelected(bool flg)
{
    if (flg)
    {
        @: selected="selected"
    }
    else
    {
        @:
    }
}
@section ScriptLink
{
    <!--Reference the SignalR library. -->
    <script type="text/javascript" src="/file/getjs?src=/scripts/jquery.signalR-2.4.1.min.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>
}
@section StyleLink
{
    <link rel="stylesheet" type="text/css" href="/file/getcss?src=/resource/star-rating/star-rating.css&v=2">
}
@{
    var data = ViewBag.reserveAdmin;
}
@using (Html.BeginForm("Index", "Reserve", FormMethod.Get, new { id = "filter_form" }))
{
    <input type="hidden" id="main_filter_input" name="mainFilter" value="@(ViewBag.mainFilter)" />
    <input type="hidden" id="show_my_reserves_input" name="reserve_support_status" value="@(ViewBag.reserve_support_status)" />
    <input type="hidden" id="should_follow_input" name="shouldFollow" value="@(ViewBag.shouldFollow.ToString().ToLower())" />
    <input type="hidden" id="instantReserveFilter" name="instantReserveFilter" value="@(ViewBag.instantReserveFilter)" />
    <input type="hidden" id="disableAutoCancelFilter" name="disableAutoCancel" value="@(ViewBag.disableAutoCancel.ToString().ToLower())" />
    <input type="hidden" id="accVisitedFilter" name="accVisited" value="@(ViewBag.accVisited.ToString().ToLower())" />
    <div style="overflow: auto">
        <table>
            <tr>
                <td class="label"> کد رزرو :</td>
                <td class="minw">
                    <input type="text" style="width:150px;" value="@ViewBag.reserve_id" name="reserve_id" />
                </td>
                <td class="label"> کد آگهی :</td>
                <td class="minw">
                    <input type="text" style="width:150px;" value="@ViewBag.advertise_id" name="advertise_id" />
                </td>
            </tr>
            <tr>
                <td class="label"> کد کاربرِی میزبان :</td>
                <td class="minw">
                    <input type="text" style="width:150px;" value="@ViewBag.host_user_id" name="host_user_id" />
                </td>
                <td class="label"> کد کاربرِی مهمان :</td>
                <td class="minw">
                    <input type="text" style="width:150px;" value="@ViewBag.guest_user_id" name="guest_user_id" />
                </td>
            </tr>
            <tr>
                <td class="label"> وضعیت سفر :</td>
                <td class="minw">
                    <select name="reserve_status" id="reserve_status_input">
                        <option value="-1"> همه رزرو ها</option>
                        @{
                            var status_values = (Reserve.ReserveStatus[])Enum.GetValues(typeof(Reserve.ReserveStatus));
                            foreach (var value in status_values)
                            {
                                if (value != Reserve.ReserveStatus.Deleted && value != Reserve.ReserveStatus.Default)
                                {
                                    <option value="@((int)value)" @IsSelected((int)ViewBag.reserve_status == (int)value)>@ReserveLocalization.GetStatusString((int)value, Reserve.StatusStringType.Site)</option>
                                }
                            }
                        }
                    </select>
                </td>
                <td class="label">پاسخ میزبان :</td>
                <td class="minw">
                    <select name="host_response_status">
                        <option value="-1"> همه رزرو ها</option>
                        @{
                            var host_response_values = (Reserve.HostResponseEnum[])Enum.GetValues(typeof(Reserve.HostResponseEnum));
                            foreach (var value in host_response_values)
                            {
                                <option value="@((int)value)" @IsSelected((int)ViewBag.host_response_status == (int)value)>@ReserveLocalization.GetHostResponseString((int)value)</option>
                            }
                        }
                    </select>
                </td>
            </tr>
            <tr>
                <td class="label"> وضعیت :</td>
                <td class="minw">
                    <select name="general_status" id="general_status_input">
                        <option value="-1"> همه رزرو ها</option>
                        <option value="0" @IsSelected(ViewBag.general_status == 0)>پرداخت شده ها</option>
                    </select>
                </td>
                <td class="label"> وضعیت تسویه سایت :</td>
                <td class="minw">
                    <select name="site_cleared_status" id="cleared_status_input">
                        <option value="-1"> همه رزرو ها</option>
                        <option value="0" @IsSelected(ViewBag.site_cleared_status == 0)>تسویه شده</option>
                        <option value="1" @IsSelected(ViewBag.site_cleared_status == 1)>تسویه نشده</option>
                        <option value="2" @IsSelected(ViewBag.site_cleared_status == 2)>عودت داده شده</option>
                        <option value="3" @IsSelected(ViewBag.site_cleared_status == 3)>در انتظار عودت</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="label"> زمان سفر از :</td>
                <td class="minw">
                    <input name="reserve_from_date" class="js-filter-date-picker" type="text" id="reserve_from_date_picker" value="@(ViewBag.reserve_from_date)" />
                </td>
                <td class="label"> زمان سفر تا :</td>
                <td class="minw">
                    <input name="reserve_to_date" class="js-filter-date-picker" type="text" id="reserve_to_date_picker" value="@(ViewBag.reserve_to_date)" />
                </td>
            </tr>
            <tr>
                <td class="label"> تاریخ پایان سفر :</td>
                <td class="minw">
                    <input name="reserve_end_date" class="js-filter-date-picker" type="text" id="reserve_end_date_picker" value="@(ViewBag.reserve_end_date)" />
                </td>
                <td class="label"> پشتیبان :</td>
                <td class="minw">
                    <select name="supporter_id">
                        <option value="-1">همه</option>
                        @if (User.GetUser().Id == 3 || User.GetUser().Id == 12 ||
                    User.GetUser().Id == 1667 || User.GetUser().Id == 2122)
                        {
                            foreach (var supp in ViewBag.supporterList)
                            {
                                <option @IsSelected(ViewBag.supporter_id == supp.id) value="@(supp.id)">@(supp.fullName)</option>
                            }
                        }
                        else
                        {
                            <option @IsSelected(ViewBag.supporter_id == User.GetUser().Id) value="@(User.GetUser().Id)">@(User.GetUser().FullName)</option>
                        }
                    </select>
                </td>
            </tr>
            <tr>
                <td class="label"> زمان تسویه سایت :</td>
                <td class="minw">
                    <input name="site_clearing_date" class="js-filter-date-picker" type="text" id="clearing_date_picker" value="@(ViewBag.site_clearing_date)" />
                </td>
                <td class="label">مدت سفر :</td>
                <td class="minw">
                    <input type="text" style="width:70px;" value="@ViewBag.stay_duration_from" name="stay_duration_from" />
                    <span> تا </span>
                    <input type="text" style="width:70px;" value="@ViewBag.stay_duration_to" name="stay_duration_to" />
                    <span> روز</span>
                </td>
            </tr>
            <tr>
                <td class="label"> حساب بانکی میزبان :</td>
                <td>
                    <select name="host_card_status">
                        <option value="-1">همه</option>
                        <option value="0" @IsSelected(ViewBag.host_card_status == 0)>دارای شماره شبا</option>
                        <option value="1" @IsSelected(ViewBag.host_card_status == 1)>فقط شماره کارت</option>
                        <option value="2" @IsSelected(ViewBag.host_card_status == 2)>بدون حساب</option>
                    </select>
                </td>
                <td><input type="submit" class="filter" value="فیلتر" /></td>
                <td style="width:100%;"></td>
            </tr>
            <tr></tr>
        </table>
    </div>
    <div style="display:flex;max-width:1000px;flex-flow:row;margin:10px;justify-content:space-between;padding: 10px;">
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_status == 1 ? "#fdd835" : "#ccc");" onclick="toggleStatus(1)"><i style="font-size: 18px;" class="fa fa-book"></i><span>در انتظار پاسخ </span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_status == 2 ? "#fdd835" : "#ccc");" onclick="toggleStatus(2)"><i style="font-size: 18px;" class="fa fa-book"></i><span>در انتظار پرداخت </span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_end_date == Amlakbashi.Core.Common.Utilities.DateTimeUtility.PersianTodayString && ViewBag.general_status == 0 ? "#fdd835" : "#ccc");" onclick="toggleTodayFinishStay()"><i style="font-size: 18px;" class="fa fa-flag-checkered"></i><span>پایان سفر امروز </span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.site_cleared_status == 1 && ViewBag.site_clearing_date == Amlakbashi.Core.Common.Utilities.DateTimeUtility.PersianTodayString ? "#fdd835" : "#ccc");" onclick="toggleSiteTodayClearing()"><i style="font-size: 18px;" class="fa fa-money-bill-alt"></i><span>تسویه امروز </span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.shouldFollow ? "#fdd835" : "#ccc");" onclick="toggleShouldFollowReserves()"><i style="font-size: 18px;" class="fa fa-bullseye"></i><span>در حال پیگیری </span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.disableAutoCancel ? "#fdd835" : "#ccc");" onclick="toggleDisableAutoCancelFilter()"><img src="/file/resourceimagepng?file_name=no-gear" width="18" height="18" /><span>عدم لغو خودکار</span></div>
        <div style="display:flex;flex-flow:row;justify-content:space-around;align-items:center;width:120px;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.accVisited ? "#fdd835" : "#ccc");" onclick="toggleAccVisitFilter()"><img src="/file/resourceimagepng?file_name=acc-visit" width="18" height="18" /><span>بازدید اقامتگاه</span></div>
    </div>
    <div style="display:flex;flex-flow:row;flex-wrap: wrap; max-width:100%;justify-content:space-between;">
        <div style="display:flex;width:500px;flex-flow:row;margin:10px;justify-content:space-between;border:1px solid #ccc;padding: 10px;">
            <div onclick="toggleMyReserves(0)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_support_status == 0 ? "#fdd835" : "#ffffff")">همه</div>
            <div onclick="toggleMyReserves(@((int)ReserveSupport.SupporterStatus.Free))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_support_status == (int)ReserveSupport.SupporterStatus.Free ? "#fdd835" : "#ffffff")">بدون پشتیبان</div>
            <div onclick="toggleMyReserves(@((int)ReserveSupport.SupporterStatus.SupportingByYou))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_support_status == (int)ReserveSupport.SupporterStatus.SupportingByYou ? "#fdd835" : "#ffffff")">در حال پشتیبانی من</div>
            <div onclick="toggleMyReserves(@((int)ReserveSupport.SupporterStatus.SupportingByOthers))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_support_status == (int)ReserveSupport.SupporterStatus.SupportingByOthers ? "#fdd835" : "#ffffff")">در حال پشتیبانی همکاران</div>
            <div onclick="toggleMyReserves(@((int)ReserveSupport.SupporterStatus.Done))" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.reserve_support_status == (int)ReserveSupport.SupporterStatus.Done ? "#fdd835" : "#ffffff")">انجام شده</div>
        </div>
        <div style="display:flex;width:200px;margin:10px;flex-flow:row;margin:10px;justify-content:space-between;border:1px solid #ccc;padding: 10px;">
            <div onclick="toggleInstantResFilter(2)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.instantReserveFilter == 2 ? "#fdd835" : "#ffffff")">همه</div>
            <div onclick="toggleInstantResFilter(0)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.instantReserveFilter == 0 ? "#fdd835" : "#ffffff")">رزرو عادی</div>
            <div onclick="toggleInstantResFilter(1)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.instantReserveFilter == 1 ? "#fdd835" : "#ffffff")">رزرو آنی</div>
        </div>
    </div>
    <div style="display:flex;max-width:200px;flex-flow:row;margin:10px;justify-content:space-between;border:1px solid #ccc;padding: 10px;">
        <div onclick="toggleMainFilter(0)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.mainFilter == 0 ? "#fdd835" : "#ffffff")">رزرو های فعال</div>
        <div onclick="toggleMainFilter(1)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.mainFilter == 1 ? "#fdd835" : "#ffffff")">همه</div>
        <div onclick="toggleMainFilter(2)" style="border:1px solid #242424;cursor:pointer;border-radius: 5px;padding: 5px;background-color:@(ViewBag.mainFilter == 2 ? "#fdd835" : "#ffffff")">بایگانی</div>
    </div>
    <div style="overflow: auto">
        <table class="adminTable">
            <tr>
                <th class="minw">
                    ردیف
                </th>
                <th>
                    کد رزرو
                </th>
                <th>
                    اطلاعات سفر
                </th>
                <th>
                    جزئیات سفر
                </th>
                <th>
                    پرداخت ها
                </th>
                <th>
                    وضعیت
                </th>
                <th>
                    پاسخ میزبان
                </th>
                <th>توضیحات پشیتبان</th>
                <th>وضعیت پشتیبانی</th>
                @*<th>تماس مهمان با میزبان</th>
                    <th>تماس میزبان با مهمان</th>*@
                <th>
                    عملیات
                </th>
            </tr>
            @{
                int Idx = (int)ViewBag.RowIndexStart;
            }
            @foreach (var item in data.reserveList)
            {
                Idx++;
        <tr id="js-@item.id">
            <td>
                @Idx
            </td>
            <td>
                <div>@item.id</div>
                <div><i style="font-size:16px;cursor:pointer;" class="fas fa-copy" onclick="copyStringToClipboard('@(item.id)', 'کد رزرو @(item.id)')"></i></div>
            </td>
            <td>
                <div>زمان درخواست: @(item.createDateString)</div>
                <div>کد آگهی: <a href="/Advertise/Index?status=-1&id=@(item.parentAccomodationId > 0 ? item.parentAccomodationId : item.accommodationId)">@item.accommodationId @(item.parentAccomodationId > 0 ? " >> " + item.parentAccomodationId : "")</a><i style="margin: 0 10px;font-size:16px;cursor:pointer;" class="fas fa-copy" onclick="copyStringToClipboard('@(item.accommodationId)', 'کد آگهی @(item.accommodationId)')"></i></div>
                <div>کد میزبان: <a href="/User/Index?code=@item.hostUserId">@item.hostUserId</a><i style="margin: 0 10px;font-size:16px;cursor:pointer;" class="fas fa-copy" onclick="copyStringToClipboard('@(item.hostUserId)', 'کد میزبان @(item.hostUserId)')"></i><i style="cursor:pointer;margin: 0 5px 0 0" class="fa fa-phone" onclick="showCallPopup(@(item.hostUserId),@(item.id),'میزبان')"></i></div>
                <div>کد مهمان: <a href="/User/Index?code=@item.guestUserId">@item.guestUserId</a><i style="margin: 0 10px;font-size:16px;cursor:pointer;" class="fas fa-copy" onclick="copyStringToClipboard('@(item.guestUserId)', 'کد مهمان @(item.guestUserId)')"></i><i style="cursor:pointer;margin: 0 5px 0 0" class="fa fa-phone" onclick="showCallPopup(@(item.guestUserId),@(item.id),'مهمان')"></i></div>
            </td>
            <td>
                <span>از @item.startDateString تا @item.endDateString</span><br />
                <span>@item.guestCount نفر به مدت @item.stayDays شب</span><br />
                <span style="color:@(item.totalPaidPrice > 0 ? "#34A853" : "#242424")">مبلغ: @string.Format("{0:n0}", item.totalPrice) ت</span><br />
                @if (item.depositePrice != item.totalPrice)
                {
                    <span style="color:@(item.depositePaidPrice > 0 || item.totalPaidPrice > 0 ? "#34A853" : "#242424")">بیعانه: @string.Format("{0:n0}", item.depositePrice) ت</span>
                }
            </td>
            <td>
                @if (item.instantReserve && item.payments == null)
                {
                    <span>مهمان پرداخت نکرده</span>
                }
                else
                {
                    if ((item.payments == null || item.payments.Count == 0) && item.paymentTryCount < 1)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        <a style="text-decoration:none;color:#242424;" target="_blank" href="~/reservepayment/index?reserve_id=@(item.id)">
                            @if (item.paymentTryCount > 0)
                            {
                                <span style="color:#EA4335">@item.paymentTryCount تلاش برای پرداخت</span><br />
                                <span style="color:#EA4335">@item.lastPaymentTryDate</span><br />
                            }
                            @foreach (var paymentItem in item.payments)
                            {
                                <span style="color:#34A853">@(paymentItem.title): @string.Format("{0:n0}", paymentItem.amount) ت</span><br />
                                <span>@paymentItem.dateString</span><br />
                            }
                            @if (item.couponPrice > 0)
                            {
                                <span style="color:#4285F4">بن تخفیف: @string.Format("{0:n0}", item.couponPrice) ت</span><br />
                            }
                            @if (item.prizePrice > 0)
                            {
                                <span style="color:#4285F4">کیف هدیه: @string.Format("{0:n0}", item.prizePrice) ت</span><br />
                            }
                        </a>
                    }
                }
            </td>
            <td class="reserve-status-label" style="color:@item.statusColor; max-width: 70px;">
                <div style="display:flex;flex-flow:column">
                    <div>@item.statusString</div>
                    @if (item.status == (int)Reserve.ReserveStatus.Completed)
                    {
                        <div style="color:#242424">
                            @if (item.guestScore > 0)
                            {
                                @Html.Partial("_StarRating", new ViewDataDictionary {
                                    { "score", item.guestScore },
                                    { "onclick", "showRatingDetail(" + item.accommodationId + "," + item.guestUserId +")" },
                                    { "fontSize", 11 },
                                    { "iconSize", 11 },
                                    { "labelWidth", 13 }
                                })
                            }
                            else
                            {
                                <div>بدون امتیازدهی</div>
                            }
                            @if (!string.IsNullOrEmpty(item.guestComment))
                            {
                                <div onclick="showComment('@(Uri.EscapeUriString(item.guestComment))')" style="cursor:pointer;background-color:#fdd835;border-radius:5px; padding:5px;">مشاهده نظر</div>
                            }
                            else
                            {
                                <div>بدون نظر</div>
                            }
                            <div onclick="editRating(@item.id)" style="cursor:pointer;margin-top:5px;background-color:#fdd835;border-radius:5px; padding:5px;">ویرایش نظر</div>
                        </div>
                    }
                </div>

            </td>
            <td style="max-width: 70px;">
                @if (item.instantReserve)
                {
                    <div style="display:flex;flex-flow:row;padding:10px;justify-content:space-between;">
                        <i style="font-size:20px;color:#DF7549" class="fas fa-bolt"></i>
                        <span style="color:#DF7549;">رزرو آنی</span>
                    </div>
                }
                else
                {
                    <span style="color:@item.hostResponseColor">@item.hostResponseString</span>
                    if ((Reserve.HostResponseEnum)item.hostResponse != Reserve.HostResponseEnum.None)
                    {
                        <br />
                        <span>@(item.hostResponseDateString))</span><br />
                        <span>@(item.hostResponseTimeString)</span>
                    }
                }
            </td>
            <td style="width: 100px">
                <div class="call_state_h" js-call-state="@(item.hostCallState)" style="cursor:pointer;font:10px Miransans;color:@(item.hostCallStateColor);" onclick="nextCallState(@(item.id), 'h', 'میزبان', this)">✆ثبت تماس میزبان</div>
                <div class="call_state_g" js-call-state="@(item.guestCallState)" style="cursor:pointer;font:10px Miransans;color:@(item.guestCallStateColor);" onclick="nextCallState(@(item.id), 'g', 'مهمان', this)">✆ثبت تماس مهمان</div>
                <i onclick="showAddInfoDialog(@(item.id))" class="fa fa-plus" style="color:#242424;cursor:pointer;" title="افزودن توضیحات"></i>
                <i onclick="showInfo(@(item.id))" class="fa fa-eye" style="color:#242424;cursor:pointer;" title="نمایش توضیحات"></i>
                <span class="js-info-count">(@(item.supportInfoCount) توضیح)</span>
            </td>
            <td class="support_state_td">
                @{
                    if (item.canGrantSupport)
                    {
                        <div style="cursor:pointer;border-radius: 5px;padding: 5px;background-color:#fdd835;" onclick="doSupport(@(item.id),this)">انجام پشتیبانی</div>
                    }
                    <div class="support_state" style="color:@(item.supportStateColor)">@(item.supportStateString)</div>
                    foreach (var rs in item.supporters)
                    {
                        <div style="display:flex;flex-flow:row; justify-content: center; align-items:center;">
                            @if (rs.imageId > 0)
                            {
                                <img style="border-radius: 90px" width="20" height="20" src="@string.Format("/file/imgThumb?FileID={0}&w=200&h=200", rs.imageId)" />
                            }
                            else
                            {
                                <i class="fa fa-user-circle" style="font-size:20px"></i>
                            }
                            <div style="margin: 0 5px;color:@(rs.color);">@(rs.name)</div>
                            @if (!string.IsNullOrEmpty(rs.transferReason))
                            {
                                <i style="cursor:pointer;color:#EA4335;" class="fa fa-info-circle" onclick="showInfoPopup('دلیل انتقال پشتیبانی', '@(rs.transferReason)')"></i>
                            }
                        </div>
                    }
                }
            </td>
            @*<td style="text-overflow:clip;white-space:nowrap;">
            @{
