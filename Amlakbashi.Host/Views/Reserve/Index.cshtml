                                (parseInt(ret.payable_price.replaceAll(',', '')) >parseInt(ret.total_price.replaceAll(',', '')) ? "<span style='font-size:20px;color:red;'>مبلغ مغایرت دارد. مبلغ قابل پرداخت از کل مبلغ رزرو بیشتر است</span>" : "") +
                                '<br />' +
                                '<div style="display:flex;flex-flow:row;align-items:center;">' +
                                '<div> شماره کارت: </div>' +
                                '<div style="font-size:30px;color:' + (ret.bank_card_verified ? '#2200ff' : '#ff0000') + ';direction:ltr;text-align:right;">' + (isNaN(ret.bank_card_number) ? ret.bank_card_number : ret.bank_card_number.match(/\d{1,4}/g).toString().replaceAll(",", " ")) + '</div>' +
                                '<i class="fas fa-copy" style="cursor:pointer;margin:0 5px;" onclick="copyStringToClipboard(\'' + ret.bank_card_number +'\', \'شماره کارت\')" />' +
                                '</div>' +
                                '<div>' + 'نام صاحب کارت: ' + '<span style="font-size:21px;color:#2200ff;">' + ret.bank_card_name + '</span>' + '</div>' +
                                'نام میزبان: <span style="font-size:21px;color:#2200ff;">' + ret.host_name + '</span>' +
                                '<br />' +
                                //'شماره کارت: ' + ret.bank_card_number +
                                'شماره شبا: ' + '<span style="color:' + (ret.shaba_verified ? '#2200ff' : '#ff0000') + '">' + ret.shaba_number + '</span>' + '<i class="fas fa-copy" style="cursor:pointer;margin:0 5px;" onclick="copyStringToClipboard(\'' + ret.shaba_number +'\', \'شماره شبا\')" />' +
                                '<br />' +
                                'موجودی کیف پول: <span style="' + (ret.host_credit >= 0 ? (ret.host_credit == 0 ? 'color:#242424;' : 'color:#34A853;') : 'color:#EA4335;' ) +'">' + ret.host_credit + '</span>' +
                                '<br />' +
                                'کد رزرو: ' + $id + ' ' + '<i class="fas fa-copy" style="cursor:pointer;margin:0 5px;" onclick="copyStringToClipboard(\'' + 'کد رزرو: ' + $id +'\', \'کد رزرو\')" />' +
                                '',
                            type: 'blue',
                            smoothContent: true,
                            typeAnimated: true,
                            rtl: true,
                            columnClass: 'small',
                            animation: 'scale',
                            closeIcon: true,
                            buttons: {
                                بله: function () {
                                    siteClearingHost($id, true, user_id, transaction_id, ref_id, method_id, price, send_sms, obj);
                                },
