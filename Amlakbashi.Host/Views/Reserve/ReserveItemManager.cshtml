                    "تماس": function () {
                        contactUser(user_id, onClose, "", reserve_id, is_guest);
                    }
                },
            });
        }
        function contactUser(user_id, onClose, extra_msg, reserve_id, is_guest) {
            if (extra_msg !== ""){
                confirmAndContactUser(user_id, onClose, extra_msg, reserve_id, is_guest);
                return;
            }
            if (is_guest) {
                myajax('Reserve/SetGuestCallDate','reserve_id='+ reserve_id ,null,false);
            }
            else {
                myajax('Reserve/SetHostCallDate','reserve_id=' + reserve_id ,null,false);
            }
            showInfoMessage('  شماره تماس  ' ,'', {contentUrl:'/User/ContactUserPopup?user_id=' + user_id});
        }
        function showRules( adcertise_rules , id_reserve ){
