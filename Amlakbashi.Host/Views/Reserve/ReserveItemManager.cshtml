        var is_sending_chat = false;

        function sendMessage(reserve_id) {
            if (is_sending_chat) {
                return;
            }
            var text = chatInput.val();
            if (text == '')
                return;
            if (/[a-zA-Z]/.test(text))
            {
                alertify.error("لطفا فارسی تایپ کنید");
                chatInput.val("");
                chatInput.focus();
                return;
            }
            is_sending_chat = true;
            $.ajax({
                type: 'POST',
                url: '/chat/sendtext',
                data: {
                    'reserve_id': reserve_id,
                    'text': text
                },
                success: function (ret) {
                    is_sending_chat = false;
                    if (ret.status == 1) {
                        reserveDashboardHubConnection.invoke("reloadChat", reserve_id);
                        chatInput.val("");
                        chatInput.focus();
                        $(".reserve-main_chat-box").stop().animate({ scrollTop: $(".reserve-main_chat-box")[0].scrollHeight}, 1000);
                    }
                    else if (ret.status == 2) {
                        alertify.error("لطفا از ارسال شماره تلفن و یا آی دی و یا حروف انگلیسی خودداری کنید");
                        reserveDashboardHubConnection.invoke("reloadChat", reserve_id);
                        chatInput.val("");
                        chatInput.focus();
                    }
                    else {
                        showInfoMessage('خطا', 'متاسفانه ارسال پیام با خطا مواجه شد');
                    }
                }
            });
        }

        function sendCancelDiscussion(reserve_id) {
            if (is_sending_chat) {
                return;
            }
            var text = $("#cancel_discussion_input").val();
            if (text == '')
                return;
            if (/[a-zA-Z]/.test(text))
            {
                alertify.error("لطفا فارسی تایپ کنید");
                $("#cancel_discussion_input").val("");
                $("#cancel_discussion_input").focus();
                return;
            }
            is_sending_chat = true;
            myajax("CancelDiscussion/SendText","reserve_id=" + reserve_id + "&text=" + text,function (ret) {
                is_sending_chat = false;
                if (ret.status == 1) {
                    $("#cancel_discussion_input").val("");
                    $("#cancel_discussion_input").focus();
                    refreshCancelDiscussionBox(reserve_id);
                }
                else {
                    $.confirm({
                        title: 'خطا',
                        content: 'متاسفانه ارسال پیام با خطا مواجه شد',
                        type: 'red',
                        typeAnimated: true,
                        columnClass: 'large',
                        animation: 'scale',
                        closeIcon: true,
                        buttons: {
                            بستن: function () {
                            }
                        },
                    });
                }
            });
        }

        function confirmAndContactUser(user_id, onClose, extra_msg, reserve_id, is_guest)
        {
            $.confirm({
                title: '',
                content: extra_msg,
                type: 'blue',
                smoothContent: true,
                typeAnimated: true,
                columnClass: 'small',
                animation: 'scale',
                closeIcon: true,
