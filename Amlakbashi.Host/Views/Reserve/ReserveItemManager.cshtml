        function chat_box_inputkeyup() {
            if (event.keyCode === 13) {
                chatInput.get(0).click();
                var reserveId = parseInt(chatInput.attr('js-reserve-id'));
                sendMessage(reserveId)
            }
        }

        function cancel_discussion_inputkeyup() {
            if (event.keyCode === 13) {
                $("#cancel_discussion_button").get(0).onclick();
            }
