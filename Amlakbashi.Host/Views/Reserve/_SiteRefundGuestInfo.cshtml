@using Amlakbashi.Core.DTOs.ReserveDTOs

@model SitePaymentDTO

<style>
    #CanceledReserveClearingFrom div {
        margin-bottom: 5px;
    }
</style>

@if (Model == null)
{
    <p>عملیات با خطا مواجه شد</p>
}
else
{
    <div>
        <span>کد رزرو:</span>
        <span>@Model.ReserveId</span>
        <span><i class="fa fa-copy" style="cursor: pointer; color: #999;" onclick="copyStringToClipboard('کد رزرو: @Model.ReserveId', 'کد رزرو')" /></span>
    </div>
    <div>
        <span>وضعیت رزرو:</span>
        <span>@ReserveLocalization.GetStatusString((int)Model.ReserveStatus, Reserve.StatusStringType.Site)</span>
    </div>
    <div>
        <span>مبلغ کل:</span>
        <span>@string.Format("{0:n0}", Model.TotalPrice) تومان</span>
    </div>
    <div>
        <span>پرداختی توسط مهمان:</span>
        <span>@string.Format("{0:n0}", Model.GuestPayedPrice) تومان</span>
    </div>
    <br />
    <form id="CanceledReserveClearingFrom" style="text-align: center;">
        <input type="hidden" name="ReserveId" value="@Model.ReserveId" />
        <div>
            <label>سهم املاک باشی:</label>
            <input type="text" name="siteClearingAmount" value="@(Model.ReserveStatus == Reserve.ReserveStatus.CanceledByGuest ? Model.TotalPrice / 10 : "")" />
        </div>
        @if (Model.ReserveStatus == Reserve.ReserveStatus.CanceledByGuest)
        {
            <div>
                <label>مبلغ تسویه مهمان:</label>
                <input type="text" name="guestClearingAmount" value="@(Model.ReserveStatus == Reserve.ReserveStatus.CanceledByHost ? Model.GuestPayedPrice : "")" />
            </div>
            <div>
                <label>مبلغ تسویه میزبان:</label>
                <input type="text" name="hostClearingAmount" value="" />
            </div>
        }
    </form>
    <br />
    <div style="text-align:center;">
        <button class="btn-set-payment" style="cursor: pointer; padding: 10px; border-radius: 5px; font: 1em miransans;" onclick="CanceledReserveClearing()">تسویه</button>
    </div>
}

<script>
    function CanceledReserveClearing() {
        var form = $('#CanceledReserveClearingFrom');
        $.ajax({
            type: "post",
            url: "/reserve/CanceledReserveClearing",
            data: form.serialize(),
            success: function (response) {
                if (response.status == 0) {
                    alertify.error(response.msg);
                }
                else {
                    alertify.success(response.msg);
                    reserveAdminHubConnection.invoke('reserveRefunded', @Model.ReserveId);
                    if (typeof hidePopup === 'function') {
                        hidePopup();
                    }
                    else {
                        popupMsgList[0].btnClick(0, true);
                    }
                }
            }
        });
    }
</script>