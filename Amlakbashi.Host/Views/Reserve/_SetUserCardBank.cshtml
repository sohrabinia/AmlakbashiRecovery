
<style>
    #SetBankCardForm div {
        margin-bottom: 10px;
    }
</style>

<form id="SetBankCardForm">
    <input type="hidden" name="userId" value="@ViewBag.userId" />
    <div>
        <label>کد کاربر:</label>
        <span>@ViewBag.userId</span>
    </div>
    <div>
        <label>شماره کارت:</label>
        <input type="text" name="bankCardNumber" value="" />
    </div>
    <div>
        <label>نام صاحب کارت:</label>
        <input type="text" name="bankCardFname" />
    </div>
    <div>
        <label>نام خانوادگی صاحب کارت:</label>
        <input type="text" name="bankCardLname" />
    </div>
    <div style="text-align:center;">
        <button type="button" onclick="submitBankCardForm()" style="cursor: pointer; padding: 10px; border-radius: 5px; font: 1em miransans;">ثبت کارت</button>
    </div>
</form>

<script>
    function submitBankCardForm() {
        var form = $('#SetBankCardForm');
        $.ajax({
            type: "POST",
            url: "/reserve/SetUserBankCard",
            data: form.serialize(),
            success: function (response) {
                if (response.status == 0) {
                    alertify.error(response.msg);
                }
                else {
                    alertify.success(response.msg);
                    $(".btn-set-card-bank").hide();
                    $(".btn-set-payment").show();
                    $("#BankCardNumberSpan").html(response.bankCardNumber);
                    $("#BankCardNumberSpan").css("color", "blue");
                    $("#BankCardNameSpan").html(response.bankCardName);
                    popupMsgList[1].btnClick(0, true);
                }
            }
        });
    }
</script>