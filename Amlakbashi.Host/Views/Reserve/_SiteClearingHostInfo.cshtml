@using Amlakbashi.Core.DTOs.ReserveDTOs

@model SitePaymentDTO

<style>
    .site-clearing-btn {
        cursor: pointer;
        padding: 10px;
        border-radius: 5px;
        font: 1em miransans;
    }

    .bankcard-info-container {
        margin: 10px 50px;
        border: 1px solid lightgray;
        padding: 10px;
    }

    .copy-to-clipboard-btn {
        cursor: pointer;
        color: #999;
    }

    .row-margin {
        margin-right: 50px;
    }
</style>

@if (Model == null)
{
    <p>عملیات با خطا مواجه شد</p>
}
else
{
    <div>
        <span>کد رزرو:</span>
        <span>@Model.ReserveId</span>
        <span><i class="fa fa-copy copy-to-clipboard-btn" onclick="copyStringToClipboard('کد رزرو: @Model.ReserveId', 'کد رزرو')" /></span>
        <span class="row-margin">مدت اقامت:</span>
        <span>@Model.Days</span>
    </div>
    <div>
        <span>مبلغ کل:</span>
        <span>@string.Format("{0:n0}", Model.TotalPrice) تومان</span>
        <span class="row-margin">پرداختی مهمان:</span>
        <span>@string.Format("{0:n0}", Model.GuestPayedPrice) تومان</span>
    </div>
    <div>
        <span>سهم املاک باشی:</span>
        <span>@string.Format("{0:n0}", Model.SitePortion) تومان</span>
        @if (Model.ClearingDepositeAmount > 0)
        {
            <span class="row-margin">بیعانه تسویه شده:</span>
            <span>@string.Format("{0:n0}", Model.ClearingDepositeAmount) تومان</span>
        }
    </div>
    <div>
        <span>مبلغ قابل پرداخت:</span>
        <span style="color: blue; font-size: x-large;">@string.Format("{0:n0}", Model.PayablePrice) تومان</span>
        <span><i class="fa fa-copy copy-to-clipboard-btn" onclick="copyStringToClipboard('@Model.PayablePriceRaw', 'مبلغ قابل پرداخت')" /></span>
    </div>
    <br />
    <div>
        <span>نام میزبان:</span>
        <span>@Model.UserName</span>
        <span class="row-margin">موجودی کیف پول:</span>
        <span style="color: @(Model.UserCredit < 0 ? "red" : Model.UserCredit > 0 ? "limegreen" : "black");">@string.Format("{0:n0}", Model.UserCredit) تومان</span>
    </div>
    <div class="bankcard-info-container">
        <div>
            @{
                var bankCardNumberString = Model.BankCardNumber;
                if (Model.BankCardNumber != "")
                {
                    bankCardNumberString = String.Format("{0} {1} {2} {3}", Model.BankCardNumber.Substring(0, 4),
                        Model.BankCardNumber.Substring(4, 4), Model.BankCardNumber.Substring(8, 4), Model.BankCardNumber.Substring(12));
                }
            }
            <span>شماره کارت:</span>
            <span style="color: @(Model.BankCardVerified ? "blue" : "red"); font-size:x-large; direction: ltr; unicode-bidi: embed;">@bankCardNumberString</span>
            @if (string.IsNullOrEmpty(bankCardNumberString) == false)
            {
                <span><i class="fa fa-copy copy-to-clipboard-btn" onclick="copyStringToClipboard('@Model.BankCardNumber', 'شماره کارت')" /></span>
            }
        </div>
        <div>
            <span>نام صاحب کارت:</span>
            <span id="BankCardNameSpan">@Model.BankCardName</span>
        </div>
        <div>
            <span>شماره شبا:</span>
            <span id="ShebaNumberSpan" style="color: @(Model.ShebaVerified ? "blue" : "red");">@Model.ShebaNumber</span>
            @if (string.IsNullOrEmpty(Model.ShebaNumber) == false)
            {
                <span><i class="fa fa-copy" style="cursor: pointer; color: #999;" onclick="copyStringToClipboard('@Model.ShebaNumber', 'شماره شبا')" /></span>
                @if (Model.ShebaVerified == false || string.IsNullOrEmpty(Model.BankCardName))
                {
                    <span><i class="fa fa-sync copy-to-clipboard-btn" onclick="VerifySheba()" /></span>
                    <span style="visibility:hidden; color: darkorange; margin-left: 10px; font-size: small;" id="ShebaNumberWaitingSpan">لطفا صبر کنید</span>
                }
            }
        </div>
        <div style="text-align:center;">
            <button class="site-clearing-btn" style="font-size: 12px;" onclick="SetUserBankCard()">ویرایش کارت بانکی</button>
        </div>
    </div>
    <div>

    </div>
    <br />
    <div style="text-align:center;">
        <button class="site-clearing-btn" onclick="AutoSiteClearingHost()">پرداخت خودکار</button>
        <button class="site-clearing-btn" onclick="ManualSiteClearingHost()">پرداخت دستی</button>
    </div>
}

<script>
    var hasLoadPopup = typeof loadPopup === 'function';
    function ManualSiteClearingHost() {
        var queryString = "reserveId=" + @Model.ReserveId + "&price=" + @Model.PayablePrice;
        if (hasLoadPopup) {
            loadPopup('/Reserve/ManualSitePayment?' + queryString);
        }
        else {
            showInfoMessage('ثبت پرداخت', '',
                { contentUrl: '/Reserve/ManualSitePayment?' + queryString, fullScreen: screen.width < 781 }
            );
        }
    }

    function AutoSiteClearingHost() {
        if (hasLoadPopup) {
            loadPopup('/Reserve/AutoSiteClearingHost?reserveId=' + @Model.ReserveId);
        }
        else {
            showInfoMessage('تکمیل پرداخت', '',
                { contentUrl: '/Reserve/AutoSiteClearingHost?reserveId=' + @Model.ReserveId, fullScreen: screen.width < 781 }
            );
        }
    }

    function VerifySheba() {
        $.ajax({
            url: "/banking/verifysheba",
            type: "post",
            data: {
                sheba: '@(Model.ShebaNumber)',
                hostName: '@(Model.UserName)',
                bankCardName: '@(Model.BankCardName)',
                bankCardId: '@(Model.BankCardId)',
                shebaVerify: '@(Model.ShebaVerified)'
            },
            beforeSend: function () {
                $('#ShebaNumberWaitingSpan').css("visibility", "visible");
            },
            success: function (data, status, xhr) {
                $('#ShebaNumberWaitingSpan').css("visibility", "hidden");
                showInfoMessage('استعلام شماره شبا', data);
            },
            error: function (ret) {
                $('#ShebaNumberWaitingSpan').css("visibility", "hidden");
                alertify.error("عملیات با خطا مواجه شد");
            }
        });
    }

    function SetUserBankCard() {
        if (hasLoadPopup) {
            loadPopup('/bankcard/SetUserBankCard?userId=' + @Model.UserId);
        }
        else {
            showInfoMessage('ویرایش اطلاعات کارت بانکی', '',
                { contentUrl: '/bankcard/SetUserBankCard?userId=' + @Model.UserId, fullScreen: screen.width < 781 }
            );
        }
    }
</script>