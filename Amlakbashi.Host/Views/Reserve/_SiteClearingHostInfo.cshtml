@using Amlakbashi.Core.DTOs.ReserveDTOs

@model SitePaymentDTO

@if (Model == null)
{
    <p>عملیات با خطا مواجه شد</p>
}
else
{
    <div>
        <span>کد رزرو:</span>
        <span>@Model.ReserveId</span>
        <span><i class="fa fa-copy" style="cursor: pointer; color: #999;" onclick="copyStringToClipboard('کد رزرو: @Model.ReserveId', 'کد رزرو')" /></span>
    </div>
    <div>
        <span>مدت اقامت:</span>
        <span>@Model.Days</span>
    </div>
    <div>
        <span>مبلغ کل:</span>
        <span>@string.Format("{0:n0}", Model.TotalPrice) تومان</span>
    </div>
    <div>
        <span>پرداختی توسط مهمان:</span>
        <span>@string.Format("{0:n0}", Model.GuestPayedPrice) تومان</span>
    </div>
    <div>
        <span>سهم املاک باشی:</span>
        <span>@string.Format("{0:n0}", Model.SitePortion) تومان</span>
    </div>
    <div>
        <span>مبلغ قابل پرداخت:</span>
        <span style="color: blue; font-size: x-large;">@string.Format("{0:n0}", Model.PayablePrice) تومان</span>
        <span><i class="fa fa-copy" style="cursor:pointer; color: #999;" onclick="copyStringToClipboard('@Model.PayablePriceRaw', 'مبلغ قابل پرداخت')" /></span>
    </div>
    <br />
    <div>
        <span>نام میزبان:</span>
        <span>@Model.UserName</span>
    </div>
    <div>
        @{ 
            var bankCardNumberString = Model.BankCardNumber;
            if (Model.BankCardNumber != "ثبت نشده")
            {
                bankCardNumberString = String.Format("{0} {1} {2} {3}", Model.BankCardNumber.Substring(0, 4),
                    Model.BankCardNumber.Substring(4, 4), Model.BankCardNumber.Substring(8, 4), Model.BankCardNumber.Substring(12));
            }
        }
        <span>شماره کارت:</span>
        <span style="color: @(Model.BankCardVerified ? "blue" : "red"); font-size:x-large; direction: ltr; unicode-bidi: embed;">@bankCardNumberString</span>
        <span><i class="fa fa-copy" style="cursor: pointer; color: #999;" onclick="copyStringToClipboard('@Model.BankCardNumber', 'شماره کارت')" /></span>
    </div>
    <div>
        <span>نام صاحب کارت:</span>
        <span id="BankCardNameSpan">@Model.BankCardName</span>
    </div>
    <div>
        <span>شماره شبا:</span>
        <span id="ShebaNumberSpan" style="color: @(Model.ShebaVerified ? "blue" : "red");">@Model.ShebaNumber</span>
        @if (string.IsNullOrEmpty(Model.ShebaNumber) == false)
        {
            <span><i class="fa fa-copy" style="cursor: pointer; color: #999;" onclick="copyStringToClipboard('@Model.ShebaNumber', 'شماره شبا')" /></span>
            @if (Model.ShebaVerified == false || string.IsNullOrEmpty(Model.BankCardName))
            {
                <span><i class="fa fa-sync" style="cursor: pointer; color: #999;" onclick="verifySheba()" /></span>
                <span style="visibility:hidden; color: darkorange; margin-left: 10px; font-size: small;" id="ShebaNumberWaitingSpan">لطفا صبر کنید ...</span>
            }
        }
    </div>
    <div>
        <span>موجودی کیف پول:</span>
        <span style="color: @(Model.UserCredit < 0 ? "red" : Model.UserCredit > 0 ? "limegreen" : "black");">@Model.UserCredit</span>
    </div>
    <br />
    <div style="text-align:center;">
        @*<button style="cursor: pointer; padding: 10px; border-radius: 5px; font: 1em miransans;" onclick="autoSiteClearingHost()">پرداخت خودکار</button>*@
        <button style="cursor: pointer; padding: 10px; border-radius: 5px; font: 1em miransans;" onclick="manualSiteClearingHost()">پرداخت دستی</button>
    </div>
}

<script>
    function manualSiteClearingHost() {
        var queryString = "reserveId=" + @Model.ReserveId + "&price=" + @Model.PayablePrice + "&userType=" + '@Model.UserType';
        showInfoMessage('ثبت پرداخت', '',
            { contentUrl: '/Reserve/ManualSitePayment?' + queryString, fullScreen: screen.width < 781 }
        );
    }

    function autoSiteClearingHost() {
        @*showNoYesMessage('', 'آیا از واریز وجه به حساب میزبان مطمئنید؟',
            function () {
                $.ajax({
                type: "get",
                url: "/reserve/autoSiteClearingHost?reserveId" + @Model.ReserveId,
                success: function (response) {
                    if (response.status == 0) {
                        alertify.error(response.msg);
                    }
                    else {
                        alertify.success(response.msg);
                        reserveAdminHubConnection.invoke('reserveCleared', @Model.ReserveId);
                        popupMsgList[0].btnClick(0, true);
                    }
                }
            });
        })*@
    }

    function verifySheba() {
        @*var queryString = "sheba=" + "@Model.ShebaNumber" + "&hostName=" + "@Model.UserName" + "&bankCardName=" + "@Model.BankCardName" +
            "&bankCardId=" + @Model.BankCardId + "&shebaVerify=" + "@Model.ShebaVerified";
        showInfoMessage('استعلام شماره شبا', '',
            { contentUrl: '/banking/verifysheba?' + queryString, fullScreen: screen.width < 781 }
        );*@

        $.ajax({
            url: "/banking/verifysheba",
            type: "get",
            data: {
                sheba: '@(Model.ShebaNumber)',
                hostName: '@(Model.UserName)',
                bankCardName: '@(Model.BankCardName)',
                bankCardId: '@(Model.BankCardId)',
                shebaVerify: '@(Model.ShebaVerified)'
            },
            beforeSend: function () {
                $('#ShebaNumberWaitingSpan').css("visibility", "visible");
            },
            success: function (data, status, xhr) {
                $('#ShebaNumberWaitingSpan').css("visibility", "hidden");
                showInfoMessage('استعلام شماره شبا', data);
            }
        });
    }
</script>