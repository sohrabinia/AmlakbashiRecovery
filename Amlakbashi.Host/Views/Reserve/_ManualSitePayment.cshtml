
<style>
    #ManualSitePaymentForm div {
        margin-bottom: 10px;
    }
    #ManualSitePaymentForm button {
        cursor: pointer;
        padding: 10px;
        border-radius: 5px;
        font: 1em miransans;
    }
</style>

<form id="ManualSitePaymentForm">
    <input type="hidden" name="reserveId" value="@ViewBag.reserveId" />
    <div>
        <label>کد رزرو:</label>
        <span>@ViewBag.reserveId</span>
    </div>
    <div>
        <label>کد کاربر:</label>
        <input type="text" name="userId" value="@ViewBag.userId" />
    </div>
    <div>
        <label>شماره تراکنش:</label>
        <input type="text" name="transactionId" />
    </div>
    <div>
        <label>شماره ارجاع:</label>
        <input type="text" name="referenceId" />
    </div>
    <div>
        <label>نوع پرداخت:</label>
        <select name="paymentMethod">
            <option value="0">پرداخت اینترنتی</option>
            <option selected="selected" value="2">کارت به کارت</option>
        </select>
    </div>
    <div>
        <label>مبلغ:</label>
        <input type="text" name="price" value="@ViewBag.price" />
    </div>
    <div>
        <label>ارسال پیامک به میزبان</label>
        <input type="checkbox" name="sendSms" value="true" checked="checked" />
    </div>
    @if (ViewBag.hasFailureExpenditurePayment)
    {
        <div>
            <p style="text-align: center;"><b style="color: red;">توجه: </b>این رزرو دارای یک پرداخت خودکار ناموفق است. لطفا قبل از ثبت پرداخت جدید، ابتدا وضعیت آن را بررسی نمایید: <small><a href="/payment/index?reserveId=@ViewBag.reserveId" target="_blank" style="color: blue;">لیست پرداخت های آنلاین</a></small></p>
        </div>
    }
    <div style="text-align:center;">
        <button type="button" onclick="submitManualSitePaymentForm()">ثبت پرداخت</button>
    </div>
</form>

<script>
    function submitManualSitePaymentForm() {
        var form = $('#ManualSitePaymentForm');
        $.ajax({
            type: "POST",
            url: "/reserve/ManualSitePayment",
            data: form.serialize(),
            success: function (response) {
                if (response.status == 0) {
                    alertify.error(response.msg);
                }
                else {
                    alertify.success(response.msg);
                    reserveAdminHubConnection.invoke('reserveCleared', @ViewBag.reserveId);
                    if (typeof hidePopup === 'function') {
                        hidePopup();
                    }
                    else {
                        popupMsgList[1].btnClick(0, true);
                        popupMsgList[0].btnClick(0, true);
                    }
                    
                }
            }
        });
    }
</script>