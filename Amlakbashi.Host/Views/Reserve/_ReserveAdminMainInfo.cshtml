@model Amlakbashi.Core.DTOs.ReserveDTOs.ReserveIndexDTO

@if (Model.ReserveList.Any() == false)
{
    <p style="margin: 30px;">موردی برای نمایش وجود ندارد</p>
}
else
{
    var index = Model.PagingInfo.PageRowStart;
    @foreach (var item in Model.ReserveList)
    {
        index++;
        <aside class="admin-table-row" id="js-@item.id">
            <p class="number-row">@index</p>

            <p class="code-reserve">
                @if (item.instantReserve)
                {
                    <i class='fas fa-bolt'></i>
                }
                @item.id
                <i class="fas fa-copy" onclick="copyStringToClipboard('@(item.id)', 'کد رزرو @(item.id)')"></i>
            </p>

            <div class="information-travel">
                <div class="box-codes">
                    <p>  کد آگهی :</p>
                    <a href="/Advertise/newindex?status=-1&id=@(item.parentAccomodationId > 0 ? item.parentAccomodationId : item.accommodationId)">@item.accommodationId @(item.parentAccomodationId > 0 ? " >> " + item.parentAccomodationId : "")</a>
                    <i class="fas fa-copy" onclick="copyStringToClipboard('@(item.accommodationId)', 'کد آگهی @(item.accommodationId)')"></i>
                </div>
                <div class="box-codes">
                    <p>  کد میزبان : </p>
                    <a href="/User/Index?code=@item.hostUserId">@item.hostUserId</a>
                    <i class="fas fa-copy" onclick="copyStringToClipboard('@(item.hostUserId)', 'کد میزبان @(item.hostUserId)')"></i>
                    <i class="fas fa-phone-square" onclick="showCallPopup(@(item.hostUserId), @(item.id), 'میزبان')"></i>
                </div>
                <div class="box-codes">
                    <p>  کد مهمان :</p>
                    <a href="/User/Index?code=@item.guestUserId">@item.guestUserId</a>
                    <i class="fas fa-copy" onclick="copyStringToClipboard('@(item.guestUserId)', 'کد مهمان @(item.guestUserId)')"></i>
                    <i class="fas fa-phone-square" onclick="showCallPopup(@(item.guestUserId), @(item.id), 'مهمان')"></i>
                </div>
            </div>

            <div class="details-travel">
                <p>@item.startDateString الی @item.endDateString (@item.stayDays شب)</p>
                <p>تعداد @item.guestCount نفر</p>
                <p>مبلغ @string.Format("{0:n0}", item.totalPrice) @(item.depositePrice != item.totalPrice ? string.Format("(بیعانه: {0:n0})", item.depositePrice) : "")</p>
            </div>

            <div class="status">
                <p style="color:@item.statusColor;">@item.statusString</p>
                @if (item.instantReserve == false)
                {
                    <small style="border-top: 1px solid lightgray; margin-top: 5px; padding-top: 5px;">@item.hostResponseString</small>
                }
            </div>

            <div class="support-desc">
                <button onclick="nextCallState(@(item.id), 'h', 'میزبان', this)" js-call-state="@(item.hostCallState)" style="color:@item.hostCallStateColor" class="support-call-btn call-state-h"><i class="fas fa-phone"></i> میزبان</button>
                <button onclick="nextCallState(@(item.id), 'g', 'مهمان', this)" js-call-state="@(item.guestCallState)" style="color:@item.guestCallStateColor" class="support-call-btn call-state-g"><i class="fas fa-phone"></i> مهمان</button>
                <button onclick="showSupportInfo(@item.id)" class="support-desc-btn">توضیحات (<small class="js-info-count">@item.supportInfoCount</small>)</button>
            </div>

            <div class="force-options">
                @if (item.totalChatCount > 0)
                {
                    <a class="chat-info-btn" asp-controller="reserve" asp-action="chat" asp-route-reserve_id="@item.id" target="_blank">
                        @if (item.newChatCount > 0)
                        {
                            <small style="color: red; font-weight: bold;"> !</small>
                        }
                        else
                        {
                            <small> @item.totalChatCount</small>
                        }
                        <span class="fas fa-comments" title="چت ها"></span>
                    </a>
                }
                @if (item.paymentTryCount > 0)
                {
                    if (item.payments != null && item.payments.Count > 0)
                    {
                        <a target="_blank" href="/reservepayment/index?reserve_id=@(item.id)" title="لیست پرداخت ها"><small>@item.paymentTryCount </small><span style="color: green;" class="fas fa-file-invoice-dollar"></span></a>
                    }
                    else
                    {
                        <a target="_blank" href="/reservepayment/index?reserve_id=@(item.id)" title="لیست پرداخت ها"><small>@item.paymentTryCount </small><span style="color: red;" class="fas fa-file-invoice-dollar"></span></a>
                    }
                }
                @if (item.mustDoClearing)
                {
                    <i class="fas fa-money-check-alt clearing-btn" onclick="showSiteClearingHostPopup(@item.id)" style="color:orange;" title="تسویه میزبان"></i>
                    <i class="fas fa-wallet clearing-btn" onclick="siteClearingHostWithCredit(@item.id, this)" style="color:orange;" title="تسویه میزبان با کیف پول"></i>
                }
                else if (item.canDoClearing)
                {
                    <i class="fas fa-money-check-alt clearing-btn" onclick="showSiteClearingHostPopup(@item.id)" style="color:green;" title="تسویه میزبان"></i>
                    <i class="fas fa-wallet clearing-btn" onclick="siteClearingHostWithCredit(@item.id, this)" style="color:green;" title="تسویه میزبان با کیف پول"></i>
                }
                @if (item.mustRefund)
                {
                    <i class="fas fa-money-check-alt refund-btn" style="color:red;" onclick="showSiteRefundGuestPopup(@item.id)" title="عودت به مهمان"></i>
                    <i class="fas fa-wallet refund-btn" style="color:red;" onclick="siteRefundGuestWithCredit(@item.id, this)" title="عودت به مهمان با کیف پول"></i>
                }
                @if (item.canBePaidByHost)
                {
                    <i class="fas fa-wallet pay-reserve-with-credit-host-btn" onclick="payReserveWithCreditHost(@item.id, this)" style="color:dodgerblue;" title="کسر درصد املاک باشی از کیف پول میزبان"></i>
                }
            </div>

            @* قسمت موارد بیشتر *@
            <p class="button-more-options" onclick="showMoreOptionBox(this, @item.id)">  <i class="fas fa-plus-square more-options-btn"></i></p>
            <div class="box-more-options-container js-more-option"></div>
        </aside>
    }

    <div action="newindex" paging-info="@Model.PagingInfo" parameters="new
                    {
        ReserveId = Model.ReserveId,
        AdvertiseId = Model.AdvertiseId,
        HostUserId = Model.HostUserId,
        GuestUserId = Model.GuestUserId,
        ReserveStatus = Model.ReserveStatus,
        HostResponseStatus = Model.HostResponseStatus,
        GeneralStatus = Model.GeneralStatus,
        SiteClearedStatus = Model.SiteClearedStatus,
        SiteClearingDate = Model.SiteClearingDate,
        ReserveFromDate = Model.ReserveFromDate,
        ReserveToDate = Model.ReserveToDate,
        ReserveEndDate = Model.ReserveEndDate,
        StayDurationFrom = Model.StayDurationFrom,
        StayDurationTo = Model.StayDurationTo,
        ReserveSupportStatus = Model.ReserveSupportStatus,
        ShouldFollow = Model.ShouldFollow,
        SupporterId = Model.SupporterId,
        HostCardStatus = Model.HostCardStatus,
        MainFilter = Model.MainFilter,
        InstantReserveFilter = Model.InstantReserveFilter,
        DisableAutoCancel = Model.DisableAutoCancel,
        AccVisited = Model.AccVisited
                    }"></div>
}