@model Amlakbashi.Core.DTOs.ReserveDTOs.ReserveAdminItemDTO

<p class="number-row">@ViewBag.index</p>

<p class="code-reserve">
    @if (Model.instantReserve)
    {
        <i class='fas fa-bolt'></i>
    }
    @Model.id
    <i class="fas fa-copy" onclick="copyStringToClipboard('@(Model.id)', 'کد رزرو @(Model.id)')"></i>
</p>

<div class="information-travel">
    <div class="box-codes">
        <p>  کد آگهی :</p>
        <a href="/Advertise/Index?status=-1&id=@(Model.parentAccomodationId > 0 ? Model.parentAccomodationId : Model.accommodationId)">@Model.accommodationId @(Model.parentAccomodationId > 0 ? " >> " + Model.parentAccomodationId : "")</a>
        <i class="fas fa-copy" onclick="copyStringToClipboard('@(Model.accommodationId)', 'کد آگهی @(Model.accommodationId)')"></i>
    </div>
    <div class="box-codes">
        <p>  کد میزبان : </p>
        <a href="/User/Index?code=@Model.hostUserId">@Model.hostUserId</a>
        <i class="fas fa-copy" onclick="copyStringToClipboard('@(Model.hostUserId)', 'کد میزبان @(Model.hostUserId)')"></i>
        <i class="fas fa-phone-square" onclick="showCallPopup(@(Model.hostUserId), @(Model.id), 'میزبان')"></i>
    </div>
    <div class="box-codes">
        <p>  کد مهمان :</p>
        <a href="/User/Index?code=@Model.guestUserId">@Model.guestUserId</a>
        <i class="fas fa-copy" onclick="copyStringToClipboard('@(Model.guestUserId)', 'کد مهمان @(Model.guestUserId)')"></i>
        <i class="fas fa-phone-square" onclick="showCallPopup(@(Model.guestUserId), @(Model.id), 'مهمان')"></i>
    </div>
</div>

<div class="details-travel">
    <p>@Model.startDateString الی @Model.endDateString (@Model.stayDays شب)</p>
    <p>تعداد @Model.guestCount نفر</p>
    <p>مبلغ @string.Format("{0:n0}", Model.totalPrice) @(Model.depositePrice != Model.totalPrice ? string.Format("(بیعانه: {0:n0})", Model.depositePrice) : "")</p>
</div>

<p class="status" style="color:@Model.statusColor;">@Model.statusString</p>

<div class="support-desc">
    <button onclick="nextCallState(@(Model.id), 'h', 'میزبان', this)" js-call-state="@(Model.hostCallState)" style="color:@Model.hostCallStateColor" class="support-call-btn call-state-h"><i class="fas fa-phone"></i> میزبان</button>
    <button onclick="nextCallState(@(Model.id), 'g', 'مهمان', this)" js-call-state="@(Model.guestCallState)" style="color:@Model.guestCallStateColor" class="support-call-btn call-state-g"><i class="fas fa-phone"></i> مهمان</button>
    <button onclick="showSupportInfo(@Model.id)" class="support-desc-btn">توضیحات (<small class="js-info-count">@Model.supportInfoCount</small>)</button>
</div>

<div class="force-options">
    @if (Model.totalChatCount > 0)
    {
        <a class="chat-info-btn" asp-controller="reserve" asp-action="chat" asp-route-reserve_id="@Model.id" target="_blank">
            @if (Model.newChatCount > 0)
            {
                <small style="color: red; font-weight: bold;"> !</small>
            }
            else
            {
                <small> @Model.totalChatCount</small>
            }
            <span class="fas fa-comments" title="چت ها"></span>
        </a>
    }
    @if (Model.paymentTryCount > 0)
    {
        if (Model.payments != null && Model.payments.Count > 0)
        {
            <a target="_blank" href="/reservepayment/index?reserve_id=@(Model.id)" title="لیست پرداخت ها"><small>@Model.paymentTryCount </small><span style="color: green;" class="fas fa-file-invoice-dollar"></span></a>
        }
        else
        {
            <a target="_blank" href="/reservepayment/index?reserve_id=@(Model.id)" title="لیست پرداخت ها"><small>@Model.paymentTryCount </small><span style="color: red;" class="fas fa-file-invoice-dollar"></span></a>
        }
    }
    @if (Model.mustDoClearing)
    {
        <i class="fas fa-money-check-alt clearing-btn" onclick="showSiteClearingHostPopup(@Model.id)" style="color:orange;" title="تسویه میزبان"></i>
        <i class="fas fa-wallet clearing-btn" onclick="siteClearingHostWithCredit(@Model.id, this)" style="color:orange;" title="تسویه میزبان با کیف پول"></i>
    }
    else if (Model.canDoClearing)
    {
        <i class="fas fa-money-check-alt clearing-btn" onclick="showSiteClearingHostPopup(@Model.id)" style="color:green;" title="تسویه میزبان"></i>
        <i class="fas fa-wallet clearing-btn" onclick="siteClearingHostWithCredit(@Model.id, this)" style="color:green;" title="تسویه میزبان با کیف پول"></i>
    }
    @if (Model.mustRefund)
    {
        <i class="fas fa-money-check-alt refund-btn" style="color:red;" onclick="showSiteRefundGuestPopup(@Model.id)" title="عودت به مهمان"></i>
        <i class="fas fa-wallet refund-btn" style="color:red;" onclick="siteRefundGuestWithCredit(@Model.id, this)" title="عودت به مهمان با کیف پول"></i>
    }
    @if (Model.canBePaidByHost)
    {
        <i class="fas fa-wallet pay-reserve-with-credit-host-btn" onclick="payReserveWithCreditHost(@Model.id, this)" style="color:dodgerblue;" title="کسر درصد املاک باشی از کیف پول میزبان"></i>
    }
</div>

@* قسمت موارد بیشتر *@
<p class="button-more-options" onclick="showMoreOptionBox(this, @Model.id)">  <i class="fas fa-plus-square"></i></p>
<div class="box-more-options-container js-more-option"></div>
