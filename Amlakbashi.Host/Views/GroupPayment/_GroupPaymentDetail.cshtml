@using Amlakbashi.Core.DTOs.PaymentDTOs;

@model GroupPaymentDetailsDTO

@{
    var statusList = new List<GroupPayment.GroupPaymentStatus>() {
            GroupPayment.GroupPaymentStatus.ReadyToPay,
            GroupPayment.GroupPaymentStatus.WithError,
            GroupPayment.GroupPaymentStatus.Excluded
        };
}

<style>
    .group-payment-list__item {
        display: flex;
        flex-flow: row;
        justify-content: space-between;
        border-bottom: 1px solid #ccc;
    }

    .group-payment-list__cell {
        width: 12%;
        margin: 10px auto;
    }
</style>

<div style="direction:rtl;display:flex;flex-flow: column;">
    @foreach (var item in Model.GroupPaymentItems)
    {
        <div class="group-payment-list__item" style="background-color:@(item.BankResult == null ? "#ffffff" : (item.BankResult.success ? "#edf7ee" : "#f2e4e3"))">
            <a target="_blank" href="/reserve/newindex?reserve_id=@item.ReserveId" class="group-payment-list__cell">کد رزرو: @item.ReserveId</a>
            <div class="group-payment-list__cell">مبلغ: @(string.Format("{0:n0}", item.HostPayablePrice) + " ت")</div>
            @*<div class="group-payment-list__cell">
                    <div>نام میزبان:</div>
                    <div>@(string.IsNullOrEmpty(UserDepend.GetFullName(hostUser)) ? "-" : UserDepend.GetFullName(hostUser))</div>
                </div>*@
            <div class="group-payment-list__cell">
                <div>نام صاحب کارت:</div>
                <div>@(string.IsNullOrEmpty(item.HostBankCardFullName) ? "-" : item.HostBankCardFullName)</div>
            </div>
            @if (item.HostUserCredit == 0)
            {
                <div class="group-payment-list__cell">موجودی: 0</div>
            }
            else if (item.HostUserCredit > 0)
            {
                <div class="group-payment-list__cell" style="color:#34A853">
                    <div>موجودی:</div>
                    <div>@(string.Format("{0:n0}", item.HostUserCredit) + " ت")</div>
                </div>
            }
            else
            {
                <div class="group-payment-list__cell" style="color:#EA4335">
                    <div>بدهی:</div>
                    <div>@(string.Format("{0:n0}", Math.Abs(item.HostUserCredit)) + " ت")</div>
                </div>
            }
            <div class="group-payment-list__cell">
                <div>توضیح بانک:</div>
                <div>@(item.BankResult == null ? "-" : item.BankResult.Description)</div>
            </div>
            <div class="group-payment-list__cell">
                <div>تاریخ پرداخت:</div>
                <div>@(item.BankResult == null ? "-" : item.BankResult.DateString)</div>
            </div>
            <div class="group-payment-list__cell">
                <div>کد پیگیری:</div>
                <div>@(item.BankResult == null ? "-" : item.BankResult.TrackingNumber)</div>
            </div>
            <div class="group-payment-list__cell">
                <div>شماره ارجاع:</div>
                <div>@(item.BankResult == null ? "-" : item.BankResult.RefNumber)</div>
            </div>
        </div>
    }
</div>