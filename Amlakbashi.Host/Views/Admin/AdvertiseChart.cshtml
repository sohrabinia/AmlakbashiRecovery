@using Amlakbashi.Core.Infrastructure.LocalizationHelpers;

@{
    ViewBag.Title = "نمودار آماری";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
}

@model Dictionary<string, List<int>>

<div style="width:100%;">
    @using (Html.BeginForm("AdvertiseChart", "admin", FormMethod.Post))
    {
        <div class='dynamic-filter'>

            <div class="dynamic-filter__item">
                <div class="dynamic-filter__label">نوع زمانبندی :</div>
                <div class="dynamic-filter__property">
                    <select name="type">
                        <option is-selected="@(ViewBag.type == "daily")" value="daily">روزانه</option>
                        <option is-selected="@(ViewBag.type == "monthly")" value="monthly">ماهانه</option>
                    </select>
                </div>
            </div>

            @await Component.InvokeAsync("RegionSelector")

            <div class="dynamic-filter__item">
                <div class="dynamic-filter__label"> کد  کاربر :</div>
                <div class="">
                    <input type="tel" name="userid" value="@ViewBag.userid" style="background-color: #fff;
                        padding: 0;margin: 0;width: 85%;border: 1px solid #ccc;
                        border-radius: 7px;font: 15px rnassim;height: 37px;direction: rtl;text-align: center;" />
                </div>
            </div>

            <div class="dynamic-filter__item">
                <div class="dynamic-filter__label">نوع آگهی :</div>
                <div class="dynamic-filter__property">
                    <select name="adtype">
                        <option value="-1">نوع آگهی را انتخاب کنید </option>
                        @{ var types2 = Advertise.GetAdvertiseTypes(Advertise.AdvertisePageType.Filter);}
                        @foreach (var item in types2)
                        {
                            <option is-selected="@((int)ViewBag.adtype == (int)item)" value="@((int)item)">@AdvertiseMainLocalization.GetAdvertiseTypeUserString(item)</option>
                        }
                    </select>
                </div>
            </div>


            <div class="dynamic-filter__button">
                <input type="submit" value="فیلتر" />
            </div>
        </div>

    }
</div>
<div style="clear:both ;"></div>
<div style="direction:ltr;margin-top:50px;">
    <div id="container" style="width:100%; height:400px;"></div>
</div>
@section ScriptBlock
{
    <script type="text/javascript">

    var cats = [];
    var series = [];
    @{
        string str_title = "نمودار آماری ثبت آگهی ها";
        if (ViewBag.user != null)
        {
            var cat_item = ViewBag.user;
            str_title = cat_item.FullName ;
        }
        if (ViewBag.type=="monthly")
        {
            var fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            for (int i = 0; i < 22; i++)
            {
                <text>
                    cats.unshift('@fromDate.ToString("MMM")');
                </text>
                fromDate = fromDate.AddMonths(-1);
            }
        }
        else if(ViewBag.type=="daily")
        {
            var fromDate = DateTime.Now ;
            for (int i = 0; i < 40; i++)
            {
                <text>
                    cats.unshift('@fromDate.ToString("MMM dd")');
                </text>
                fromDate = fromDate.AddDays(-1);
            }
        }

        foreach(var item in Model){
            <text>
                var tmps = {}
            tmps.name = '@item.Key';
            tmps.data = [];
            </text>

            foreach (var mi in item.Value) {
                <text>
                    tmps.data.push(@mi) ;
                </text>
            }
            <text>
                series.push(tmps) ;
            </text>
        }
    }

    $(function () {
        Highcharts.chart('container', {
            title: {
                text: '@str_title',
                x: -20 //center
            },
            subtitle: {
                text: '',
                x: -20
            },
            xAxis: {
                categories: cats
            },
            yAxis: {
                title: {
                    text: 'تعداد آگهی'
                },
                plotLines: [{
                    value: 0,
                    width: 1,
                    color: '#808080'
                }]
            },
            tooltip: {
                valueSuffix: '   آگهی    '
            },
            legend: {
                layout: 'vertical',
                align: 'right',
                verticalAlign: 'middle',
                borderWidth: 0
            },
            series: series
        });
    });

    $(document).ready(function(){
        $(".highcharts-credits").hide();
    })

    </script>
}
@section StyleBlock{
    <style>
        div {
            cursor: pointer;
            text-align: center;
        }

        td {
            background-color: #efefef !important;
        }

        .highcharts-title {
            font: 40px bnassim;
        }
    </style>
}
