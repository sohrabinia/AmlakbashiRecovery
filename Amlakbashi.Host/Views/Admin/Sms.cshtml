@model Amlakbashi.Core.Entities.Comment
@{
    ViewBag.Title = "ارسال اس ام اس";
    Layout = "~/Views/Shared/_MasterAdmin.cshtml";
    ViewBag.province = 0;
    ViewBag.city = 0;
    ViewBag.area = 0;
    string[] SmsTemplates = new string[] { "Template1", "Template2", "Template3", "SetNorouzPrice" };
}

@section ScriptLink
{
}
<div class="title">ارسال  اس ام اس</div>
<form data-ajax="true" asp-action="sendsms" asp-controller="admin" data-ajax-success="done" id="add-comment-form" method="post" enctype="multipart/form-data">
    <input type="hidden" id="confirmRequired" name="confirmRequired" value="true" />
    <div class="dynamic-filter">
        <div class="dynamic-filter__item" id="user_id_filter">
            <div class="dynamic-filter__label">کد کاربری گیرنده :</div>
            <div class="dynamic-filter__property">
                <input name="recieverUserID" id="user_id_label" value="0" style="height:35px; border:1px solid #ccc;border-radius:7px;" />
            </div>
        </div>
        <div class="dynamic-filter__item">
            <div class="dynamic-filter__label">
                وضعیت مالکیت گیرنده ها :
            </div>
            <div class="dynamic-filter__property">
                <select name="ownership">
                    <option selected="selected" value="-1">همه وضعیت ها</option>
                    <option value="0">واسطه‌ی حتمی</option>
                    <option value="1">واسطه‌ی احتمالی</option>
                    <option value="3">مالک احتمالی</option>
                    <option value="10">مالک حتمی</option>
                </select>
            </div>
        </div>

        <div class="dynamic-filter__item">
            <div class="dynamic-filter__label">نوع آگهی :</div>
            <div class="dynamic-filter__property">

                <select name="adtype">
                    <option value="-1">همه </option>
                    @{ var types2 = Advertise.GetAdvertiseTypes(Advertise.AdvertisePageType.Filter);}
                    @foreach (var item in types2)
                    {
                        <option value="@((int)item)">@Amlakbashi.Core.Infrastructure.LocalizationHelpers.AdvertiseMainLocalization.GetAdvertiseTypeUserString(item)</option>
                    }
                </select>
            </div>
        </div>

        <div class="dynamic-filter__item">
            <div class="dynamic-filter__label">وضعیت آگهی :</div>
            <div class="dynamic-filter__property">
                <select name="adstatus">
                    <option value="-1">همه وضعیت ها</option>
                    <option value="0">آماده انتشار</option>
                    <option value="1">انتشار یافته</option>
                    <option value="2">تعلیق شده</option>
                    <option value="6">آگهی جدید</option>
                    <option value="5">تکمیل نشده ها</option>
                    <option value="4">تایید نشده</option>
                    <option value="3">حذف شده ها</option>
                </select>
            </div>
        </div>

        <div class="dynamic-filter__item">
            <div class="dynamic-filter__label">نوع معامله :</div>
            <div class="dynamic-filter__property">

                <select name="tradeid">
                    <option value="-1">همه </option>
                    <option value="20">اجاره روزانه</option>
                    <option value="1">خرید و فروش</option>
                    <option value="2">رهن و اجاره</option>
                </select>
            </div>
        </div>


        <div class="dynamic-filter__item">
            <div class="dynamic-filter__label">نوع ویژه :</div>
            <div class="dynamic-filter__property">
                <select name="special">
                    <option value="-1">همه </option>
                    <option value="0">آگهی عادی</option>
                    <option value="1">آگهی ویژه</option>
                    <option value="2">48 آگهی ویژه</option>
                    <option value="3"> آگهی ویژه 24</option>
                    <option value="4">آگهی ویژه 12</option>
                    <option value="5">ویژه ی یک ستاره یک ماهه</option>
                    <option value="6">ویژه ی یک ستاره سه ماهه</option>
                    <option value="7">ویژه ی یک ستاره شش ماهه</option>
                    <option value="8">ویژه ی دو ستاره یک ماهه</option>
                    <option value="9">ویژه ی دو ستاره سه ماهه</option>
                    <option value="10">ویژه ی دو ستاره شش ماهه</option>
                    <option value="11">ویژه ی سه ستاره یک ماهه</option>
                    <option value="12">ویژه ی سه ستاره سه ماهه</option>
                    <option value="13">ویژه ی سه ستاره شش ماهه</option>
                    <option value="999">ویژه ی سهرابی</option>
                </select>
            </div>
        </div>
        @await Component.InvokeAsync("RegionSelector", new { province = ViewBag.province, city = ViewBag.city, area = ViewBag.area })
    </div>
    <table style="margin-top: 15px;border: solid lightgray; border-width: thin;">
        <tr>
            <td class="label">
                الگوی پیام :
            </td>
            <td style="width:700px;">
                <select name="template" id="template-select">
                    <option value="">انتخاب کنید</option>
                    @foreach (var template in SmsTemplates)
                    {
                        <option value="@template">@template</option>
                    }
                </select>
            </td>
            <td></td>
        </tr>
    </table>

    <div style="margin-top:20px;">
        <input class="apply" type="submit" value="ارسال" />
        <div id="loading-icon-sending" style="display: none">
            <div class="ui active loader" style="position:fixed; display:flex; flex-flow: column-reverse; width: 100px; height: 70px">
                <span style="width:100px">در حال ارسال پیام</span>
            </div>
        </div>
    </div>
</form>

@section ScriptBlock
{
<script type="text/javascript">

    var has_advertise_id = false;
    var has_user_id = false
    $("#advertise_id_label").change(function ()
    {
        has_advertise_id = $(this).val() > 0;
        $(".dynamic-filter__item").not("#advertise_id_filter").each(function ()
        {
            if (has_advertise_id)
            {
                if (!$(this).hasClass("hidden"))
                {
                    $(this).addClass("hidden");
                }
            }
            else
            {
                $(this).removeClass("hidden");
            }
        });
    });

    $("#user_id_label").change(function()
    {
        has_user_id = $(this).val() > 0;
        $(".dynamic-filter__item").not("#user_id_filter").each(function () {
            if (has_user_id) {
                if (!$(this).hasClass("hidden")) {
                    $(this).addClass("hidden");
                }
            }
            else {
                $(this).removeClass("hidden");
            }
        });
    });
        function done(data) {
            if (data.status == 0) {
                $("#confirmRequired").val("true");
                $("#loading-icon-sending").css('display', 'none');
                alert(data.message);
            }
            else if (data.status == 1) {
                if ($("#template-select").val() == "") {
                    alert("لطفا الگوی پیام را انتخاب کنید");
                    return;
                }
                //if ($("#sender_user-id-label").val() < 1) {
                //    alert("کد کاربری فرستنده نامعتبر است");
                //    return;
                //}
                if (data.usersCount == 0) {
                    alert("هیچ کاربری با این مشخصات موجود نیست");
                }
                else {
                    if (confirm("تعداد " + data.usersCount + " کاربر انتخاب شده اند؛ پیام ارسال شود؟")) {
                        $("#confirmRequired").val("false");
                        $("form").submit();
                        $("#loading-icon-sending").css('display', 'initial');
                    }
                    else {
                        $("#confirmRequired").val("true");
                        $("#loading-icon-sending").css('display', 'none');
                    }
                }
            }
            else if (data.status == 2) {
                $("#loading-icon-sending").css('display', 'none').del;
                setTimeout(function () {
                    alert("اس ام اس های مورد نظر ارسال شدند.");
                    window.location.href = "../Admin/Sms";
                }, 300);
            }
        }

</script>
}