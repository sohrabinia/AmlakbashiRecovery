            <div id="instant-reserve-filter-button" onclick="toggleInstantReserve()" style="background-color:@(Model.InstantReserve ? "#fdd835" : "white");" class="advertise-list__pin-filter-item">
                <i class="fa fa-bolt"></i>
                <span>رزرو آنی</span>
            </div>
            <div id="today-empty-filter-button" onclick="toggleTodayEmpty()" style="background-color:@(Model.TodayEmptyHomes ? "#fdd835" : "white")" class="advertise-list__pin-filter-item">
                <i class="fa fa-home"></i>
                <span>خالی امشب</span>
