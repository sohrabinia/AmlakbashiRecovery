            }*@
    }
    else
    {
        <meta name="robots" content="noindex, follow">
    }
    @*<link rel="amphtml" href="https://www.amlakbashi.com/amp@(Model.RawUrl)" />*@
    <meta property="og:url" content="https://www.amlakbashi.com@(Model.RawUrl)" />
    <meta property="og:image" content='@("https://www.amlakbashi.com" + (Model.AdvertiseItems.Any() && Model.AdvertiseItems.First().PhotoID > 0 ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", Model.AdvertiseItems.First().PhotoID, 700, 394) : string.Format("/عکس-یافت-نشد-{0}-{1}", 700, 394)))' />
}

