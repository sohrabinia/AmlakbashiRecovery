@using Amlakbashi.Core.Infrastructure.LocalizationHelpers;
@using Amlakbashi.Core.DTOs.CategoryDTOs;

@model CategoryItemDTO

@{
    ViewBag.CurrentPage = "AdvertiseCategory";
    string phrase = Model.Phrase == null ? null : Model.Phrase.Replace("-", " ");
    ViewBag.Title = Model.Title;
    ViewBag.keywords = Model.Keywords;
    ViewBag.Description = Model.Description;
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.region_filter_status = (int)Region.RegionStatus.HasAdvertise;

    var related_categories = (Model.RelatedCategories == null ? new List<DynamicCategory>() : Model.RelatedCategories);

    ViewBag.region_filter_item_class = "advertise-filter__item";
    ViewBag.region_filter_label_class = "advertise-filter__title";
    ViewBag.region_filter_property_class = "advertise-filter__property";

    var next_page_available = Model.PagesCount > Model.CurrentPageNumber;
    var previous_page_available = Model.CurrentPageNumber > 1;
    var next_page = Model.CurrentPageNumber + 1;
    var previous_page = Model.CurrentPageNumber - 1;
    var capacity = string.IsNullOrEmpty(Model.Capacity) ? 0 : int.Parse(Model.Capacity);
    var types = Advertise.GetAdvertiseTypes(Advertise.AdvertisePageType.Filter);

    var moreFilterCount = 0;
    if (Model.PriceString != "")
    {
        moreFilterCount++;
    }

    var accTypeString = Model.AccTypeString;
    if (accTypeString != "")
    {
        moreFilterCount++;
    }

    if (Model.Region != null && Model.Region != "-1")
    {
        moreFilterCount++;
    }
    if (!string.IsNullOrEmpty(Model.RoomList))
    {
        moreFilterCount++;
    }
    if (Model.Parking == 1)
    {
        moreFilterCount++;
    }
    if (Model.RulesPets == 1)
    {
        moreFilterCount++;
    }
    if (Model.RulesParty == 1)
    {
        moreFilterCount++;
    }
    if (Model.RulesSmoking == 1)
    {
        moreFilterCount++;
    }
    if (Model.Pool == "1")
    {
        moreFilterCount++;
    }
    if (Model.Elevator == "1")
    {
        moreFilterCount++;
    }
    if (Model.WcType != -1)
    {
        if (Model.WcType == 128)
        {
            moreFilterCount++;
        }
        moreFilterCount++;
    }
    if (Model.Wifi == 1)
    {
        moreFilterCount++;
    }
    if (Model.WashingMachine == 1)
    {
        moreFilterCount++;
    }
    if (Model.Jacuzzi == 1)
    {
        moreFilterCount++;
    }
    if (Model.PoolTable == 1)
    {
        moreFilterCount++;
    }
    if (Model.Foosball == 1)
    {
        moreFilterCount++;
    }
    if (Model.TeaMaker == 1)
    {
        moreFilterCount++;
    }
}

@section StyleBlock {
    .advertise-category__description * {
    font: 13px Miransans !important;
    }

    .master__header {
    z-index: 4;
    }
    .style-video{
    display:block;
    margin:0 auto;
    margin-top:10px;
    width:40%;
    }
    @@media (max-width: 680px){
    .style-video{
    width:80%;
    }
    }
    @@media (max-width: 480px){
    .style-video{
    width:100%;
    }
    }
    .advertise-list__filter-location-box .dynamic-filter_box-items {
    display: flex;
    margin-top: -15px;
    margin-bottom: 5px;
    }
}

@section StyleLink {
    <link rel="stylesheet" href="/css/cat-item.min.css" asp-append-version="true" />
}

@section TopPin {
    <div class="advertise-list__pin-filter-container">
        <div class="advertise-list__pin-filter-top">
            <div class="advertise-list__pin-filter-right">
                <div id="divDateFilter" onclick="showDateFilter()" class="advertise-list__pin-filter-item" style="background-color:@(Model.DateString != "" ? "#fdd835" : "white")">
                    <i class="fa fa-calendar-alt"></i>
                    <span>@(Model.DateString == "" ? "تاریخ سفر" : Model.DateString)</span>
                </div>
                <div class="advertise-list__filter-box-item" id="js-date-filter-item">
                    <div class="advertise-list__filter-popup-header">
                        <div class="advertise-list__filter-header-text">تاریخ ورود و خروج</div>
                        <div onclick="hideAllFilterItems()" class="advertise-list__filter-close-btn"><i class="fa fa-times"></i></div>
                    </div>
                    <input type="hidden" id="from_date_date_picker" value="@(!string.IsNullOrEmpty(Model.EmptyRangeFrom) ? Model.EmptyRangeFrom : "")" />
                    <input type="hidden" id="to_date_date_picker" value="@(!string.IsNullOrEmpty(Model.EmptyRangeTo) ? Model.EmptyRangeTo : "")" />
                    @await Html.PartialAsync("_DatePicker", null, new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) { { "id", "main-date-picker" }, { "class", "main-date-picker" } })
                    <div style="margin-top:-1vh;text-align: center;border: 1px solid #ccc;border-radius: 5px;">از <span id="js-from-date-label">@(!string.IsNullOrEmpty(Model.EmptyRangeFrom) ? Model.EmptyRangeFrom : "-")</span> تا <span id="js-to-date-label">@(!string.IsNullOrEmpty(Model.EmptyRangeTo) ? Model.EmptyRangeTo : "-")</span></div>
                    <div class="advertise-list__filter-btn-container">
                        <div onclick="removeDateFilter()" style="background-color:#EA4335;">حذف فیلتر</div>
                        <div onclick="doDateFilter()" style="background-color:#34A853;">اعمال فیلتر</div>
                    </div>
                </div>
                <div id="divCapacityFilter" onclick="showCapacityFilter()" class="advertise-list__pin-filter-item" style="background-color:@(capacity > 0 ? "#fdd835" : "white")">
                    <i class="fa fa-users"></i>
                    <span>@(capacity < 1 ? "نفرات" : capacity + " نفر")</span>
                </div>
                <div class="advertise-list__filter-box-item" id="js-capacity-filter-item">
                    <div class="advertise-list__filter-popup-header">
                        <div class="advertise-list__filter-header-text">تعداد مهمان</div>
                        <div onclick="hideAllFilterItems()" class="advertise-list__filter-close-btn"><i class="fa fa-times"></i></div>
                    </div>
                    <div style="width:unset;min-height: 0px;display: flex;align-items: center;margin: 20px 0;justify-content:space-around;">
                        <div style="margin: 10px;width:100px;font:13px Miransans;">تعداد نفرات:</div>
                        <div style="display:flex;align-items:center;width:120px;">
                            <i class="fa fa-plus" style="border-radius:60px;width:33px;height:29px;text-align:center;border:1px solid #242424;padding:5px;cursor:pointer;margin:0 5px;box-shadow:1px 2px 3px 0 rgba(0,0,0,.1);" onclick="onClickIncDecButton(this)" data-action="plus"></i>
                            <input style="width:45%;border:none;text-align:center;" value="@capacity" id="js-capacity-input" class="inc_dec_number" type="number" name="Metrazh" min="0">
                            <i class="fa fa-minus" style="border-radius:60px;width:33px;height:29px;text-align:center;border:1px solid #242424;padding:5px;cursor:pointer;margin:0 5px;box-shadow:1px 2px 3px 0 rgba(0,0,0,.1);" onclick="onClickIncDecButton(this)" data-action="minus"></i>
                        </div>
                    </div>
                    <div class="advertise-list__filter-btn-container">
                        <div onclick="removeCapacityFilter()" style="background-color:#EA4335;">حذف فیلتر</div>
                        <div onclick="doCapacityFilter()" style="background-color:#34A853;">اعمال فیلتر</div>
                    </div>
                </div>
                <div id="divRegionFilter" onclick="showRegionFilter()" class="advertise-list__pin-filter-item" style="background-color:@(Model.RegionString != "" ? "#fdd835" : "white")">
                    <i class="fa fa-map-marker-alt"></i>
                    <span>@(Model.RegionString == "" ? "مقصد سفر" : Model.RegionString)</span>
                </div>
                <div class="advertise-list__filter-box-item" id="js-region-filter-item">
                    <div class="advertise-list__filter-popup-header">
                        <div class="advertise-list__filter-header-text">مقصد سفر</div>
                        <div onclick="hideAllFilterItems()" class="advertise-list__filter-close-btn"><i class="fa fa-times"></i></div>
                    </div>
                    <div class="advertise-list__region-filter-container">
                        <div class="advertise-list__filter-location-box" style="display:flex;flex-wrap:wrap;align-items:center;">
                            @await Html.PartialAsync("_AdvertiseRegionSelector", new ViewDataDictionary(new EmptyModelMetadataProvider(), new ModelStateDictionary()) {
                            { "mandatory", false},
                            { "provinceName", "accItemProvince"},
                            { "cityName", "accItemCity"},
                            { "areaName", "accItemArea"},
                            { "province", Model.Category.Province},
                            { "city", Model.Category.City},
                            { "area", Model.Area},
                            { "region_filter_status", 1 },
                           {"provinces", Model.Provinces },
                           {"cities", Model.Cities },
                           {"areas", Model.Areas },
                           { "selectEnabled", true }
                        })
                        </div>
                    </div>
                    <div class="advertise-list__filter-btn-container">
                        <div onclick="removeRegionFilter()" style="background-color:#EA4335;">حذف فیلتر</div>
                        <div onclick="doRegionFilter()" style="background-color:#34A853;">اعمال فیلتر</div>
                    </div>
                </div>
            </div>
            <div class="advertise-list__pin-filter-left">
                <div onclick="showMoreFilter()" class="advertise-list__pin-filter-item">
                    <i class="fa fa-filter"></i>
                    <span>فیلتر بیشتر</span>
                </div>
                <div class="advertise-list__filter-box-item" id="js-more-filter-item">
                    <div class="advertise-list__filter-popup-header">
                        <div class="advertise-list__filter-header-text">فیلتر بیشتر</div>
                        <div onclick="hideAllFilterItems()" class="advertise-list__filter-close-btn"><i class="fa fa-times"></i></div>
                    </div>
                    <div class="advertise-list__more-filter-parent">
                        <div class="advertise-list__more-filter-item">
                            <div onclick="toggleAccTypeContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>نوع اقامتگاه</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-acctype-container" class="advertise-list__filter-select-container" style="display:none">
                                <div onclick="changeAccTypeValue(this)" class="advertise-list__filter-select-item@(Model.T > 0 ? (Model.T == 81 ? " filter-selected-item" : "") : (Model.Category.Type == Advertise.AdvertiseType.All ? " filter-selected-item" : ""))" data-value="81">
                                    <span>همه</span>
                                    <i class="fa fa-check"></i>
                                </div>
                                @foreach (var typeFilterItem in types)
                                {
                                    <div onclick="changeAccTypeValue(this)" class="advertise-list__filter-select-item@(Model.T > 0 ? (Model.T == (int)typeFilterItem ? " filter-selected-item" : "") : (typeFilterItem == Model.Category.Type ? " filter-selected-item" : ""))" data-value="@((int)typeFilterItem)">
                                        <span>@AdvertiseMainLocalization.GetAdvertiseTypeUserString(typeFilterItem)</span>
                                        <i class="fa fa-check"></i>
                                    </div>
                                }
                            </div>
                            <input type="hidden" id="js-acctype-input" value="@Model.Category.Type" />
                        </div>

                        <div class="advertise-list__more-filter-item">
                            <div onclick="togglePositionsContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>موقعیت اقامتگاه</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-positions-container" class="advertise-list__filter-select-container" style="display:none">
                                @foreach (var positionFilterItem in Model.PositionItems)
                                {
                                    if (positionFilterItem == Advertise.PositionType.none)
                                    {
                                        continue;
                                    }
                                    <div class="advertise-list__filter-select-item@((Model.Region != null && ((int)positionFilterItem).ToString() == Model.Region.ToString()) ? " filter-selected-item" : "")" data-value="@((int)positionFilterItem)">
                                        <span>@AdvertiseMainLocalization.GetPositionTypeString((int)positionFilterItem)</span>
                                        <i class="fa fa-check"></i>
                                    </div>
                                }
                            </div>
                            <input type="hidden" id="js-position-input" value="@(Model.Region == null ? "-1" : Model.Region)" />
                        </div>

                        <div class="advertise-list__more-filter-item">
                            <div onclick="togglePriceRangeContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>محدوده قیمت</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-pricerange-container" style="display:none">
                                <div class="advertise-list__radio-container">
                                    <input type="hidden" id="js-pricerange-filter-type-input" value="@Model.PriceRangeType" />
                                    <div class="advertise-list__radio-item">
                                        <input onchange="changePriceRangeType(0)" is-checked="@(Model.PriceRangeType == 0)" type="radio" id="js-price-range-type-0" name="js-price-range-type" value="0" />
                                        <label for="js-price-range-type-0">پایه</label>
                                    </div>
                                    <div class="advertise-list__radio-item">
                                        <input onchange="changePriceRangeType(1)" is-checked="@(Model.PriceRangeType == 1)" type="radio" id="js-price-range-type-1" name="js-price-range-type" value="1" />
                                        <label for="js-price-range-type-1">روزهای تعطیل</label>
                                    </div>
                                    <div class="advertise-list__radio-item">
                                        <input onchange="changePriceRangeType(2)" is-checked="@(Model.PriceRangeType == 2)" type="radio" id="js-price-range-type-2" name="js-price-range-type" value="2" />
                                        <label for="js-price-range-type-2">پیک تعطیلات</label>
                                    </div>
                                    <div class="advertise-list__radio-item">
                                        <input onchange="changePriceRangeType(3)" is-checked="@(Model.PriceRangeType == 3)" type="radio" id="js-price-range-type-3" name="js-price-range-type" value="3" />
                                        <label for="js-price-range-type-3">اجاره ماهانه</label>
                                    </div>
                                </div>
                                <div style="display: flex;justify-content: space-around;margin-bottom:10px;">
                                    <div style="border-radius:5px;padding:5px;font:13px Liransans;display: flex;flex-flow: column;">
                                        <span>حداقل قیمت:</span>
                                        <select id="js-pricemin-input">
                                            @if (Model.PriceRangeType == 3)
                                            {
                                                for (int i = 0; i < Model.MonthlyPriceOptions.Length; i++)
                                                {
                                                    var priceValue = Model.MonthlyPriceOptions[i];
                                                    <option is-selected="@(priceValue == Model.PriceMin)" value="@priceValue">@(priceValue == 150000000 ? "بیشتر از پنجاه میلیون" : string.Format("{0:n0}", priceValue) +" تومان")</option>
                                                }
                                            }
                                            else
                                            {
                                                for (int i = 0; i < Model.PriceOptions.Length; i++)
                                                {
                                                    var priceValue = Model.PriceOptions[i];
                                                    <option is-selected="@(priceValue == Model.PriceMin)" value="@priceValue">@string.Format("{0:n0}", priceValue) تومان</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div style="border-radius:5px;padding:5px;font:13px Liransans;display: flex;flex-flow: column;">
                                        <span>حداکثر قیمت:</span>
                                        <select id="js-pricemax-input">
                                            @if (Model.PriceRangeType == 3)
                                            {
                                                for (int i = 0; i < Model.MonthlyPriceOptions.Length; i++)
                                                {
                                                    var priceValue = Model.MonthlyPriceOptions[i];
                                                    <option is-selected="@(priceValue == Model.PriceMax)" value="@priceValue">@(priceValue == 150000000 ? "بیشتر از پنجاه میلیون" : string.Format("{0:n0}", priceValue) + " تومان")</option>
                                                }
                                            }
                                            else
                                            {
                                                for (int i = 0; i < Model.PriceOptions.Length; i++)
                                                {
                                                    var priceValue = Model.PriceOptions[i];
                                                    <option is-selected="@(priceValue == Model.PriceMax)" value="@priceValue">@string.Format("{0:n0}", priceValue) تومان</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="advertise-list__more-filter-item">
                            <div onclick="toggleRoomContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>اتاق خواب</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-room-container" class="advertise-list__filter-select-container" style="display:none" multi="multi">
                                <div class="advertise-list__filter-select-item@((Model.RoomListIds != null && Model.RoomListIds.Contains(0)) ? " filter-selected-item" : "")" data-value="0">
                                    <span>بدون اتاق خواب</span>
                                    <i class="fa fa-check"></i>
                                </div>
                                @for (int i = 1; i <= 4; i++)
                                {
                                    <div class="advertise-list__filter-select-item@((Model.RoomListIds != null && Model.RoomListIds.Contains(i)) ? " filter-selected-item" : "")" data-value="@(i)">
                                        <span>@(i + " خوابه")</span>
                                        <i class="fa fa-check"></i>
                                    </div>
                                }
                                <div class="advertise-list__filter-select-item@((Model.RoomListIds != null && Model.RoomListIds.Contains(5)) ? " filter-selected-item" : "")" data-value="5">
                                    <span>بیشتر از 4 خواب</span>
                                    <i class="fa fa-check"></i>
                                </div>
                            </div>
                            <input type="hidden" id="js-roomlist-input" value="@(string.IsNullOrEmpty(Model.RoomList) ? "" : Model.RoomList)" />
                        </div>

                        <div class="advertise-list__more-filter-item">
                            <div onclick="toggleFacilitiesContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>امکانات</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-facilities-container" class="advertise-list__filter-select-container" style="display:none">
                                <div style="display:flex;flex-wrap:wrap;">
                                    <input type="hidden" id="js-pool-input" value="@(Model.Pool == null ? "-1" : Model.Pool)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>استخر</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Pool != "1" ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-elevator-input" value="@(Model.Elevator == null ? "-1" : Model.Elevator)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>آسانسور</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Elevator != "1" ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-parking-input" value="@(Model.Parking)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>پارکینگ</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Parking != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-perwc-input" value="@(Model.WcType == 127 || Model.WcType == 128  ? 1 : -1)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>سرویس ایرانی</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.WcType == 127 || Model.WcType == 128  ? "checked-3" : "unchecked-3")" />
                                    </div>
                                    <input type="hidden" id="js-euwc-input" value="@(Model.WcType == 129 || Model.WcType == 128  ? 1 : -1)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>سرویس فرنگی</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.WcType == 129 || Model.WcType == 128  ? "checked-3" : "unchecked-3")" />
                                    </div>
                                    <input type="hidden" id="js-wifi-input" value="@(Model.Wifi)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>وای فای</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Wifi != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-washingmachine-input" value="@(Model.WashingMachine)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>ماشین لباسشویی</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.WashingMachine != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-jacuzzi-input" value="@(Model.Jacuzzi)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>جکوزی</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Jacuzzi != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-pooltable-input" value="@(Model.PoolTable)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>بیلیارد</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.PoolTable != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-foosball-input" value="@(Model.Foosball)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>فوتبال دستی</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.Foosball != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                    <input type="hidden" id="js-teamaker-input" value="@(Model.TeaMaker)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>چای ساز</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.TeaMaker != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="advertise-list__more-filter-item">
                            <div onclick="toggleRulesContainer(this)" class="advertise-list__more-filter-expand-btn">
                                <span>قوانین اقامتگاه</span>
                                <i class="fa fa-chevron-down"></i>
                            </div>
                            <div id="js-rules-container" class="advertise-list__filter-select-container" style="display:none">
                                <div style="display:flex;flex-wrap:wrap;">
                                    <input type="hidden" id="js-pets-input" value="@(Model.RulesPets)" />
                                    <div class="advertise-category__today-empty_button" style="cursor:pointer" onclick="changeCheckLists(this)">
                                        <span>حیوان خانگی مجاز</span>
                                        <img width="20" height="20" rel="checkbox" src="/file/resourceimagepng?file_name=@(Model.RulesPets != 1 ? "unchecked-3" : "checked-3")" />
                                    </div>
