@section HeaderAddition
{
    @{
        string canonicalUrl;
        if (!string.IsNullOrEmpty(phrase))
        {
            canonicalUrl = "https://www.amlakbashi.com/ایران";
        }
        else
        {
            canonicalUrl = "https://www.amlakbashi.com" + (category == null || ViewBag.area < 1 ? ViewBag.raw_url :
                "/s/" + category.City + "/" + city + (category.Type == Advertise.AdvertiseType.All ? "" : "/" + accTypeUrlString));
        }
    }
    @if (Model.Any())
    {
        <link rel="canonical" href="@(canonicalUrl)" />
        @*if (ViewBag.currentPageNumber > 1)
            {
                <link rel="prev" href="@(canonicalUrl)@(ViewBag.currentPageNumber == 2 ? "" : "?page=" + (ViewBag.currentPageNumber - 1).ToString())" />
            }
            <link rel="canonical" href="@(canonicalUrl)@(ViewBag.currentPageNumber > 1 ? "?page=" + ViewBag.currentPageNumber : "")" ) />
            if (ViewBag.pagesCount > ViewBag.currentPageNumber)
            {
                <link rel="next" href="@(canonicalUrl)?page=@(ViewBag.currentPageNumber + 1)" />
            }*@
    }
    else
    {
        <meta name="robots" content="noindex, follow">
    }
    @*<link rel="amphtml" href="https://www.amlakbashi.com/amp@(ViewBag.raw_url)" />*@
    <meta property="og:url" content="https://www.amlakbashi.com@(ViewBag.raw_url)" />
    <meta property="og:image" content='@("https://www.amlakbashi.com" + (Model.Any() && Model.First().PhotoID > 0 ? string.Format("/file/imgthumb?fileid={0}&w={1}&h={2}", Model.First().PhotoID, 700, 394) : string.Format("/عکس-یافت-نشد-{0}-{1}", 700, 394)))' />
}

