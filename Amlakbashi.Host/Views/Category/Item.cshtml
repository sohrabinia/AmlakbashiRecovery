<div class="container" style="max-width:1100px">
    <div class="dynamic__header-container">
        <div class="dynamic-title">
            <div class="dynamic-text" style="width: 100%;">
                <h1 style="text-align: center;width: 100%;">@(!string.IsNullOrEmpty(phrase) ? "جستجوی عبارت \"" + phrase + "\"" : Model.CategoryH1Title)@(string.IsNullOrEmpty(Model.AreaString) ? "" : " - " + Model.AreaString)</h1>
            </div>
