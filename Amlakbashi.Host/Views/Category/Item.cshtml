                <i class="fa fa-percent"></i>
                <span>تخفیف دار</span>
            </div>
            <div id="norouz-special-filter-button" onclick="toggleNorouz()" style="background-color:@(Model.NorouzSpecial ? "#fdd835" : "white")" class="advertise-list__pin-filter-item">
                    <img width="16" height="16" rel="ویژه نوروز" title="ویژه نوروز" src="/file/resourceimagepng?file_name=norouz_icon_16x16" />
                    <span>ویژه نوروز</span>
