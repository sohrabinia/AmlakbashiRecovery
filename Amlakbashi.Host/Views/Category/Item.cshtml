    <script>
    if ('@(Model.Category != null)' === 'True') {
        gtag('event', 'select_content', {
            "content_type": "product_list",
            "items": [
                {
                    "id": "@(Model.Category != null ? Model.Category.Id : 0)",
                    "name": "@(Model.Category != null ? Model.Category.Title : "")",
                    "category": "@(Model.Category != null ? (Model.Category.Province > 0 ? (Model.Category.City > 0 ? Model.ProvinceString + "/" + Model.CityString : "استان " + Model.ProvinceString) : (Model.Category.CountryDirection > 0 ? Model.CountryDirectionString : "کل کشور")) : "")"
                }
            ]
        });
    }
    else {
        gtag('event', 'select_content', {
            "content_type": "product_list",
            "items": [
                {
                    "id": "0",
                    "name": "اجاره ویلا شمال",
                    "category": "شمال"
                }
            ]
        });
    }
    </script>
    @{
        var items = Model.AdvertiseItems.ToList();
        var itemCount = items.Count;
        if (itemCount > 0)
        {
            @:<script type="application/ld+json">
                @:{
                @:"@@context": "https://schema.org",
                @:"@@type": "ItemList",
                @:"itemListElement": [
                for (int i = 0; i < itemCount; i++)
                {
                    var item = items[i];
                    var img_src = item.PhotoID > 0 ? string.Format("/عکس-آگهی/{0}", item.Slug) : string.Format("/عکس-یافت-نشد-{0}-{1}", 240, 144);
                    var position = i + 1;
                    var title = item.Title;
                    var description = item.Description;
                    var count_review = item.RateCount;
                    var rate = item.OverallRate;

                    @:{
                    @:"@@type": "ListItem",
                    @:"position": "@(position)",
                    @:"item": {
                    @:"@@type": "Hotel",
                    @:"url": "@( "https://www.amlakbashi.com" + Model.RawUrl + "#advertise_" + item.AdvertiseID)",
                    @:"name": "@(title)",
                    @:"image": [
                    @:"https://www.amlakbashi.com@(img_src)"
                    @:],
                    @:"description": "@(description)"
                    if (count_review > 0)
                    {
                        @:,
                        @:"aggregateRating": {
                        @:"@@type": "AggregateRating",
                        @:"ratingValue": "@(rate)",
                        @:"ratingCount": "@(count_review)",
                        @:"bestRating": "5",
                        @:"worstRating": "0"
                        @:}
                    }
                    @:,
                    @:"priceRange" : "از شبی @(item.DailyPrice) تومان"
                    @:,
                    @:"address" : {
                    @:"addressLocality" : "@(!string.IsNullOrEmpty(item.areaName) ? item.cityName : item.provinceName)",
                    @:"addressRegion" : "@(!string.IsNullOrEmpty(item.areaName) ? item.areaName : item.cityName)",
                    @:"addressCountry" : "Iran",
                    @:"@@type" : "PostalAddress",
                    @:"streetAddress" : "@AdvertiseMainLocalization.FilteredAddress(item.address)",
                    @:"postalCode" : "14717"
                    @:}
                    @:,
                    @:"telephone" : "026-32565304"

                    @:}
                    @:} @(i < itemCount - 1 ? "," : "")
                }
                @:]
                @:}
                @:
            @:</script>
        }

        <script type="application/ld+json">
            {"@@context":"https://schema.org",
            "@@type":"FAQPage",
            "mainEntity":[
            {"@@type":"Question",
            "name":"@(Model.CategoryFaqTrustQuestion)",
            "acceptedAnswer":[
            {"@@type":"Answer",
            "text":"@(Model.CategoryFaqTrustAnswer)"
            }
            ]
            },
            {"@@type":"Question",
            "name":"@(Model.CategoryFaqPriceQuestion)",
            "acceptedAnswer":[
            {"@@type":"Answer",
            "text":"@(Model.CategoryFaqPriceAnswer)"
            }
            ]
            },
            @if (!string.IsNullOrEmpty(Model.Category.CityAreaListString))
            {
                @:{
                @:"@@type":"Question",
                @:"name":"@(Model.CategoryFaqAreasQuestion)",
                @:"acceptedAnswer":[{
                @:"@@type":"Answer",
                @:"text":"@(Model.CategoryFaqAreasAnswer)"}]},
            }
            {"@@type":"Question","name":"@(Model.CategoryFaqEvidenceQuestion)",
            "acceptedAnswer":[{"@@type":"Answer",
            "text":"@(Model.CategoryFaqEvidenceAnswer)"}]},
            {"@@type":"Question",
            "name":"@(Model.CategoryFaqReserveQuestion)",
            "acceptedAnswer":[{"@@type":"Answer",
            "text":"@(Model.CategoryFaqReserveAnswer)"}]}]},
            {"@@type":"Question",
            "name":"@(Model.CategoryFaqHostQuestion)",
            "acceptedAnswer":[{"@@type":"Answer",
            "text":"@(Model.CategoryFaqHostAnswer)"}]}]},
