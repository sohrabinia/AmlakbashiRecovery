@model IEnumerable<Post>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var url = string.Format("/اخبار-و-مقالات/{0}-{1}", item.Title.Replace("+", "-").Replace(" ", "-"), item.Id);
            <div class="content row">
                <div class="col-xs-12 col-sm-3 col-md-2" >
                    <a href="@url">
                        <img width="150" height="100" title="@item.Title"
                             alt="@item.Title" src='@string.Format("/عکس-پست/{0}-{1}-{2}-{3}",
                            item.Title.Replace("+", "-").Replace(" ", "-"), item.Id, 150, 100 )' />
                    </a>
                </div>
                <div class="col-xs-12 col-sm-9 col-md-10" >
                    <a href="@url" class="titr">
                        <h1>@item.Title</h1>
                    </a>
                    <div class="lead">
                        <h2>@item.Abstract</h2>                        
                    </div>
                </div>
            </div>
        }
}
