@model List<IEnumerable<Post>>
@{
    ViewBag.Title = "اخبار مقالات - املاک باشی";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Description = "اخبار و مقالات سایت املاک باشی";
}
@section StyleLink
{
    <link rel="stylesheet" type="text/css" href="/file/getcss?src=/resource/news.css">
}
@section ScriptLink
{
}

<div class="mainnews container">
    <div class="newsitem">
        <div class="title">تازه های دکوراسیون</div>
        <div class="devider"></div>
        @await Html.PartialAsync("_News", Model[0])
    </div>
    <div class="newsitem">
        <div class="title">اخبار سایت</div>       
        <div class="devider"></div>
        @await Html.PartialAsync("_News", Model[1])
    </div>
    <div class="newsitem">
        <div class="title">مقالات</div>
        <div class="devider"></div>
        @await Html.PartialAsync("_News", Model[2])
    </div>
    <div class="newsitem">
        <div class="title">اخبار مسکن</div>
        <div class="devider"></div>
        @await Html.PartialAsync("_News", Model[3])
    </div>
</div>

@section HeaderAddition
{
    <link rel="canonical" href="https://www.amlakbashi.com/اخبار-و-مقالات" />

    <meta property="og:url" content="https://www.amlakbashi.com/اخبار-و-مقالات" />
}


@section ScriptBlock
{
    <script type="text/javascript">

    </script>
@{ var url_splitted = ("/اخبار-و-مقالات").Substring(1).Split('/'); }
<script type="application/ld+json">
    {
    "@@context": "https://schema.org",
    "@@type": "BreadcrumbList",
    "itemListElement": [{
    "@@type": "ListItem",
    "position": 1,
    "name": "املاک باشی",
    "item": "https://www.amlakbashi.com/"
    }

    @for (int i = 0; i < url_splitted.Length; i++)
    {
        var url = "https://www.amlakbashi.com/";
        for (int j = 0; j < i; j++)
        {
            url += (url_splitted[j] + "/");
        }
        url += url_splitted[i];
        var pos = i + 2;
        @:,{
        @:"@@type": "ListItem",
        @:"position": @(pos),
        @:"name": "@(url_splitted[i].Replace("-", " "))",
        @:"item": "@(url)"}
            }
    ]
    }
</script>
}