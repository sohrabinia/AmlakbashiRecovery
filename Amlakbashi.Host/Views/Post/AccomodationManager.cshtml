        <script src="/js/acc-manager.min.js" asp-append-version="true"></script>
    </environment>
}

@section ScriptBlock{
    <script type="text/javascript">
        function DeserializeOccupiedList(str) {
            var occupiedListStr = str;
            occupiedListStr = occupiedListStr.replaceAll('&quot;', '"');
            var occupiedList = JSON.parse(occupiedListStr);
            return occupiedList;
        }

        var showReasonsDic = {};
        @foreach( var item in Model.accList)
        {
            @:var reasonList = [];
            foreach (var reason in item.notVerifyReasons)
            {
                @: reasonList.push('@reason');
            }
            @: showReasonsDic[@item.id]=reasonList;
         }

        var occupiedDictionary = {};
        var extrinsicDictionary = {};
        @foreach(var occupiued in Model.accList)
        {
            @:occupiedDictionary['@occupiued.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(occupiued.unavailableDates)');
            @:extrinsicDictionary['@occupiued.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(occupiued.extrinsicDates)');
            foreach ( var Hotel in occupiued.hotelRooms)
            {
                @:occupiedDictionary['@Hotel.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(Hotel.unavailableDates)');
                @:extrinsicDictionary['@Hotel.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(Hotel.extrinsicDates)');
            }
            foreach ( var apartment in occupiued.apartmentUnits)
            {
                @:occupiedDictionary['@apartment.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(apartment.unavailableDates)');
                @:extrinsicDictionary['@apartment.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(apartment.extrinsicDates)');
            }
            foreach ( var suitUnits in occupiued.suitUnits)
            {
                @:occupiedDictionary['@suitUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(suitUnits.unavailableDates)');
                @:extrinsicDictionary['@suitUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(suitUnits.extrinsicDates)');
            }
            foreach ( var villaUnits in occupiued.villaUnits)
            {
                @:occupiedDictionary['@villaUnits.id '] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(villaUnits.unavailableDates)');
                @:extrinsicDictionary['@villaUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(villaUnits.extrinsicDates)');
            }
            foreach ( var houseUnits in occupiued.houseUnits)
            {
                @:occupiedDictionary['@houseUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(houseUnits.unavailableDates)');
                @:extrinsicDictionary['@houseUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(houseUnits.extrinsicDates)');
            }
            foreach ( var hutUnits in occupiued.hutUnits)
            {
                @:occupiedDictionary['@hutUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(hutUnits.unavailableDates)');
                @:extrinsicDictionary['@hutUnits.id'] = DeserializeOccupiedList('@SerializeUtility.SerializeToJS(hutUnits.extrinsicDates)');
            }
        }

        function showReasons(id) {
            var reasonsStr;
            Object.keys(showReasonsDic).forEach(function (key) {
                if (key == id) {
                    showReasonsDic[key].forEach(function (item) {
                        reasonsStr = $(".button_reason_not_verified div").append(`${item}<br>`);
                    });
                }
            });
            showInfoMessage('موارد زیر را اصلاح کنید', reasonsStr);
        }
    </script>
}
