        <script src="/resource/Scripts/dashboard/host-panel.js" asp-append-version="true"></script>
        <script src="/resource/Scripts/dashboard/accDatePicker.js" asp-append-version="true"></script>
        <script src="/resource/Scripts/dashboard/ajax-accomodation.js" asp-append-version="true"></script>
        <script src="/resource/Scripts/dashboard/numberInput.js" asp-append-version="true"></script>
    </environment>
