@{
    ViewBag.Title = "اپلیکیشن اجاره ویلا در شمال ، اجاره روزانه خانه";
    Layout = "~/Views/Shared/_Master.cshtml";
    ViewBag.Description = "اپلیکیشن املاک باشی ، اپلیکیشن تخصصی در زمینه ی ، اجاره روزانه ، اجاره ویلا ، اجاره روزانه خانه ، اجاره سوئیت و رزرو اقامتگاه در شمال ، تهران ، شیراز ، اصفهان ، یزد ، مشهد و سایر شهرهای  ایران";
    ViewBag.keywords = "اپلیکیشن املاک باشی,اپلیکیشن اجاره ویلا,اپلیکیشن اجاره ویلا در شمال,اپلیکیشن اجاره ویلا اطراف تهران,اپلیکیشن اجاره ویلا کردان,اپلیکیشن اجاره آپارتمان مبله,اپلیکیشن اجاره سوئیت,اپلیکیشن اجاره روزانه خانه,اپلیکیشن اجاره روزانه خانه در تهران,اپلیکیشن اجاره روزانه خانه در اصفهان,اپلیکیشن اجاره روزانه خانه در شیراز,اپلیکیشن اجاره روزانه خانه در مشهد,اپلیکیشن اجاره روزانه خانه در  تمام شهر های توریستی ایران,بهترین اپلیکیشن اجاره ویلا در شمال,بهترین اپلیکیشن اجاره روزانه خانه";
    ViewBag.LockInPage = ViewBag.fromApp;
}
<div class="container">
    @if (ViewBag.fromApp)
    {
        <div class="master__header" style="justify-content:center; margin-top:10px;">
            <div class="master_header-child master_header-logo">
                <img style="width: unset" srcset="/file/resourceimagegif?file_name=amlakbashi-logo-400w 94w,
                                /file/resourceimagegif?file_name=amlakbashi-logo-680w 106w,
                                /file/resourceimagegif?file_name=amlakbashi-logo-900w 112w,
                                 /file/resourceimagegif?file_name=amlakbashi-logo-1200w 135w"
                     sizes="(max-width: 400px) 94px,
                                 (max-width: 680px) 106px,
                                 (max-width: 900px) 112px,
                                 135px"
                     src="/file/resourceimagegif?file_name=amlakbashi-logo-680w" alt="لوگوی املاک باشی" title="املاک باشی">
            </div>
        </div>
    }
    <div style="padding-bottom:40px; background-color:#eaeaea;background-image: linear-gradient(to right ,#d6d6d6 , #eaeaea);padding:20px; margin-top: @(ViewBag.fromApp ? "0" : "10px");">
        <div class="row" style="font: 14px Biransans; text-align: center; padding: 10px;margin:0 10px 10px 10px;border-radius:5px; color: #242424;">
            @if (ViewBag.fromApp)
            {
                <span>این نسخه از اپلیکیشن دیگر پشتیبانی نمیشود. لطفا نسخه جدید را نصب کنید:</span>
            }
        </div>
        @Html.PartialAsync("_DownloadApp", new ViewDataDictionary(new EmptyModelMetadataProvider(),
        new ModelStateDictionary()) { { "h2", true } })
        @if (!ViewBag.fromApp)
        {
            <p style="font:13px Miransans">@ViewBag.Description</p>
        }
    </div>
</div>

@section HeaderAddition
{
    <link rel="canonical" href="https://www.amlakbashi.com/post/downloadapp" />
    @*<link rel="amphtml" href="https://www.amlakbashi.com/amp/downloadapp" />*@
    <meta property="og:url" content="https://www.amlakbashi.com/post/downloadapp" />
    <meta property="og:image" content="https://www.amlakbashi.com/resource/img/amlakbashi-banner.jpg" />
}

@section ScriptBlock
{
    <script type="text/javascript">
    </script>
@{ var url_splitted = ("/file/downloadapp").Substring(1).Split('/'); }
<script type="application/ld+json">
    {
    "@@context": "https://schema.org",
    "@@type": "BreadcrumbList",
    "itemListElement": [{
    "@@type": "ListItem",
    "position": 1,
    "name": "املاک باشی",
    "item": "https://www.amlakbashi.com/"
    }

    @for (int i = 0; i < url_splitted.Length; i++)
    {
        var url = "https://www.amlakbashi.com/";
        for (int j = 0; j < i; j++)
        {
            url += (url_splitted[j] + "/");
        }
        url += url_splitted[i];
        var pos = i + 2;
        @:,{
        @:"@@type": "ListItem",
        @:"position": @(pos),
        @:"name": "@(url_splitted[i].Replace("-", " "))",
        @:"item": "@(url)"}
            }
    ]
    }
</script>
}