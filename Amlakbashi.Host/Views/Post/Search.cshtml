@{
    ViewBag.Title = "املاک باشی - اجاره ویلا در شمال ، اجاره سوئیت و آپارتمان مبله در تهران و سراسر ایران";
    Layout = "~/Views/Shared/_Master.cshtml";
}

@section StyleLink {
    <link rel="stylesheet" type="text/css" href="/css/search.min.css">
}

@section StyleBlock {
    .home-page__search-title {
    color:#242424;
    text-shadow:none;
    }
}

@section ScriptLink {
    <script src="/js/search.min.js"></script>
}

@await Html.PartialAsync("_HomePageSearch", new ViewDataDictionary(new EmptyModelMetadataProvider(),
        new ModelStateDictionary()) { { "autofocus", true } })

@section ScriptBlock
{
    <script type="text/javascript">
        $(document).ready(function () {
            setTimeout(function () {
                $('#js-search-input-main').click();
            }, 2000);
        });
    </script>
}