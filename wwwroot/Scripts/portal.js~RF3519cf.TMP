        }
        if (price_val >= 1000) {
            if (str_toman.length > 3) {
                str_toman += " و " + Math.floor(price_val / 1000) + " هزار";
            }
            else {
                str_toman += Math.floor(price_val / 1000) + " هزار";
            }
