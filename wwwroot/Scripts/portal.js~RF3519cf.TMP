String.prototype.replaceAll = function (search, replacement) {
    var target = this;
    return target.replace(new RegExp(search, 'g'), replacement);
};

function mygetCookie(name) {
    var name = cname + "=";
    var ca = document.cookie.split(';');
    for (var i = 0; i < ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) == ' ') c = c.substring(1);
        if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
    }
    return "";
}

//, attr, order

var sortSelect = function (select, attr, order) {
    if (attr === 'text') {
        if (order === 'asc') {
            $(select).html($(select).children('option').sort(function (x, y) {
                return $(x).text().toUpperCase() < $(y).text().toUpperCase() ? -1 : 1;
            }));
            $(select).get(0).selectedIndex = 0;
            e.preventDefault();
        }// end asc
        if (order === 'desc') {
            $(select).html($(select).children('option').sort(function (y, x) {
                return $(x).text().toUpperCase() < $(y).text().toUpperCase() ? -1 : 1;
            }));
            $(select).get(0).selectedIndex = 0;
            e.preventDefault();
        }// end desc
    }

};

function toggle_search_box() {
    if ($(".searchbox").hasClass("shide")) {
        $(".searchbox").removeClass("shide");
    }
    else {
        $(".searchbox").addClass("shide");
    }
}

function elementInViewport(el) {
    var top = el.offsetTop;
    var left = el.offsetLeft;
    var width = el.offsetWidth;
    var height = el.offsetHeight;

    while (el.offsetParent) {
        el = el.offsetParent;
        top += el.offsetTop;
        left += el.offsetLeft;
    }

    return (
      top < (window.pageYOffset + window.innerHeight) &&
      left < (window.pageXOffset + window.innerWidth) &&
      (top + height) > window.pageYOffset &&
      (left + width) > window.pageXOffset
    );
}

/******login popup*******/
var can_send_login_message = true;

function toggle_login() {
    if ($(".login__container").css("display") == "none")
    {
        restart_login();
        $(".login__bg").show();
        toggle_login_container(true, function () {
            $(".login__container").css("display", "flex");
        });
    }
    else {
        $(".login__bg").fadeOut(500);
        toggle_login_container(false);
    }
}

$(document).keypress(function (event) {

    var keycode = (event.keyCode ? event.keyCode : event.which);
    if ($(".login__container").css("display") == "none") {
        return;
    }
    if (keycode == '13') {
        if ($("#login_form").css("display") != "none")
        {
            login();
        }
        else if ($("#login_form_email").css("display") != "none")
        {
            login("email");
        }
        else if ($("#verification_form").css("display") != "none")
        {
            login_verification();
        }
    }

});

function toggle_login_container(direction, onDone) {
    if (direction) {
        $(".login__container").css("opacity", 0);
        $(".login__container").css("display", "flex");
        $(".login__container").animate({
            opacity: 1
        }, 500, onDone);
    }
    else {
        $(".login__container").animate({
            opacity: 0
        }, 500, function () {
            $(".login__container").css("display", "none");
            if (onDone != undefined && onDone != null) {
                onDone();
            }
        });
    }
}

function login(step) {
    if (!check_login_mobile())
        return;
    step = step !== "email" ? "mobile" : "email";
    toggle_login_container(false);
    var mobile = $('#mobile').val();
    var email = $('#email').val();
    myajax("user/popuplogin", "mobile=" + mobile + "&email=" + email + "&step=" + step + "&send_verification=" + can_send_login_message, function (ret) {
        if (ret.status == 0)
        {
            $("#login-error-container").html(ret.msg);
        }
        else if (ret.status == 1)
        {
            login_success(ret.fname, ret.lname, ret.mobile);
        }
        else if (ret.status == 2)
        {
            toggle_login_container(false);
            $.confirm({
                title: 'مسدود',
                content: 'امکان ورود به سایت برای شما مسدود شده است, جهت فعالسازی با پشتیبانی تماس بگیرید: ' +
                    '<a href="/contact">تماس با پشتیبانی</a>',
                type: 'red',
                typeAnimated: true,
                buttons: {
                    بستن: function () {
                    }
                }
            });
        }
        else if (ret.status == 3)
        {
            login_success_email(ret.email);
        }
        else if (ret.status == 4)
        {
            $(".login_form").hide(500, function () {
                $("#login_form_email").show(500);
            });
        }
        toggle_login_container(true, function () {
            $(".login__container").css("display", "flex");
            if (ret.status == 0) {
                $('#login-error-container').show();
            }
        });
    });
}

function login_verification() {
    var mobile = $('#mobile').val();
    var code = $('#code').val();
    var fname = $("#fname").val();
    var lname = $("#lname").val();
    myajax("user/popuploginverification", "mobile=" + mobile + "&code=" + code + "&fname=" + fname + "&lname=" + lname , function (ret) {
        if (ret.status == 1)
        {
            toggle_login();
            verification_success();
        }
        else
        {
            alertify.error(ret.msg);
        }
    });
}

function resend_login_sms() {
    myajax("user/popupresendsms", "", function (ret) {
        if (ret.status == 1)
        {
            restart_login();
            $("#resend_button").removeAttr("onclick");
            $("#resend_button").append('<span id="count_down_timer"></span>');
            if (can_send_login_message) {
                can_send_login_message = false;
                $("#count_down_timer").countdowntimer({
                    timeUp: function () {
                        can_send_login_message = true;
                        $("#count_down_timer").html("");
                        $("#resend_button").attr("onclick", "resend_login_sms()");
                        $("#resend_button").html("دریافت مجدد کد فعال سازی");
                    }, minutes: 2,
                });
            }
        }
    });
}

function resend_login_email(email) {
    debugger;
    myajax("user/popupresendemail", "email=" + email, function (ret) {
        debugger;
        showSuccessAlert('ایمیل ارسال شد', 'ایمیل تایید دوباره ارسال شد. لطفا مجددا ایمیل خود را بررسی کنید', function () {
            $("#resend_button").removeAttr("onclick");
            $("#resend_button").append('<span id="count_down_timer"></span>');
            if (can_send_login_message) {
                can_send_login_message = false;
                $("#count_down_timer").countdowntimer({
                    timeUp: function () {
                        can_send_login_message = true;
                        $("#count_down_timer").html("");
                        $("#resend_button").attr("onclick", "resend_login_email('" + email + "')");
                        $("#resend_button").html("دریافت مجدد ایمیل فعال سازی");
                    }, minutes: 2,
                });
            }
        });
    });
}

function restart_login() {
    verification_form_shown = false;
    //$("#login_form").css("display", "unset");
    $(".login_form").hide();
    $("#login_form").show();
    //$("#verification_form").css("display", "none");
    $("#mobile_label").html("");
}

function login_success(fname, lname, mobile) {
    show_verification_form(fname, lname, mobile);
}

function login_success_email(email, onDone) {
    show_email_verification_form(email, onDone);
}

var verification_form_shown = false;

function show_verification_form(fname, lname, mobile, onDone) {
    verification_form_shown = true;
    //$("#login_form").css("display", "none");
    //$("#verification_form").css("display", "unset");
    $(".login_form").hide();
    $("#verification_form").show();
    $("#resend_form").show();
    $("#mobile_label").html(mobile);
    $("#fname").val(fname == null ? "" : fname);
    $("#lname").val(lname == null ? "" : lname);
    if (fname != null && fname != "") {
        $("#fname").hide();
    }
    if (lname != null && lname != "") {
        $("#lname").hide();
    }
    if (can_send_login_message) {
        can_send_login_message = false;
        $("#count_down_timer").countdowntimer({
            timeUp: function () {
                can_send_login_message = true;
                $("#count_down_timer").html("");
                $("#resend_button").attr("onclick", "resend_login_sms()");
                $("#resend_button").html("دریافت مجدد کد فعال سازی");
            }, minutes: 2,
        });
    }
    if (onDone != undefined && onDone != null) {
        onDone();
    }
}

function show_email_verification_form(email, onDone) {
    verification_form_shown = true;
    //$("#login_form").css("display", "none");
    //$("#verification_form").css("display", "unset");
    $(".login_form").hide(500, function () {
        $("#email_verification_form").show(500);
        $("#resend_form").show(500);
    });
    $("#email_label").html(email);
    if (can_send_login_message) {
        can_send_login_message = false;
        $("#count_down_timer").countdowntimer({
            timeUp: function () {
                can_send_login_message = true;
                $("#count_down_timer").html("");
                $("#resend_button").attr("onclick", "resend_login_email('" + email + "')");
                $("#resend_button").html("دریافت مجدد ایمیل فعال سازی");
            }, minutes: 2,
        });
    }
    if (onDone != undefined && onDone != null) {
        onDone();
    }
}

function verification_success(){
    alertify.success("با موفقیت وارد حساب خود شدید");
    $("#dashboard_button").attr("href", "/dashboard");
    $("#dashboard_button").removeAttr("onclick");
    $("#dashboard_button").find("span").html("حساب من");
    if (typeof on_login !== "undefined") {
        on_login();
    }
}

if ($("#MobileLoginVerification").length) {
    alertify.success("کد فعال سازی 4 رقمی به تلفن همراه شما پیامک شد");
}

function refreshCaptcha() {
    $("#captchaimage").attr('src', $("#captchaimage").attr('src') + '?' + Math.random());
}
