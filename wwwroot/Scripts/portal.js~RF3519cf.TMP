$(function () {
    $('#mobile').on('keypress', function (e) {
        if (e.which == 32)
            return false;
    });
});
function check_login_mobile () {
    debugger;
    if ($("#mobile").val() == "") {
        alertify.error("لطفا تلفن همراه خود را وارد کنید");
        $("#mobile").focus();
        return false;
    }
    if (!validateMobile($('#mobile').val().toString())) {

        alertify.error("لطفا تلفن همراه خود را درست و با اعداد انگلیسی وارد نمایید");
        $("#mobile").focus();
        return false;
    }
    return true;
}
